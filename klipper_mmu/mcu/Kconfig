source "src/klipper_mmu/mcu/Kconfig.pins"

config KLIPPER_MMU_PROTOCOL_VERSION
    int
    default 1

config KLIPPER_MMU_INTEGRATION_VERSION
    int
    default 1

config KLIPPER_MMU_BOOT_IDENTITY_H723
    bool "Experimental STM32H723 hardware boot identity"
    default y if KLIPPER_MMU_BOXTURTLE_BOOT_GATES && !KLIPPER_MMU_DIFF_BUFFER
    default n
    depends on MACH_STM32H723
    help
        Experimental hardware boot identity only. No motion.
        Defaults on for the ordinary BoxTurtle/AFC Lite switched-buffer preset.
        Requires hardware qualification. Preserves USB's HSI48.

config KLIPPER_MMU_BOOT_IDENTITY_F4X5
    bool "Experimental STM32F405/F407/F429 per-reset boot identity (USB, 168 MHz only)"
    default n
    depends on (MACH_STM32F405 || MACH_STM32F407 || MACH_STM32F429) && USBSERIAL && !STM32_USB_PB14_PB15 && (!MACH_STM32F429 || STM32_USB_PA11_PA12) && CLOCK_FREQ = 168000000
    help
        Experimental F405/F407/F429 RNG identity using Klipper's verified USB clock
        setup on PA11/PA12: its F4x5 clock path configures PLLQ=48 MHz at
        168 MHz. The provider verifies PLL configuration at runtime, owns
        the AHB2 RNG clock only when initially off, and fails closed on
        RNG health or continuous-test errors. USB PA11/PA12 remain Klipper-owned.
        The F429 uses the same pinned F4x5 PLLQ route. This does not qualify
        hardware or enable motion.

config KLIPPER_MMU_BOOT_IDENTITY_F765
    bool "Experimental STM32F765 per-reset boot identity (USB, 216 MHz only)"
    default n
    depends on MACH_STM32F765 && USBSERIAL && STM32_USB_PA11_PA12 && CLOCK_FREQ = 216000000
    help
        Uses the F765 RNG after checking Klipper's PLLSAIP 48 MHz clock route.
        The AHB2 RNG clock must be unowned. This does not qualify hardware
        or enable motion.

config KLIPPER_MMU_BOOT_IDENTITY_F207
    bool "Experimental STM32F207 per-reset boot identity (USB, 120 MHz only)"
    default n
    depends on MACH_STM32F207 && USBSERIAL && STM32_USB_PA11_PA12 && CLOCK_FREQ = 120000000
    help
        Uses the F207 RNG after checking Klipper's 48 MHz PLLQ clock route.
        The AHB2 RNG clock must be unowned. This does not qualify hardware
        or enable motion.

config KLIPPER_MMU_BOOT_IDENTITY_G4
    bool "Experimental STM32G431/G474 per-reset boot identity (USB, 170 MHz only)"
    default n
    depends on (MACH_STM32G431 || MACH_STM32G474) && USBSERIAL && STM32_USB_PA11_PA12 && CLOCK_FREQ = 170000000 && !STM32_CLOCK_REF_25M
    help
        Experimental G4 RNG identity using Klipper's USB HSI48 clock. Only the
        internal or another supported non-25 MHz PLL reference is admitted.
        Does not qualify hardware or enable motion.

config KLIPPER_MMU_BOOT_IDENTITY_H743_H750
    bool "Experimental STM32H743/H750 per-reset boot identity (USB PA11/PA12, crystal)"
    default n
    depends on (MACH_STM32H743 || MACH_STM32H750) && USBSERIAL && STM32_USB_PA11_PA12 && !STM32_CLOCK_REF_INTERNAL
    depends on (MACH_STM32H743 && CLOCK_FREQ = 400000000) || (MACH_STM32H750 && CLOCK_FREQ = 480000000)
    help
        Uses the classic H743/H750 RNG on the HSI48 kernel clock selected by
        Klipper for USB. The provider verifies crystal PLL1, bus prescalers,
        HSI48 readiness and RNG/USB selectors without writing them. The AHB2
        RNG clock must be unowned. This does not qualify hardware or enable motion.

config KLIPPER_MMU_BOOT_IDENTITY_HOST
    bool "Experimental Klipper-established reset epoch (no MCU RNG)"
    default n
    depends on MACH_STM32
    depends on !(KLIPPER_MMU_BOOT_IDENTITY_H723 || KLIPPER_MMU_BOOT_IDENTITY_F4X5 || KLIPPER_MMU_BOOT_IDENTITY_F765 || KLIPPER_MMU_BOOT_IDENTITY_F207 || KLIPPER_MMU_BOOT_IDENTITY_G4 || KLIPPER_MMU_BOOT_IDENTITY_H743_H750)
    help
        Hosted diagnostic startup binds one nonzero 64-bit epoch that the
        Klipper host generates after each MCU connect/config cycle. The first
        epoch binds for the MCU lifetime; later epochs are ignored until reset.
        This is a lifetime discriminator, not MCU entropy or authentication,
        and it cannot detect a reset invisible to Klipper's link lifecycle.
        Mutually exclusive with the hardware identity providers above. It
        does not select pins, drivers, or a board profile, and does not enable
        motion; the existing target profile gates must still match.

config KLIPPER_MMU_DIAGNOSTIC_STARTUP
    bool "Experimental hosted diagnostic startup"
    default y if KLIPPER_MMU_BOXTURTLE_BOOT_GATES && !KLIPPER_MMU_DIFF_BUFFER
    default n
    depends on ((MACH_STM32H723 && KLIPPER_MMU_BOOT_IDENTITY_H723) || ((MACH_STM32F405 || MACH_STM32F407 || MACH_STM32F429) && KLIPPER_MMU_BOOT_IDENTITY_F4X5) || (MACH_STM32F765 && KLIPPER_MMU_BOOT_IDENTITY_F765) || (MACH_STM32F207 && KLIPPER_MMU_BOOT_IDENTITY_F207) || ((MACH_STM32G431 || MACH_STM32G474) && KLIPPER_MMU_BOOT_IDENTITY_G4) || ((MACH_STM32H743 || MACH_STM32H750) && KLIPPER_MMU_BOOT_IDENTITY_H743_H750) || (KLIPPER_MMU_BOOT_IDENTITY_HOST && (MACH_STM32H723 || MACH_STM32F207 || MACH_STM32F405 || MACH_STM32F407 || MACH_STM32F429 || MACH_STM32F765 || MACH_STM32G431 || MACH_STM32G474 || MACH_STM32H743 || MACH_STM32H750 || MACH_STM32G0B0 || MACH_STM32G0B1))) && KLIPPER_MMU_PIN_CONFIG && WANT_GPIO_LOCAL && (KLIPPER_MMU_TMC_UART_SHARED || KLIPPER_MMU_QIDI_BOOT_GATES)
    depends on !KLIPPER_MMU_DIFF_BUFFER || (WANT_ADC && WANT_ADC_LOCAL)
    depends on !(MACH_STM32F405 || MACH_STM32F407 || MACH_STM32F429) || KLIPPER_MMU_F4X5_BOOT_GATES
    depends on !MACH_STM32F765 || KLIPPER_MMU_F765_BOOT_GATES
    depends on !MACH_STM32F207 || KLIPPER_MMU_F207_BOOT_GATES
    depends on !(MACH_STM32G431 || MACH_STM32G474) || KLIPPER_MMU_G4_BOOT_GATES
    depends on !(MACH_STM32H743 || MACH_STM32H750) || KLIPPER_MMU_H743_H750_BOOT_GATES
    depends on !(MACH_STM32G0B0 || MACH_STM32G0B1) || KLIPPER_MMU_G0B_BOOT_GATES
    help
        Firmware-owned hosted diagnostic startup for H723 or the explicitly
        constrained F207/F405/F407/F429/F765/G431/G474/H743/H750/G0B0/G0B1
        passive profiles. Default off except for the ordinary BoxTurtle/AFC Lite
        switched-buffer preset. Does not select manual pins or boot identity.
        The target profile gate selects local GPIO and
        shared TMC UART driver support only when its full profile matches.

        A gear with no shared TMC UART (QIDI Box's own KLIPPER_MMU_
        QIDI_BOOT_GATES, mcu/Kconfig) also admits this menu: mcu/board_startup.c
        runs that gear as plain STEP/DIR instead of waiting on a TMC
        confirmation this hardware can never send.

        Pin configuration and driver initialization run only after the host
        sends km_diagnostic_start (or km_diagnostic_start_host with a nonzero
        epoch in host-epoch builds), and only after normal Klipper configuration.
        The intended host path is add_config_cmd(..., is_init=True) once that
        host has finished RESERVE_PINS, alias, and BUS_PINS checks. This MCU
        option does not census Klipper clients and does not add authorization.

        Outputs stay inactive. km_start is rejected unless the separate
        experimental actuator gate is selected and startup reaches READY.
        Hardware qualification is still pending. DiffA/DiffB requires a
        validated calibration object and H723 local ADC support; missing
        calibration faults before board setup. Unsupported saved factories
        still fail honestly. ACTUATION remains 0 by default.

if KLIPPER_MMU_DIAGNOSTIC_STARTUP

config KLIPPER_MMU_ACTUATION_OPT_IN
    bool "Experimental actuator START permission (requires physical qualification)"
    default n
    depends on !KLIPPER_MMU_POWERED_REWIND || WANT_HARD_PWM_LOCAL_PAIR
    help
        Build permission for autonomous MMU START after the hosted startup
        reaches READY. This is a software opt-in, not hardware qualification.
        Do not flash or use this option until the physical pin routing,
        inactive output levels, current and pulse limits, safe-off, and fault
        response have been measured on the exact board and mechanism.
        A failed startup or shutdown cannot grant START.
        Paired analog feedback also requires validated calibration delivered
        before diagnostic startup by the host.

config KLIPPER_MMU_DIAGNOSTIC_TIMEOUT_US
    int "Hosted diagnostic startup deadline (microseconds)"
    range 1000 1000000
    default 1000000
    help
        One total deadline, counted from the first km_diagnostic_start.
        Includes clock and identity wait plus asynchronous board setup.
        1000000 us stays inside the H723 raw-tick half horizon (2^31 ticks)
        at 520 MHz. Firmware rejects an invalid timeout or tick conversion
        at compile time; the menu range is not the only check.

