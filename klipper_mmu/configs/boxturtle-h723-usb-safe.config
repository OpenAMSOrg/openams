# SPDX-License-Identifier: GPL-3.0-or-later
# Minimal Kconfig fragment for the boxturtle-h723-usb-safe release image:
# BoxTurtle/AFC Lite, USB, diagnostic-only (actuator START refused; compiles
# the receive-only raw DiffA/DiffB probe for calibration). Build and
# bench-check this one first (docs/boxturtle-h723-acceptance.md). Copy this
# file to your KCONFIG_CONFIG path, then
# `make KCONFIG_CONFIG=<path> OUT=<dir> olddefconfig` fills in every other
# symbol from its Kconfig default. See docs/boxturtle-quick-start.md and
# tests/release_matrix/README.md, whose release matrix builds this exact
# fragment.

# Klipper's own STM32H723 target: 25 MHz crystal, USB PA11/PA12, no
# bootloader offset.
CONFIG_MACH_STM32=y
CONFIG_MACH_STM32H723=y
CONFIG_LOW_LEVEL_OPTIONS=y
CONFIG_STM32_CLOCK_REF_25M=y
CONFIG_STM32_FLASH_START_0000=y
CONFIG_USBSERIAL=y

# klipper-mmu: BoxTurtle, AFC Lite wiring preset, DiffA/DiffB FPS arrival
# (no toolhead switch).
CONFIG_KLIPPER_MMU=y
CONFIG_KLIPPER_MMU_DEVICE_BOXTURTLE=y
CONFIG_KLIPPER_MMU_BOARD_AFC_LITE=y
CONFIG_KLIPPER_MMU_PIN_CONFIG=y
CONFIG_WANT_ADC=y
CONFIG_WANT_ADC_LOCAL=y
CONFIG_KLIPPER_MMU_DIFF_BUFFER=y
CONFIG_KLIPPER_MMU_ADC_CONVERSION_TIMEOUT_US=1000
CONFIG_KLIPPER_MMU_ADC_PAIR_SPAN_US=3000
CONFIG_KLIPPER_MMU_ADC_SAMPLE_AGE_US=20000
CONFIG_KLIPPER_MMU_BOOT_IDENTITY_H723=y
CONFIG_KLIPPER_MMU_DIAGNOSTIC_STARTUP=y
CONFIG_KLIPPER_MMU_FPS_ARRIVAL=y
# CONFIG_KLIPPER_MMU_TOOLHEAD_SENSOR is not set

# Diagnostic-only: actuator START stays refused.
# CONFIG_KLIPPER_MMU_ACTUATION_OPT_IN is not set
