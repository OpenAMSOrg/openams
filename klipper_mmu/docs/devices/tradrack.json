  "decisions": [
    {
      "concept": "selector",
      "note": "LinearServoSelector: a homing linear carriage (`selector_stepper: unit0_selector`) plus an RC servo grip (`selector_servo: unit0_selector_servo`), both named in `[mmu_unit unit0]` (mmu_linear_selector.py). This dossier's hardware snapshot keeps only the gear stepper, so the selector wiring itself -- MMB 2.0 selector stepper PC9/PC8/!PD2 with endstop ^PA15 and servo PA1 (Happy Hare's `installer/boards/Kconfig.mmb_2_0:89-101`) -- is in the rendered profile, not in this dossier. Tradrack declares `filament_always_gripped: 0`, so its release path lifts the servo. klipper-mmu drives it as a LINEAR selector with a grip servo (`KLIPPER_MMU_SELECTOR_KIND_LINEAR`, `KLIPPER_MMU_SELECTOR_LINEAR_HAS_SERVO`): the carriage homes to its endstop before the first selection and after a fault, the servo grips at 1 degree and releases and travels at 145 with a 1.0 s dwell, driven by Klipper's scheduled software PWM on any GPIO (`KLIPPER_MMU_PINS_SERVO`), and the ten gate positions start from an estimate computed from Happy Hare's CAD geometry (`2.5` mm, then every `17` mm) until `KLIPPER_MMU_CALIBRATE_SELECTOR` measures the real ones. Software candidate: it builds and passes the simulators, but has not run on real hardware."
    },
    {
      "concept": "encoder",
      "note": "No encoder is declared: `[mmu_unit unit0]` names no `encoder` and the trace has no `[mmu_encoder]` section, so klipper-mmu's optional encoder input (`KLIPPER_MMU_ENCODER`) stays off for this device. Happy Hare treats Tradrack's Binky encoder as an optional mod (installer/mmu_types/Kconfig.tradrack:29), not part of this trace."
    },
    {
      "concept": "arrival",
      "note": "LOAD's only homing move is the gear homing to `unit0:mmu_shared_exit` (`gate_homing_endstop: mmu_shared_exit`, `extruder_homing_endstop: none`); the last move is gear+extruder to the nozzle with no endstop, so toolhead arrival is dead-reckoned, not sensed. Arrival sensing is therefore the shared-exit switch only."
    },
    {
      "concept": "buffer_type",
      "note": "No `[mmu_buffer unit0]` section in the trace, so no switched or analog buffer pins: buffer following is not modelled by this dossier."
    },
    {
      "concept": "preload_park",
      "note": "PRELOAD reverse-homes onto `unit0:mmu_shared_exit`, then parks `operations.preload.end.tip = -7.5` = `gate_preload_parking_distance: -17.5` mm behind the switch."
    },
    {
      "concept": "unload_park",
      "note": "UNLOAD reverse-homes onto `unit0:mmu_shared_exit` and parks `operations.unload.end.tip = -7.5` = 17.5 mm behind it (`gate_parking_distance: -17.5`)."
    },
    {
      "concept": "eject_extra",
      "note": "EJECT retracts `gate_final_eject_distance: 20` mm from the -7.5 park to tip -27.5, with no endstop (homing=false)."
    }
  ]
