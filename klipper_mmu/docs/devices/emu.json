  "decisions": [
    {
      "concept": "arrival",
      "note": "PSF proportional (Happy Hare's default, measured: homes to filament_compression at layout.extruder + 11.2mm), a switched advance/trailing buffer (AFC's default template), or a plain toolhead switch -- upstream offers a full menu of ways to know filament arrived. klipper-mmu ends LOAD at a local toolhead switch or at FPS arrival read over the DiffA/DiffB pair; a single-ended PSF ADC frontend is not implemented."
    },
    {
      "concept": "preload_park",
      "note": "Happy Hare parks PRELOAD 1mm behind mmu_exit_0 (measured, Kconfig default PARAM_GATE_PRELOAD_PARKING_DISTANCE -1) -- klipper-mmu's EMU also rests just behind it: PRELOAD backs off until that LOAD switch, its virtual hub, clears."
    },
    {
      "concept": "unload_park",
      "note": "Happy Hare parks UNLOAD 1mm behind mmu_exit_0 (measured this trace) vs AFC's hub_clear_move_dis of 5mm -- close enough to argue about, not close enough to ignore."
    },
    {
      "concept": "eject_extra",
      "note": "Happy Hare's EJECT retracts a flat 100mm from park (measured this trace, homed=false: it never bothers confirming a switch, just trusts the budget) vs AFC's extruder_clear_dis of 50mm -- twice as generous, no obvious reason."
    },
    {
      "concept": "short_speed",
      "note": "80/80 mm/s (Happy Hare's gear_short_move_speed/accel) vs 50/300 (AFC.cfg's short speed/accel) -- one upstream likes a gentle short move, the other likes to floor it and brake hard. klipper-mmu follows Happy Hare's EMU numbers (its EMU braking acceleration is the 80 mm/s^2 `gear_short_move_accel`)."
    },
    {
      "concept": "bowden",
      "note": "Per-lane calibrated bowden length storage is still open: klipper-mmu stores one measured Bowden length per unit (`bowden_estimate_file`), but EMU's variable_bowden_lengths=1 and AFC's per-lane afc_bowden_length both want one length per lane."
    },
    {
      "concept": "lane_count",
      "note": "AFC's pinned EMU.cfg is a single-lane reference template (its own header comment: 'The installer generates a complete multi-lane config from this layout'), so a plain read sees 1 lane; Happy Hare's emu profile models the full 5-gate unit. Both upstreams put one MCU per lane -- a fact, not a discrepancy to resolve; EMU stays a single-board software candidate."
    },
    {
      "concept": "sensor_polarity",
      "note": "AFC's EMU_SLB wiring inverts and pulls up TRG (prep: ^!emu_lane1:TRG -> PA1); Happy Hare's emu trace models the same PA1 pin pulled up only, no invert (entry=^!,exit=^ vs entry=^,exit=^). New device: adopting HH's convention (no invert) until hardware evidence says otherwise."
    },
    {
      "concept": "buffer_type",
