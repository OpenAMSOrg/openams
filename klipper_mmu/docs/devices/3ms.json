  "decisions": [
    {
      "concept": "arrival",
      "note": "Happy Hare's 3MS declares no per-gate entry/exit switches and no hub; LOAD's last homing move ends on endstop 'extruder' (mmu_toolhead.extruder_switch_pin mcu:PA7, layout.extruder 210mm) and gate_homing_endstop is 'extruder'. PRELOAD, whose gate_preload_endstop is empty, homes on the same toolhead switch. Default: adopt HH's single toolhead-extruder arrival -- there is no AFC template for 3MS to cross-check."
    },
    {
      "concept": "buffer_type",
      "note": "No [mmu_buffer] section and no buffer pins are rendered for 3MS -- the unit is four gear steppers plus a toolhead switch. Baseline runs with no buffer; AFC has no 3MS template to cross-check."
    },
    {
      "concept": "encoder",
      "note": "No encoder node or pins are rendered for 3MS: unit0 declares only the four gear steppers plus a TMC2209 virtual endstop (mmu_gear_touch=tmc2209_unit0_gear). klipper-mmu's optional encoder input (`KLIPPER_MMU_ENCODER`) stays off for 3MS."
    },
    {
      "concept": "espooler",
      "note": "No [mmu_espooler] section or assist pins are rendered for 3MS. klipper-mmu's powered rewind (`KLIPPER_MMU_POWERED_REWIND`) is on by default only for BoxTurtle and Claymore; 3MS runs without espooler assist."
    },
    {
      "concept": "preload_park",
      "note": "Happy Hare parks PRELOAD 250mm behind the extruder switch (gate_preload_parking_distance -250; measured: home to the 210mm switch with a +250mm move, then park back to tip -40, i.e. 250mm behind the switch). Rest position recorded as a distance."
    },
    {
      "concept": "unload_park",
      "note": "Happy Hare parks UNLOAD 250mm behind the extruder switch too (gate_parking_distance -250; measured tip -40). Same rest as PRELOAD."
    },
    {
      "concept": "drive_scale",
      "note": "3MS sets variable_rotation_distances=1 (per-gate rotation distances) and its stepper declares rotation_distance 22.7316868. klipper-mmu supports per-lane rotation distance (`feeder_rotation_distances` on the host, or `KLIPPER_MMU_FEEDER_LANE_ROTATION_DISTANCES_UM`); Happy Hare ships no per-gate values, so none is set by default. Measure a lane with `KLIPPER_MMU_CALIBRATE BAY=n SAVE=0`."
    },
    {
      "concept": "bowden",
      "note": "3MS sets require_bowden_move=0 and variable_bowden_lengths=0: LOAD goes straight to the toolhead switch on a 500mm budget with no bowden calibration, and the unit_profile declares no per-gate lengths. Host-owned; no AFC template."
    }
  ]
