  "decisions": [
    {
      "concept": "long_speed",
      "note": "NightOwl's speed numbers here are NightOwl's own, and klipper-mmu's NightOwl preset takes them from this dossier. EMU once borrowed them before its own trace existed; it now has its own (250 mm/s, 120 mm/s^2, from the EMU dossier)."
    },
    {
      "concept": "entry_sensor",
      "note": "Pins are board wiring, not device behaviour. Happy Hare's harness has no NightOwl board profile, so its PB1 is a harness placeholder; AFC's ERB 2.0 template (ERB_2.0.cfg alias LANE1_EXT -> gpio4) is the real reference for an ERB build. klipper-mmu takes pins from the selected MCU board preset, so this row is informational."
    },
    {
      "concept": "exit_sensor",
      "note": "Same as entry_sensor: HH's PB11 is a harness placeholder; AFC's ERB 2.0 wiring (alias LANE1_TRIG -> gpio3) is the real reference. Pins come from the board preset; informational."
    },
    {
      "concept": "unload_park",
      "note": "AFC's NightOwl hub section sets no hub_clear_move_dis, so the fact falls back to the per-lane park_dist of 10mm (itself flagged 'Currently unused' in extras/AFC_lane.py); Happy Hare parks UNLOAD 100mm behind mmu_exit_0. klipper-mmu adopts HH's number: NightOwl's UNLOAD retracts 100 mm past the switch (`KLIPPER_MMU_UNLOAD_HUB_CLEAR_MM`)."
    },
    {
      "concept": "short_speed",
      "note": "AFC.cfg's global short_moves_speed/accel is 50/300 (NightOwl's template sets no override); Happy Hare's gear_short_move_speed/accel is 80/400. klipper-mmu adopts HH's numbers (80/400)."
    }
  ]
