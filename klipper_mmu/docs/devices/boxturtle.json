  "decisions": [
    {
      "concept": "preload_park",
      "note": "Happy Hare parks PRELOAD at mmu_exit_0 + 10mm (measured this trace), and AFC's park_dist agrees at 10mm too -- a rare case of two upstreams shaking hands on a number. klipper-mmu deliberately rests PRELOAD right on the LOAD switch instead: a decision, not a bug."
    },
    {
      "concept": "unload_park",
      "note": "Happy Hare parks UNLOAD at unit0:mmu_shared_exit - 100mm (measured this trace). klipper-mmu's BoxTurtle retracts a provisional 65 mm past the HUB switch (`KLIPPER_MMU_UNLOAD_HUB_CLEAR_MM`), 35 mm short of Happy Hare's number, and keeps that shipped value until it is measured on real hardware; a new device takes Happy Hare's number instead."
    },
    {
      "concept": "eject_extra",
      "note": "The Kconfig default (installer/mmu_types/Kconfig.box_turtle) hands EJECT a generous 300mm homing budget, but it is still a home against mmu_entry, not a fixed offset -- this trace only needs about 150mm of it and lands essentially AT mmu_entry (offset ~0mm). Not yet cross-checked against AFC's BoxTurtle template."
    },
    {
      "concept": "buffer_type",
      "note": "BoxTurtle ships a switched tension/compression buffer only in this profile -- no analog_pin, no PSF, nothing fancy. The side effect: filament_compression/filament_tension homing is a travel threshold, not a fixed tip position, so this dossier's self-consistency check does not hold those homing moves to a fixed position."
    },
    {
      "concept": "sensor_polarity",
      "note": "AFC's AFC-Lite wiring for lane1's prep pin is inverted and pulled up (prep: ^!Turtle_1:TRG1 -> PC5); Happy Hare's boxturtle harness profile models the same PC5 pin pulled up only, no invert (entry=^!,exit=^ vs entry=^,exit=^). klipper-mmu keeps its shipped BoxTurtle polarity; both facts are recorded, not reconciled."
    },
    {
      "concept": "long_speed",
      "note": "AFC.cfg's global long_moves_speed/accel is 150 mm/s / 250 mm/s^2 (AFC_Turtle_1.cfg sets no unit override); Happy Hare's gear_load_speed/accel is 100/100. klipper-mmu keeps its own BoxTurtle motion (26 mm/s feed, 500 mm/s^2 acceleration, `KLIPPER_MMU_FEED_SPEED_MM_S`, `KLIPPER_MMU_ACCELERATION_MM_S2`); both upstream numbers are recorded."
    },
    {
      "concept": "short_speed",
      "note": "AFC.cfg's global short_moves_speed/accel is 50/300; Happy Hare's gear_short_move_speed/accel is 80/400. klipper-mmu keeps its own BoxTurtle motion; both upstream numbers are recorded."
    }
  ]
