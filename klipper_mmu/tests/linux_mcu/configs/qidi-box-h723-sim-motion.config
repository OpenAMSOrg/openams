# SPDX-License-Identifier: GPL-3.0-or-later
# Sim-only Kconfig fragment: QIDI Box, actuation-permitted, for
# tests/linux_mcu/device_scenarios.py (see tests/linux_mcu/devices.py and
# README.md). Not a release image and not built by tests/release_matrix.
#
# Like the NightOwl/EMU fragments next to this one, QIDI Box requires manual
# pin configuration (mcu/Kconfig's KLIPPER_MMU_QIDI_BOOT_GATES depends on
# KLIPPER_MMU_BOARD_CUSTOM), so every pin/electrical value is copied in
# explicitly at the exact values the AFC Lite/BoxTurtle preset would
# otherwise default -- same bench wiring, different device composition.
#
# QIDI Box's own shape (docs/devices/qidi_box.md) is NOT NightOwl/EMU's:
#  - No gear TMC UART (KLIPPER_MMU_GEAR_TMC_UART defaults off for this
#    device, mcu/Kconfig.control) -- no PINS_UART/TMC_ADDRESSES/
#    TMC_UART_PULLUP below; mcu/board_startup.c binds the gear as plain
#    STEP/DIR instead, so this fragment needs no sim TMC2209 replies at all.
#  - A real shared HUB switch (has_hub_switch=True, same as NightOwl),
#    not EMU's virtual one.
#  - Per-lane BAY entry switches, but no LOAD switches at all (the dossier's
#    own hardware table has no mmu_exit_<n> pins) -- no PINS_LOAD/
#    LOAD_SENSORS below.
#  - A tension-only switched buffer (KLIPPER_MMU_BUFFER_SINGLE_SWITCH),
#    not NightOwl/EMU's DiffA/DiffB analog pair -- no WANT_ADC*/DIFF_BUFFER/
#    FPS_ARRIVAL below.
#  - LOAD ends on a real physical toolhead-arrival switch
#    (KLIPPER_MMU_TOOLHEAD_SENSOR, its own Kconfig default when FPS arrival
#    is not selected), not FPS arrival. The dossier's own stock wiring puts
#    that switch on the printer's toolhead MCU (extruder_switch_pin=!THR:
#    PA1), unreachable from this board; this fragment moves it onto a pin
#    this board itself reads, exactly as docs/devices/qidi_box.md's arrival
#    note requires.
#
# sim/board/plant.c models this real shape with two small additions next to
# its existing shared HUB pin: a real toolhead-arrival switch (PE7, the AFC
# Lite bench's own toolhead connector) and a tension-only buffer switch
# (PC4, the AFC Lite bench's own buffer connector, wired to a plain switch
# here instead of DiffA/DiffB) -- see KM_SIM_PLANT_TOOLHEAD_PIN/
# KM_SIM_PLANT_BUFFER_TENSION_PIN there.
CONFIG_MACH_STM32=y
CONFIG_MACH_STM32H723=y
CONFIG_LOW_LEVEL_OPTIONS=y
CONFIG_STM32_CLOCK_REF_25M=y
CONFIG_STM32_FLASH_START_0000=y
CONFIG_USBSERIAL=y

CONFIG_KLIPPER_MMU=y
CONFIG_KLIPPER_MMU_DEVICE_QIDI_BOX=y
CONFIG_KLIPPER_MMU_BOARD_CUSTOM=y
CONFIG_KLIPPER_MMU_PIN_CONFIG=y

# Feeder pins/electrical: identical values to the AFC Lite preset (plain
# STEP/DIR -- no PINS_UART, this gear has no TMC UART chip to talk to).
CONFIG_KLIPPER_MMU_PINS_STEP="PD4,PC12,PE2,PD15"
CONFIG_KLIPPER_MMU_PINS_DIR="PD3,PC11,PE3,PD14"
CONFIG_KLIPPER_MMU_PINS_ENABLE="PD6,PD1,PE0,PC7"
CONFIG_KLIPPER_MMU_FEEDER_ENABLE_HIGH="0,0,0,0"
CONFIG_KLIPPER_MMU_FEEDER_STEP_HIGH="1,1,1,1"
CONFIG_KLIPPER_MMU_FEEDER_FORWARD_HIGH="0,0,0,0"
CONFIG_KLIPPER_MMU_STEP_MAX_SPEED_MM_S=200

# Presence pins: per-lane BAY, no LOAD, a real shared HUB.
CONFIG_KLIPPER_MMU_PINS_BAY="PE13,PB0,PB1,PB2"
CONFIG_KLIPPER_MMU_BAY_ACTIVE_HIGH="0,0,0,0"
CONFIG_KLIPPER_MMU_BAY_PULL="1,1,1,1"
CONFIG_KLIPPER_MMU_PINS_HUB="PE12"
CONFIG_KLIPPER_MMU_HUB_ACTIVE_HIGH=1
CONFIG_KLIPPER_MMU_HUB_PULL=1

# Real physical toolhead-arrival switch (sim/board/plant.c
# KM_SIM_PLANT_TOOLHEAD_PIN), active high to match the plant.
CONFIG_KLIPPER_MMU_PINS_TOOLHEAD="PE7"
CONFIG_KLIPPER_MMU_TOOLHEAD_ACTIVE_HIGH=1
CONFIG_KLIPPER_MMU_TOOLHEAD_PULL=1

# Tension-only switched buffer (sim/board/plant.c
# KM_SIM_PLANT_BUFFER_TENSION_PIN, always at rest -- this bench's short
# scenarios never run it dry), active high to match the plant.
CONFIG_KLIPPER_MMU_BUFFER_SINGLE_SWITCH=y
CONFIG_KLIPPER_MMU_PINS_BUFFER_A="PC4"
CONFIG_KLIPPER_MMU_BUFFER_ACTIVE_HIGH="1"
CONFIG_KLIPPER_MMU_BUFFER_PULL="1"

CONFIG_KLIPPER_MMU_BOOT_IDENTITY_H723=y
CONFIG_KLIPPER_MMU_DIAGNOSTIC_STARTUP=y

# Actuator-permitted: same gate as configs/boxturtle-h723-usb.config. This
# fragment is sim-only and is never used to flash real hardware.
CONFIG_KLIPPER_MMU_ACTUATION_OPT_IN=y

# gpio.c (sim/board/**) unconditionally implements the PWM-pair driver API
# (struct gpio_pwm_pair_info); BoxTurtle only pulls its declaration in via
# KLIPPER_MMU_BOXTURTLE_BOOT_GATES's select. Request it directly here
# instead -- no rewind pins are configured, so nothing actuates.
CONFIG_WANT_HARD_PWM_LOCAL_PAIR=y
CONFIG_WANT_HARD_PWM_QUERY=y
