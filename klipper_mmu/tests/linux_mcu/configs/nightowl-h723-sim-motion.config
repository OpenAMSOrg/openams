# SPDX-License-Identifier: GPL-3.0-or-later
# Sim-only Kconfig fragment: NightOwl, actuation-permitted, for
# tests/linux_mcu/device_scenarios.py (see tests/linux_mcu/devices.py and
# README.md). Not a release image and not built by tests/release_matrix.
#
# NightOwl requires manual pin configuration -- mcu/Kconfig's
# KLIPPER_MMU_NIGHTOWL_BOOT_GATES depends on KLIPPER_MMU_BOARD_CUSTOM, not
# the AFC Lite preset -- so every pin and electrical setting AFC Lite would
# otherwise default is copied in explicitly below, at the exact same
# values configs/boxturtle-h723-usb.config gets from the AFC Lite/BoxTurtle
# defaults. This is deliberate: pins are board wiring, not device behaviour
# (AGENTS.md), and this sim board only ever models the one bench wiring
# tests/linux_mcu/README.md documents. sim/board/plant.c's pin tables are
# therefore unchanged by this fragment; only the device composition is
# different from BoxTurtle's.
#
# Composition: passive rewind (no PWM; NightOwl's Kconfig.devices help
# text), a physical per-lane LOAD switch and a physical shared HUB switch
# (has_hub_switch=True in devices.py), matching docs/devices/nightowl.json's
# hardware.mmu_sensors (entry->BAY, exit->LOAD) and its concept-mapping
# table's "Hub / shared exit" row -- not EMU's virtual hub.
CONFIG_MACH_STM32=y
CONFIG_MACH_STM32H723=y
CONFIG_LOW_LEVEL_OPTIONS=y
CONFIG_STM32_CLOCK_REF_25M=y
CONFIG_STM32_FLASH_START_0000=y
CONFIG_USBSERIAL=y

CONFIG_KLIPPER_MMU=y
CONFIG_KLIPPER_MMU_DEVICE_NIGHTOWL=y
CONFIG_KLIPPER_MMU_BOARD_CUSTOM=y
CONFIG_KLIPPER_MMU_PIN_CONFIG=y

# Feeder pins/electrical: identical values to the AFC Lite preset.
CONFIG_KLIPPER_MMU_PINS_STEP="PD4,PC12,PE2,PD15"
CONFIG_KLIPPER_MMU_PINS_DIR="PD3,PC11,PE3,PD14"
CONFIG_KLIPPER_MMU_PINS_ENABLE="PD6,PD1,PE0,PC7"
CONFIG_KLIPPER_MMU_PINS_UART="PD5,PD0,PE1,PC6"
CONFIG_KLIPPER_MMU_FEEDER_ENABLE_HIGH="0,0,0,0"
CONFIG_KLIPPER_MMU_FEEDER_STEP_HIGH="1,1,1,1"
CONFIG_KLIPPER_MMU_FEEDER_FORWARD_HIGH="0,0,0,0"
CONFIG_KLIPPER_MMU_STEP_MAX_SPEED_MM_S=200

CONFIG_KLIPPER_MMU_TMC_ADDRESSES="0,0,0,0"
CONFIG_KLIPPER_MMU_TMC_UART_PULLUP="1,1,1,1"
CONFIG_KLIPPER_MMU_TMC_RSENSE=110
CONFIG_KLIPPER_MMU_TMC_CURRENT_CEILING=800

# Presence/buffer pins: per-lane LOAD switch and a physical shared HUB.
CONFIG_KLIPPER_MMU_LOAD_SENSORS=y
CONFIG_KLIPPER_MMU_PINS_BAY="PE13,PB0,PB1,PB2"
CONFIG_KLIPPER_MMU_PINS_LOAD="PE8,PE9,PE10,PE11"
CONFIG_KLIPPER_MMU_PINS_HUB="PE12"
CONFIG_KLIPPER_MMU_BAY_ACTIVE_HIGH="0,0,0,0"
CONFIG_KLIPPER_MMU_BAY_PULL="1,1,1,1"
CONFIG_KLIPPER_MMU_LOAD_ACTIVE_HIGH="1,1,1,1"
CONFIG_KLIPPER_MMU_LOAD_PULL="1,1,1,1"
CONFIG_KLIPPER_MMU_HUB_ACTIVE_HIGH=1
CONFIG_KLIPPER_MMU_HUB_PULL=1

CONFIG_WANT_ADC=y
CONFIG_WANT_ADC_LOCAL=y
CONFIG_KLIPPER_MMU_DIFF_BUFFER=y
CONFIG_KLIPPER_MMU_PINS_BUFFER_A="PC4"
CONFIG_KLIPPER_MMU_PINS_BUFFER_B="PC5"
CONFIG_KLIPPER_MMU_ADC_CONVERSION_TIMEOUT_US=1000
CONFIG_KLIPPER_MMU_ADC_PAIR_SPAN_US=3000
CONFIG_KLIPPER_MMU_ADC_SAMPLE_AGE_US=20000

CONFIG_KLIPPER_MMU_BOOT_IDENTITY_H723=y
CONFIG_KLIPPER_MMU_DIAGNOSTIC_STARTUP=y
CONFIG_KLIPPER_MMU_FPS_ARRIVAL=y
# CONFIG_KLIPPER_MMU_TOOLHEAD_SENSOR is not set

# FPS arrival/LOAD profile numbers: reused from BoxTurtle's own
# device-conditioned Kconfig defaults (mcu/Kconfig.control), which are
# already proven to fit sim/board/plant.c's short geometry
# (KM_SIM_PLANT_TOOLHEAD_MM=150, KM_SIM_PLANT_BUFFER_MM=15) by
# tests/linux_mcu/load_check.py. NightOwl's own dossier numbers
# (docs/devices/nightowl.json) are compared at the Python/phase-order level
# (tests/linux_mcu/devices.py), not by trying to make the firmware Kconfig
# reproduce HH's synthetic millimetres.
CONFIG_KLIPPER_MMU_FPS_ARRIVAL_MIN_MM=100
CONFIG_KLIPPER_MMU_FPS_ARRIVAL_MAX_MM=1900
CONFIG_KLIPPER_MMU_LOAD_CRUISE_SPEED_MM_S=200
CONFIG_KLIPPER_MMU_LOAD_CRAWL_SPEED_MM_S=20
CONFIG_KLIPPER_MMU_LOAD_WINDOW_MM=50
CONFIG_KLIPPER_MMU_BUFFER_TRAVEL_MM=15
# The braking-fits-the-buffer build check (mcu/feeder_mechanics.h) needs
# BoxTurtle's braking accel too, not just its speeds/distances -- the
# non-BoxTurtle default (17 mm/s^2) can't stop a 20 mm/s crawl inside a
# 15 mm buffer above the 700-permille arrival threshold.
CONFIG_KLIPPER_MMU_FEED_SPEED_MM_S=26
CONFIG_KLIPPER_MMU_RETRACT_SPEED_MM_S=26
CONFIG_KLIPPER_MMU_ACCELERATION_MM_S2=500
CONFIG_KLIPPER_MMU_DECELERATION_MM_S2=500
# 0 (the non-BoxTurtle default) means "no extra HUB clearance," which left
# a full OAMSM_UNLOAD_FILAMENT resting between LOAD and HUB instead of
# behind LOAD (found running device_scenarios.py); BoxTurtle's 65mm clears
# past LOAD too on this same sim geometry.
CONFIG_KLIPPER_MMU_UNLOAD_HUB_CLEAR_MM=65

# Actuator-permitted: same gate as configs/boxturtle-h723-usb.config. This
# fragment is sim-only and is never used to flash real hardware.
CONFIG_KLIPPER_MMU_ACTUATION_OPT_IN=y

# gpio.c (sim/board/**) unconditionally implements the PWM-pair driver API
# (struct gpio_pwm_pair_info); BoxTurtle only pulls its declaration in via
# KLIPPER_MMU_BOXTURTLE_BOOT_GATES's select. Request it directly here
# instead -- no rewind pins are configured, so nothing actuates.
CONFIG_WANT_HARD_PWM_LOCAL_PAIR=y
CONFIG_WANT_HARD_PWM_QUERY=y
