# SPDX-License-Identifier: GPL-3.0-or-later
# Sim-only Kconfig fragment: 3MS, actuation-permitted, for
# tests/linux_mcu/device_scenarios.py (see tests/linux_mcu/devices.py and
# README.md). Not a release image and not built by tests/release_matrix.
#
# 3MS requires manual pin configuration -- mcu/Kconfig's
# KLIPPER_MMU_PASSIVE_FEEDER_BOOT_GATES depends on KLIPPER_MMU_BOARD_CUSTOM,
# not the AFC Lite preset -- so every pin/electrical value below is the exact
# same AFC Lite/BoxTurtle bench value NightOwl/QIDI Box/Angry Beaver's own
# fragments next to this one already use. Pins are board wiring, not device
# behaviour (AGENTS.md).
#
# 3MS's own shape (docs/devices/3ms.json) is Angry Beaver's shape (no BAY,
# no LOAD, real HUB, no buffer) minus even the shared exit sensor:
#  - No per-lane BAY or LOAD switch (KLIPPER_MMU_BAY_SENSORS defaults off
#    for this device too, same dossier reason as Angry Beaver): a lane
#    starts with filament at the spool, already gripped
#    ("filament_always_gripped": true), so PRELOAD is unavailable
#    (km_core_request_preload needs a BAY sensor) and
#    tests/linux_mcu/device_scenarios.py starts lane 0 at the plant's
#    "empty" state and skips straight to LOAD, same as Angry Beaver.
#  - No shared HUB sensor at all: 3MS's traced Happy Hare profile has no
#    MMU_HAS_SENSOR_SHARED_EXIT symbol and renders no
#    mmu_shared_exit_switch_pin -- its `[mmu_sensors unit0]` block carries
#    only `register_mmu_sensors`. PRELOAD's own homing move (were it
#    available) and LOAD both end on the toolhead/extruder switch instead
#    (docs/devices/3ms.json operations.load.end.sensor == "extruder"), which
#    is why tests/linux_mcu/devices.py rows this device has_hub_switch=False
#    -- unlike Angry Beaver/QuattroBox, no dossier operation this device
#    supports rests against the hub. This firmware's own profile struct
#    still always carries has_hub_sensor=true (mcu/config.c) with no
#    per-device way to turn it off, and a device with no per-lane LOAD
#    switch cannot use the virtual-hub path either (KLIPPER_MMU_VIRTUAL_HUB
#    projects the hub from a lane's own LOAD switch, which 3MS does not
#    have) -- so, exactly like Angry Beaver/QuattroBox, this bench still
#    wires a real physical HUB pin for the firmware's own state machine to
#    clear on its way to the toolhead switch, purely a board-wiring/firmware
#    necessity and not a claim that real 3MS hardware has that switch.
#  - LOAD ends on the local physical toolhead-arrival switch
#    (KLIPPER_MMU_TOOLHEAD_SENSOR, on by default without FPS arrival),
#    matching the dossier's own "extruder" endstop directly (unlike Angry
#    Beaver, whose dossier drove that segment open-loop).
#  - No buffer hardware (dossier "buffer_type": no [mmu_buffer] section):
#    same tension-only switch stand-in as Angry Beaver/QIDI Box, needing no
#    new plant support.
CONFIG_MACH_STM32=y
CONFIG_MACH_STM32H723=y
CONFIG_LOW_LEVEL_OPTIONS=y
CONFIG_STM32_CLOCK_REF_25M=y
CONFIG_STM32_FLASH_START_0000=y
CONFIG_USBSERIAL=y

CONFIG_KLIPPER_MMU=y
CONFIG_KLIPPER_MMU_DEVICE_THREE_MS=y
CONFIG_KLIPPER_MMU_BOARD_CUSTOM=y
CONFIG_KLIPPER_MMU_PIN_CONFIG=y

# Feeder pins/electrical: identical values to the AFC Lite preset (gear TMC
# UART stays on for this device, mcu/Kconfig.control's default).
CONFIG_KLIPPER_MMU_PINS_STEP="PD4,PC12,PE2,PD15"
CONFIG_KLIPPER_MMU_PINS_DIR="PD3,PC11,PE3,PD14"
CONFIG_KLIPPER_MMU_PINS_ENABLE="PD6,PD1,PE0,PC7"
CONFIG_KLIPPER_MMU_PINS_UART="PD5,PD0,PE1,PC6"
CONFIG_KLIPPER_MMU_FEEDER_ENABLE_HIGH="0,0,0,0"
CONFIG_KLIPPER_MMU_FEEDER_STEP_HIGH="1,1,1,1"
CONFIG_KLIPPER_MMU_FEEDER_FORWARD_HIGH="0,0,0,0"

CONFIG_KLIPPER_MMU_TMC_ADDRESSES="0,0,0,0"
CONFIG_KLIPPER_MMU_TMC_UART_PULLUP="1,1,1,1"
CONFIG_KLIPPER_MMU_TMC_RSENSE=110
CONFIG_KLIPPER_MMU_TMC_CURRENT_CEILING=800

# Presence pins: no per-lane BAY/LOAD switch; a real physical HUB pin for
# the firmware's own state machine even though this device's dossier has no
# shared-exit sensor (see header).
CONFIG_KLIPPER_MMU_PINS_HUB="PE12"
CONFIG_KLIPPER_MMU_HUB_ACTIVE_HIGH=1
CONFIG_KLIPPER_MMU_HUB_PULL=1

# Real physical toolhead-arrival switch (sim/board/plant.c
# KM_SIM_PLANT_TOOLHEAD_PIN), active high to match the plant -- this is the
# same physical sensor 3ms.json's own "extruder" endstop names.
CONFIG_KLIPPER_MMU_PINS_TOOLHEAD="PE7"
CONFIG_KLIPPER_MMU_TOOLHEAD_ACTIVE_HIGH=1
CONFIG_KLIPPER_MMU_TOOLHEAD_PULL=1

# Tension-only switched buffer (sim/board/plant.c
# KM_SIM_PLANT_BUFFER_TENSION_PIN, always at rest -- this bench's short
# scenarios never run it dry), active high to match the plant. Stands in for
# hardware this device's own dossier records as absent (see header).
CONFIG_KLIPPER_MMU_BUFFER_SINGLE_SWITCH=y
CONFIG_KLIPPER_MMU_PINS_BUFFER_A="PC4"
CONFIG_KLIPPER_MMU_BUFFER_ACTIVE_HIGH="1"
CONFIG_KLIPPER_MMU_BUFFER_PULL="1"

CONFIG_KLIPPER_MMU_BOOT_IDENTITY_H723=y
CONFIG_KLIPPER_MMU_DIAGNOSTIC_STARTUP=y

# Actuator-permitted: same gate as configs/boxturtle-h723-usb.config. This
# fragment is sim-only and is never used to flash real hardware.
CONFIG_KLIPPER_MMU_ACTUATION_OPT_IN=y

# gpio.c (sim/board/**) unconditionally implements the PWM-pair driver API
# (struct gpio_pwm_pair_info); BoxTurtle only pulls its declaration in via
# KLIPPER_MMU_BOXTURTLE_BOOT_GATES's select, and
# KLIPPER_MMU_PASSIVE_FEEDER_BOOT_GATES does not. Request it directly here
# instead -- no rewind pins are configured, so nothing actuates.
CONFIG_WANT_HARD_PWM_LOCAL_PAIR=y
CONFIG_WANT_HARD_PWM_QUERY=y
