# SPDX-License-Identifier: GPL-3.0-or-later
# Sim-only Kconfig fragment: BTT ViViD, actuation-permitted, for
# tests/linux_mcu/device_scenarios.py (see tests/linux_mcu/devices.py and
# README.md). Not a release image and not built by tests/release_matrix.
#
# BTT ViViD is a shared-drive INDEXED selector machine (selector.h): one gear
# STEP/DIR/ENABLE feeds whichever of its 4 gates the selector stepper is at,
# found by searching for that gate's own index switch -- there is no gate
# position table at all, and no grip servo (docs/devices/vivid.json
# hardware.mmu_unit unit0 selector_type "IndexedSelector", parameters
# selector_gate_order "0, 3, 1, 2", selector_endstop_width "10"). That is a
# genuinely different board wiring from every independent-feeder device this
# directory otherwise sims (BoxTurtle/NightOwl/EMU), so KLIPPER_MMU_BOARD_
# CUSTOM is required (the AFC Lite preset has no selector pins at all) and
# every pin below is this sim board's own choice for that topology
# (sim/board/plant.c's selector-mode section documents exactly which physical
# pins these reuse from the four-lane preset and why none of them collide).
# Composition: no per-gate LOAD switch or powered rewind (ViViD's traced
# Happy Hare profile has neither -- its own buffer is a switched two-pin one,
# a Happy Hare-side capability this firmware does not model as a buffer at
# all), the four per-gate BAY/entry switches the plant wires on the preset's
# own BAY pins, a shared HUB switch standing in for the family's shared gate
# sensor (mcu/Kconfig.devices: ViViD does not select KLIPPER_MMU_VIRTUAL_HUB,
# it wires no separate physical HUB pin of its own either, so this is the
# same sim-only stand-in every other selector device here already uses), and
# the four per-gate index switches KLIPPER_MMU_PINS_SELECTOR_GATE reuses from
# the now-unused four-lane LOAD preset (PE8-11 -- free here because INDEXED
# devices leave KLIPPER_MMU_LOAD_SENSORS off, same as every other selector
# kind). Same FPS-arrival DiffA/DiffB buffer setup as
# tests/linux_mcu/configs/nightowl-h723-sim-motion.config (sim-only, not a
# rendered ViViD buffer).
CONFIG_MACH_STM32=y
CONFIG_MACH_STM32H723=y
CONFIG_LOW_LEVEL_OPTIONS=y
CONFIG_STM32_CLOCK_REF_25M=y
CONFIG_STM32_FLASH_START_0000=y
CONFIG_USBSERIAL=y

CONFIG_KLIPPER_MMU=y
CONFIG_KLIPPER_MMU_DEVICE_BTT_VIVID=y
CONFIG_KLIPPER_MMU_BOARD_CUSTOM=y
CONFIG_KLIPPER_MMU_PIN_CONFIG=y
CONFIG_KLIPPER_MMU_LANE_COUNT=4

# No BOXTURTLE_BOOT_GATES/NIGHTOWL_BOOT_GATES/... entry in mcu/Kconfig
# covers BTT ViViD (or any other selector-family device) on H723+CUSTOM yet
# (mcu/Kconfig is Agent C's file, out of this fragment's reach); those
# entries only exist to `select` these two plain driver-API options
# (mcu/Kconfig.driver_api) and this local-UART binding (mcu/Kconfig.tmc),
# so setting them directly here, the same way this fragment already
# requests the PWM-pair driver API below, needs no mcu/Kconfig change.
CONFIG_WANT_GPIO_LOCAL=y
CONFIG_WANT_TMCUART_LOCAL=y
CONFIG_KLIPPER_MMU_TMC_UART_SHARED=y

# The gear: one shared driver bound to every lane (selector.h), so its
# STEP/DIR/ENABLE/UART lists hold exactly one pin, reusing the original
# lane-0 feeder pins from the four-lane preset. The electrical-level lists
# still need one entry per configured lane (mcu/feeder_config.c binds each
# lane's own candidate config, all to that one physical pin) -- all four
# identical, since there is only the one physical driver.
CONFIG_KLIPPER_MMU_PINS_STEP="PD4"
CONFIG_KLIPPER_MMU_PINS_DIR="PD3"
CONFIG_KLIPPER_MMU_PINS_ENABLE="PD6"
CONFIG_KLIPPER_MMU_PINS_UART="PD5"
CONFIG_KLIPPER_MMU_FEEDER_ENABLE_HIGH="0"
CONFIG_KLIPPER_MMU_FEEDER_STEP_HIGH="1"
CONFIG_KLIPPER_MMU_FEEDER_FORWARD_HIGH="0"
CONFIG_KLIPPER_MMU_STEP_MAX_SPEED_MM_S=200

CONFIG_KLIPPER_MMU_TMC_ADDRESSES="0"
CONFIG_KLIPPER_MMU_TMC_UART_PULLUP="1"
CONFIG_KLIPPER_MMU_TMC_RSENSE=110
CONFIG_KLIPPER_MMU_TMC_CURRENT_CEILING=800

# Selector axis: reuse three of the now-unused lane-1..3 feeder pins from
# the four-lane preset (sim/board/plant.c's own topology comment has the
# full pin list and why nothing collides). INDEXED has no separate home
# endstop pin at all (docs/selectors.md "Indexed Gates": home is gate 0's
# own index switch), so KLIPPER_MMU_PINS_SELECTOR_ENDSTOP is not set here.
CONFIG_KLIPPER_MMU_PINS_SELECTOR_STEP="PC12"
CONFIG_KLIPPER_MMU_PINS_SELECTOR_DIR="PC11"
CONFIG_KLIPPER_MMU_PINS_SELECTOR_ENABLE="PD1"
# The sim board models no selector TMC2209, so the selector stays a plain
# STEP/DIR axis here (KLIPPER_MMU_SELECTOR_UART defaults on for BTT ViViD).
# CONFIG_KLIPPER_MMU_SELECTOR_UART is not set

# Per-gate index switches (klipper_mmu/selector.h: INDEXED has no gate
# position table -- one of these per lane instead), reusing the four-lane
# preset's own now-unused LOAD pins. Active-high with a pull-up, the same
# electrical class LOAD's own catalogue-wide convention already uses (no
# device's dossier evidence covers this switch's real polarity --
# mcu/Kconfig.switch's own help text -- so this is this sim's documented
# choice, not a measurement).
CONFIG_KLIPPER_MMU_PINS_SELECTOR_GATE="PE8,PE9,PE10,PE11"
CONFIG_KLIPPER_MMU_SELECTOR_GATE_ACTIVE_HIGH="1,1,1,1"
CONFIG_KLIPPER_MMU_SELECTOR_GATE_PULL="1,1,1,1"

# Per-gate BAY/entry switches (4 of them, on the four-lane preset's own BAY
# pins) and the shared HUB switch, active-low/active-high exactly like the
# preset's own polarity.
CONFIG_KLIPPER_MMU_BAY_SENSORS=y
CONFIG_KLIPPER_MMU_PINS_BAY="PE13,PB0,PB1,PB2"
CONFIG_KLIPPER_MMU_BAY_ACTIVE_HIGH="0,0,0,0"
CONFIG_KLIPPER_MMU_BAY_PULL="1,1,1,1"
CONFIG_KLIPPER_MMU_PINS_HUB="PE12"
CONFIG_KLIPPER_MMU_HUB_ACTIVE_HIGH=1
CONFIG_KLIPPER_MMU_HUB_PULL=1

CONFIG_WANT_ADC=y
CONFIG_WANT_ADC_LOCAL=y
CONFIG_KLIPPER_MMU_DIFF_BUFFER=y
CONFIG_KLIPPER_MMU_PINS_BUFFER_A="PC4"
CONFIG_KLIPPER_MMU_PINS_BUFFER_B="PC5"
CONFIG_KLIPPER_MMU_ADC_CONVERSION_TIMEOUT_US=1000
CONFIG_KLIPPER_MMU_ADC_PAIR_SPAN_US=3000
CONFIG_KLIPPER_MMU_ADC_SAMPLE_AGE_US=20000

CONFIG_KLIPPER_MMU_BOOT_IDENTITY_H723=y
CONFIG_KLIPPER_MMU_DIAGNOSTIC_STARTUP=y
CONFIG_KLIPPER_MMU_FPS_ARRIVAL=y
# CONFIG_KLIPPER_MMU_TOOLHEAD_SENSOR is not set

# FPS arrival/LOAD profile numbers: reused from NightOwl's own fragment,
# already proven against sim/board/plant.c's short geometry
# (tests/linux_mcu/load_check.py); this device's own dossier numbers
# (docs/devices/vivid.json) are compared at the Python/phase-order level
# (tests/linux_mcu/devices.py), not by trying to make the firmware Kconfig
# reproduce Happy Hare's synthetic millimetres.
CONFIG_KLIPPER_MMU_FPS_ARRIVAL_MIN_MM=100
CONFIG_KLIPPER_MMU_FPS_ARRIVAL_MAX_MM=1900
CONFIG_KLIPPER_MMU_LOAD_CRUISE_SPEED_MM_S=200
CONFIG_KLIPPER_MMU_LOAD_CRAWL_SPEED_MM_S=20
CONFIG_KLIPPER_MMU_LOAD_WINDOW_MM=50
CONFIG_KLIPPER_MMU_BUFFER_TRAVEL_MM=15
CONFIG_KLIPPER_MMU_FEED_SPEED_MM_S=26
CONFIG_KLIPPER_MMU_RETRACT_SPEED_MM_S=26
CONFIG_KLIPPER_MMU_ACCELERATION_MM_S2=500
CONFIG_KLIPPER_MMU_DECELERATION_MM_S2=500
CONFIG_KLIPPER_MMU_UNLOAD_HUB_CLEAR_MM=65

# Actuator-permitted: same gate as configs/boxturtle-h723-usb.config. This
# fragment is sim-only and is never used to flash real hardware.
CONFIG_KLIPPER_MMU_ACTUATION_OPT_IN=y

# gpio.c (sim/board/**) unconditionally implements the PWM-pair driver API
# (struct gpio_pwm_pair_info); request it directly here like NightOwl's own
# fragment does, since no rewind pins are configured on this device either.
CONFIG_WANT_HARD_PWM_LOCAL_PAIR=y
CONFIG_WANT_HARD_PWM_QUERY=y
