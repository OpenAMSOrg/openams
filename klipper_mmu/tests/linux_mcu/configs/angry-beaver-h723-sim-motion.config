# SPDX-License-Identifier: GPL-3.0-or-later
# Sim-only Kconfig fragment: Angry Beaver, actuation-permitted, for
# tests/linux_mcu/device_scenarios.py (see tests/linux_mcu/devices.py and
# README.md). Not a release image and not built by tests/release_matrix.
#
# Angry Beaver requires manual pin configuration -- mcu/Kconfig's
# KLIPPER_MMU_PASSIVE_FEEDER_BOOT_GATES depends on KLIPPER_MMU_BOARD_CUSTOM,
# not the AFC Lite preset -- so every pin/electrical value below is the exact
# same AFC Lite/BoxTurtle bench value NightOwl/QIDI Box's own fragments next
# to this one already use. Pins are board wiring, not device behaviour
# (AGENTS.md): this sim board only ever models the one bench wiring
# tests/linux_mcu/README.md documents.
#
# Angry Beaver's own shape (docs/devices/angry_beaver.json) is neither
# NightOwl's nor QIDI Box's:
#  - No per-lane BAY or LOAD switch at all -- its traced Happy Hare profile
#    renders no per-gate entry/exit sensor (KLIPPER_MMU_BAY_SENSORS defaults
#    off for this device, mcu/Kconfig.control, citing the same dossier). A
#    lane starts the day with filament sitting at the spool, already gripped
#    by the always-engaged gear (docs/devices/angry_beaver.json "device.
#    unit_profile.filament_always_gripped": true) -- there is no BAY switch
#    to have been inserted up to, so tests/linux_mcu/device_scenarios.py
#    starts this device's lane 0 at the plant's "empty" (position 0) state
#    rather than "bay", and skips PRELOAD (km_core_request_preload requires
#    both a HUB and a BAY sensor; PRELOAD is simply unavailable on this
#    profile). sim/board/plant.c's own step-gating grip point normally sits
#    at the BAY switch's position (KM_SIM_PLANT_GRIP_UM), which would refuse
#    every step from position 0 forever on a no-BAY device; it now reads 0
#    instead whenever CONFIG_KLIPPER_MMU_BAY_SENSORS is off, matching a
#    filament_always_gripped feeder that has nothing to grip up to.
#  - A real shared HUB switch (has_hub_switch=True, same physical pin
#    NightOwl/QIDI Box use), matching the dossier's single
#    mmu_shared_exit_switch_pin serving all four gates
#    (MMU_HAS_SENSOR_SHARED_EXIT).
#  - LOAD ends on the local physical toolhead-arrival switch
#    (KLIPPER_MMU_TOOLHEAD_SENSOR, on by default without FPS arrival), not
#    Happy Hare's own open-loop steps/deadline toolhead segment (the
#    dossier's own "arrival" decision: "No toolhead endstop... driven
#    open-loop"). This firmware always has a local toolhead switch unless
#    FPS arrival replaces it, so the sim bench wires one here the same way
#    QIDI Box's fragment does, rather than reproducing Happy Hare's
#    unsensed segment.
#  - No buffer hardware at all (the dossier's own "buffer_type" decision:
#    no [mmu_buffer] section, no buffer/encoder/espooler key). This firmware
#    still requires some buffer switch input (mcu/switch_config.c has no
#    "no buffer" option), so this fragment reuses QIDI Box's already-proven
#    tension-only switch stand-in (KLIPPER_MMU_BUFFER_SINGLE_SWITCH, always
#    at rest) rather than the unimplemented plain two-switch low/high mode,
#    since neither one reflects real hardware anyway and the tension-only
#    one needs no new plant support.
CONFIG_MACH_STM32=y
CONFIG_MACH_STM32H723=y
CONFIG_LOW_LEVEL_OPTIONS=y
CONFIG_STM32_CLOCK_REF_25M=y
CONFIG_STM32_FLASH_START_0000=y
CONFIG_USBSERIAL=y

CONFIG_KLIPPER_MMU=y
CONFIG_KLIPPER_MMU_DEVICE_ANGRY_BEAVER=y
CONFIG_KLIPPER_MMU_BOARD_CUSTOM=y
CONFIG_KLIPPER_MMU_PIN_CONFIG=y

# Feeder pins/electrical: identical values to the AFC Lite preset (gear TMC
# UART stays on for this device, mcu/Kconfig.control's default).
CONFIG_KLIPPER_MMU_PINS_STEP="PD4,PC12,PE2,PD15"
CONFIG_KLIPPER_MMU_PINS_DIR="PD3,PC11,PE3,PD14"
CONFIG_KLIPPER_MMU_PINS_ENABLE="PD6,PD1,PE0,PC7"
CONFIG_KLIPPER_MMU_PINS_UART="PD5,PD0,PE1,PC6"
CONFIG_KLIPPER_MMU_FEEDER_ENABLE_HIGH="0,0,0,0"
CONFIG_KLIPPER_MMU_FEEDER_STEP_HIGH="1,1,1,1"
CONFIG_KLIPPER_MMU_FEEDER_FORWARD_HIGH="0,0,0,0"

CONFIG_KLIPPER_MMU_TMC_ADDRESSES="0,0,0,0"
CONFIG_KLIPPER_MMU_TMC_UART_PULLUP="1,1,1,1"
CONFIG_KLIPPER_MMU_TMC_RSENSE=110
CONFIG_KLIPPER_MMU_TMC_CURRENT_CEILING=800

# Presence pins: no per-lane BAY/LOAD switch (KLIPPER_MMU_BAY_SENSORS/
# LOAD_SENSORS both default off for this device); a real shared HUB switch.
CONFIG_KLIPPER_MMU_PINS_HUB="PE12"
CONFIG_KLIPPER_MMU_HUB_ACTIVE_HIGH=1
CONFIG_KLIPPER_MMU_HUB_PULL=1

# Real physical toolhead-arrival switch (sim/board/plant.c
# KM_SIM_PLANT_TOOLHEAD_PIN), active high to match the plant.
CONFIG_KLIPPER_MMU_PINS_TOOLHEAD="PE7"
CONFIG_KLIPPER_MMU_TOOLHEAD_ACTIVE_HIGH=1
CONFIG_KLIPPER_MMU_TOOLHEAD_PULL=1

# Tension-only switched buffer (sim/board/plant.c
# KM_SIM_PLANT_BUFFER_TENSION_PIN, always at rest -- this bench's short
# scenarios never run it dry), active high to match the plant. Stands in for
# hardware this device's own dossier records as absent (see header).
CONFIG_KLIPPER_MMU_BUFFER_SINGLE_SWITCH=y
CONFIG_KLIPPER_MMU_PINS_BUFFER_A="PC4"
CONFIG_KLIPPER_MMU_BUFFER_ACTIVE_HIGH="1"
CONFIG_KLIPPER_MMU_BUFFER_PULL="1"

CONFIG_KLIPPER_MMU_BOOT_IDENTITY_H723=y
CONFIG_KLIPPER_MMU_DIAGNOSTIC_STARTUP=y

# Actuator-permitted: same gate as configs/boxturtle-h723-usb.config. This
# fragment is sim-only and is never used to flash real hardware.
CONFIG_KLIPPER_MMU_ACTUATION_OPT_IN=y

# gpio.c (sim/board/**) unconditionally implements the PWM-pair driver API
# (struct gpio_pwm_pair_info); BoxTurtle only pulls its declaration in via
# KLIPPER_MMU_BOXTURTLE_BOOT_GATES's select, and
# KLIPPER_MMU_PASSIVE_FEEDER_BOOT_GATES does not. Request it directly here
# instead -- no rewind pins are configured, so nothing actuates.
CONFIG_WANT_HARD_PWM_LOCAL_PAIR=y
CONFIG_WANT_HARD_PWM_QUERY=y
