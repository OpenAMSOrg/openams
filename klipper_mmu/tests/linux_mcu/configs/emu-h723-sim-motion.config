# SPDX-License-Identifier: GPL-3.0-or-later
# Sim-only Kconfig fragment: EMU, actuation-permitted, for
# tests/linux_mcu/device_scenarios.py (see tests/linux_mcu/devices.py and
# README.md). Not a release image and not built by tests/release_matrix.
#
# Like the NightOwl fragment next to this one, EMU requires manual pin
# configuration (mcu/Kconfig's KLIPPER_MMU_EMU_BOOT_GATES depends on
# KLIPPER_MMU_BOARD_CUSTOM), so every pin/electrical value is copied in
# explicitly at the exact values the AFC Lite/BoxTurtle preset would
# otherwise default -- same bench wiring, different device composition.
#
# Composition: EMU's one physical LOAD input per lane is its own virtual
# HUB boundary -- mcu/Kconfig.devices' EMU help text: "There is no separate
# HUB pin." Accordingly this fragment sets no PINS_HUB/HUB_ACTIVE_HIGH/
# HUB_PULL at all (mcu/Kconfig.pins gates all three "depends on
# !KLIPPER_MMU_DEVICE_EMU"); devices.py's virtual_hub=True/has_hub_switch=
# False records the same fact for the Python harness. LOAD_SENSORS is
# forced on for EMU already (mcu/Kconfig.control); POWERED_REWIND is
# disallowed for EMU (also enforced by Kconfig).
#
# Lane count: EMU's real hardware is 5 lanes (docs/devices/emu.json), and
# this fragment now matches it -- sim/board/plant.c's non-selector feeder
# pin tables extend past their original four real entries (KM_MAX_LANES-
# sized, same as the selector topology's own tables), so a fifth lane
# needs no plant.c changes to add here. The host admits EMU motion only as
# its real 5-lane composition (host/__init__.py _motion_composition_matches:
# id 7 with 5 bays) -- with the 4 this fragment used to pin, the host never
# granted motion and PRELOAD could not start. Lane 4's STEP/DIR/ENABLE/BAY/
# LOAD below (PD2/PD7/PD9/PD11/PD12) match sim/board/plant.c's own extended
# tables exactly; PINS_UART's PD10 is this file's own choice (plant.c does
# not model TMC UART traffic). sim/board/tmc2209.c's fixed 4-chip model
# also needed a fifth chip (also at PD10) so lane 4's driver answers the
# boot-time TMC2209 check; without it startup faulted (-4) waiting on it.
#
# Host virtual-hub gap found and fixed alongside the above: EMU's own hub
# reading (src/operation_core.c virtual_hub_lane) is only valid once some
# lane already owns the shared path, which a fresh boot or an idle unit
# never does -- host/openams_sensor_projection.py unconditionally required
# a valid hub sample, so an idle virtual-hub unit could never prove its
# path empty and motion_available stayed False forever. Fixed by deriving
# shared-hub presence from every LOAD switch instead when the firmware's
# own new KLIPPER_MMU_CONFIG_VIRTUAL_HUB constant says so (host/__init__.py,
# host/openams_sensor_projection.py, host/session_reconciliation.py,
# host/openams_session_bootstrap.py, host/openams_device.py,
# host/openams_device_state.py; mcu/config.c exports the constant).
#
# PRELOAD, CALIBRATE, LOAD, extrude and UNLOAD now pass end to end. The last
# blocker was host-side: at a virtual-hub PRELOAD rest and past the virtual
# HUB during UNLOAD the lane's own LOAD switch reads clear, and
# host/physical_ownership.py expected it made, so every capture reconciled
# to unknown and PRELOAD's terminal was never delivered.
CONFIG_MACH_STM32=y
CONFIG_MACH_STM32H723=y
CONFIG_LOW_LEVEL_OPTIONS=y
CONFIG_STM32_CLOCK_REF_25M=y
CONFIG_STM32_FLASH_START_0000=y
CONFIG_USBSERIAL=y

CONFIG_KLIPPER_MMU=y
CONFIG_KLIPPER_MMU_DEVICE_EMU=y
CONFIG_KLIPPER_MMU_BOARD_CUSTOM=y
CONFIG_KLIPPER_MMU_PIN_CONFIG=y
CONFIG_KLIPPER_MMU_LANE_COUNT=5

# Feeder pins/electrical: AFC Lite preset for lanes 0-3, plus lane 4's own
# pins on sim/board/plant.c's extended tables (see the comment above).
CONFIG_KLIPPER_MMU_PINS_STEP="PD4,PC12,PE2,PD15,PD2"
CONFIG_KLIPPER_MMU_PINS_DIR="PD3,PC11,PE3,PD14,PD7"
CONFIG_KLIPPER_MMU_PINS_ENABLE="PD6,PD1,PE0,PC7,PD9"
CONFIG_KLIPPER_MMU_PINS_UART="PD5,PD0,PE1,PC6,PD10"
CONFIG_KLIPPER_MMU_FEEDER_ENABLE_HIGH="0,0,0,0,0"
CONFIG_KLIPPER_MMU_FEEDER_STEP_HIGH="1,1,1,1,1"
CONFIG_KLIPPER_MMU_FEEDER_FORWARD_HIGH="0,0,0,0,0"
CONFIG_KLIPPER_MMU_STEP_MAX_SPEED_MM_S=200

CONFIG_KLIPPER_MMU_TMC_ADDRESSES="0,0,0,0,0"
CONFIG_KLIPPER_MMU_TMC_UART_PULLUP="1,1,1,1,1"
CONFIG_KLIPPER_MMU_TMC_RSENSE=110
CONFIG_KLIPPER_MMU_TMC_CURRENT_CEILING=800

# Presence/buffer pins: BAY + LOAD only -- LOAD is the virtual hub.
CONFIG_KLIPPER_MMU_PINS_BAY="PE13,PB0,PB1,PB2,PD11"
CONFIG_KLIPPER_MMU_PINS_LOAD="PE8,PE9,PE10,PE11,PD12"
CONFIG_KLIPPER_MMU_BAY_ACTIVE_HIGH="0,0,0,0,0"
CONFIG_KLIPPER_MMU_BAY_PULL="1,1,1,1,1"
CONFIG_KLIPPER_MMU_LOAD_ACTIVE_HIGH="1,1,1,1,1"
CONFIG_KLIPPER_MMU_LOAD_PULL="1,1,1,1,1"

CONFIG_WANT_ADC=y
CONFIG_WANT_ADC_LOCAL=y
CONFIG_KLIPPER_MMU_DIFF_BUFFER=y
CONFIG_KLIPPER_MMU_PINS_BUFFER_A="PC4"
CONFIG_KLIPPER_MMU_PINS_BUFFER_B="PC5"
CONFIG_KLIPPER_MMU_ADC_CONVERSION_TIMEOUT_US=1000
CONFIG_KLIPPER_MMU_ADC_PAIR_SPAN_US=3000
CONFIG_KLIPPER_MMU_ADC_SAMPLE_AGE_US=20000

CONFIG_KLIPPER_MMU_BOOT_IDENTITY_H723=y
CONFIG_KLIPPER_MMU_DIAGNOSTIC_STARTUP=y
CONFIG_KLIPPER_MMU_FPS_ARRIVAL=y
# CONFIG_KLIPPER_MMU_TOOLHEAD_SENSOR is not set

# FPS arrival/LOAD profile numbers: reused from BoxTurtle's own
# device-conditioned Kconfig defaults, as with the NightOwl fragment --
# see its comment for why.
CONFIG_KLIPPER_MMU_FPS_ARRIVAL_MIN_MM=100
CONFIG_KLIPPER_MMU_FPS_ARRIVAL_MAX_MM=1900
CONFIG_KLIPPER_MMU_LOAD_CRUISE_SPEED_MM_S=200
CONFIG_KLIPPER_MMU_LOAD_CRAWL_SPEED_MM_S=20
CONFIG_KLIPPER_MMU_LOAD_WINDOW_MM=50
CONFIG_KLIPPER_MMU_BUFFER_TRAVEL_MM=15
# See the NightOwl fragment's comment: the braking-fits-the-buffer build
# check needs BoxTurtle's braking accel too, not just its speeds/distances.
CONFIG_KLIPPER_MMU_FEED_SPEED_MM_S=26
CONFIG_KLIPPER_MMU_RETRACT_SPEED_MM_S=26
CONFIG_KLIPPER_MMU_ACCELERATION_MM_S2=500
CONFIG_KLIPPER_MMU_DECELERATION_MM_S2=500
# See the NightOwl fragment's comment: 0 (the non-BoxTurtle default) left a
# full unload resting between LOAD and HUB instead of behind LOAD.
CONFIG_KLIPPER_MMU_UNLOAD_HUB_CLEAR_MM=65
# EMU-BRAKE found and fixed alongside the PRELOAD retract-and-brake bug
# (below): the calibrated HUB-to-arrival path here is 225.8 mm, so a full
# UNLOAD's own retract-to-HUB takes ~8.7 s at RETRACT_SPEED_MM_S above --
# past the non-BoxTurtle KLIPPER_MMU_RETRACT_TIMEOUT default (8000 ms), so
# the generic per-stage deadline (src/operation_core.c stage_timeout(),
# KM_STAGE_UNLOAD_RETRACT_TO_HUB) faulted every full UNLOAD with
# KM_FAULT_NO_PROGRESS before it ever reached HUB. BoxTurtle's own Bowden
# path needs the same longer timeout (90000 ms, its own Kconfig default);
# EMU's path is the same order of magnitude, so it gets that value too,
# explicitly, since EMU is not KLIPPER_MMU_DEVICE_BOXTURTLE.
CONFIG_KLIPPER_MMU_RETRACT_TIMEOUT=90000

# Actuator-permitted: same gate as configs/boxturtle-h723-usb.config. This
# fragment is sim-only and is never used to flash real hardware.
CONFIG_KLIPPER_MMU_ACTUATION_OPT_IN=y

# gpio.c (sim/board/**) unconditionally implements the PWM-pair driver API
# (struct gpio_pwm_pair_info); BoxTurtle only pulls its declaration in via
# KLIPPER_MMU_BOXTURTLE_BOOT_GATES's select. Request it directly here
# instead -- no rewind pins are configured, so nothing actuates.
CONFIG_WANT_HARD_PWM_LOCAL_PAIR=y
CONFIG_WANT_HARD_PWM_QUERY=y
