# SPDX-License-Identifier: GPL-3.0-or-later
# Sim-only Kconfig fragment: KMS, actuation-permitted, for
# tests/linux_mcu/device_scenarios.py (see tests/linux_mcu/devices.py and
# README.md). Not a release image and not built by tests/release_matrix.
#
# Like the NightOwl/EMU fragments next to this one, KMS requires manual pin
# configuration (mcu/Kconfig's KLIPPER_MMU_PASSIVE_FEEDER_BOOT_GATES depends
# on KLIPPER_MMU_BOARD_CUSTOM), so every pin/electrical value is copied in
# explicitly at the exact values the AFC Lite/BoxTurtle preset would
# otherwise default -- same bench wiring, different device composition.
#
# Composition: KMS is the same virtual-hub shape as EMU (mcu/Kconfig.devices'
# KMS help text: its traced Happy Hare profile has no separate shared HUB
# sensor, so the owning lane's own LOAD switch is the virtual hub boundary --
# KLIPPER_MMU_VIRTUAL_HUB, selected by the device choice). Unlike EMU, KMS is
# passive rewind (no PWM motor; depends on !KLIPPER_MMU_DEVICE_EMU, so KMS
# gets the plain default n) and its gear keeps its TMC UART (KLIPPER_MMU_
# GEAR_TMC_UART defaults y for every device except QIDI Box), so this
# fragment's pins match NightOwl's 4-lane STEP/DIR/ENABLE/UART set, not EMU's
# 5-lane one. LOAD_SENSORS is forced on for KMS already (mcu/Kconfig.control
# default y if KLIPPER_MMU_DEVICE_KMS); no PINS_HUB/HUB_ACTIVE_HIGH/HUB_PULL
# below, same reason as EMU's fragment (mcu/Kconfig.pins gates all three
# "depends on !KLIPPER_MMU_VIRTUAL_HUB").
#
# Buffer/arrival: docs/devices/kms.json's own "buffer_type"/"arrival"
# decisions record that KMS's traced Happy Hare profile wires a switched
# tension/compression buffer (no analog PSF section) and homes LOAD's last
# leg to a toolhead concept with no switch pin evidence at all
# (hardware.mmu_toolhead's extruder_switch_pin/toolhead_switch_pin are both
# ""). Neither a fabricated toolhead switch pin nor a fabricated analog
# calibration would have dossier evidence, so -- same as every other
# per-lane-LOAD-switch device this sim already proves (NightOwl, EMU, and
# every selector kind) -- this fragment uses the bench's own real DiffA/DiffB
# analog buffer for FPS arrival: pins are board wiring, not device behaviour
# (AGENTS.md), the sim rig only has this one bench, and mcu/config.c's
# km_config_profile() requires KLIPPER_MMU_TOOLHEAD_SENSOR or KLIPPER_MMU_
# FPS_ARRIVAL -- there is no third "no arrival sensor" build option to fall
# back to. This does not claim KMS's real hardware has an analog buffer; it
# proves phase order and rest positions on the one bench available, exactly
# as NightOwl's own fragment already does despite NightOwl also being a
# switched-buffer device (mcu/Kconfig.devices' NightOwl help text).
CONFIG_MACH_STM32=y
CONFIG_MACH_STM32H723=y
CONFIG_LOW_LEVEL_OPTIONS=y
CONFIG_STM32_CLOCK_REF_25M=y
CONFIG_STM32_FLASH_START_0000=y
CONFIG_USBSERIAL=y

CONFIG_KLIPPER_MMU=y
CONFIG_KLIPPER_MMU_DEVICE_KMS=y
CONFIG_KLIPPER_MMU_BOARD_CUSTOM=y
CONFIG_KLIPPER_MMU_PIN_CONFIG=y

# Feeder pins/electrical: identical values to the AFC Lite preset.
CONFIG_KLIPPER_MMU_PINS_STEP="PD4,PC12,PE2,PD15"
CONFIG_KLIPPER_MMU_PINS_DIR="PD3,PC11,PE3,PD14"
CONFIG_KLIPPER_MMU_PINS_ENABLE="PD6,PD1,PE0,PC7"
CONFIG_KLIPPER_MMU_PINS_UART="PD5,PD0,PE1,PC6"
CONFIG_KLIPPER_MMU_FEEDER_ENABLE_HIGH="0,0,0,0"
CONFIG_KLIPPER_MMU_FEEDER_STEP_HIGH="1,1,1,1"
CONFIG_KLIPPER_MMU_FEEDER_FORWARD_HIGH="0,0,0,0"
CONFIG_KLIPPER_MMU_STEP_MAX_SPEED_MM_S=200

CONFIG_KLIPPER_MMU_TMC_ADDRESSES="0,0,0,0"
CONFIG_KLIPPER_MMU_TMC_UART_PULLUP="1,1,1,1"
CONFIG_KLIPPER_MMU_TMC_RSENSE=110
CONFIG_KLIPPER_MMU_TMC_CURRENT_CEILING=800

# Presence/buffer pins: BAY + LOAD only -- LOAD is the virtual hub.
CONFIG_KLIPPER_MMU_PINS_BAY="PE13,PB0,PB1,PB2"
CONFIG_KLIPPER_MMU_PINS_LOAD="PE8,PE9,PE10,PE11"
CONFIG_KLIPPER_MMU_BAY_ACTIVE_HIGH="0,0,0,0"
CONFIG_KLIPPER_MMU_BAY_PULL="1,1,1,1"
CONFIG_KLIPPER_MMU_LOAD_ACTIVE_HIGH="1,1,1,1"
CONFIG_KLIPPER_MMU_LOAD_PULL="1,1,1,1"

CONFIG_WANT_ADC=y
CONFIG_WANT_ADC_LOCAL=y
CONFIG_KLIPPER_MMU_DIFF_BUFFER=y
CONFIG_KLIPPER_MMU_PINS_BUFFER_A="PC4"
CONFIG_KLIPPER_MMU_PINS_BUFFER_B="PC5"
CONFIG_KLIPPER_MMU_ADC_CONVERSION_TIMEOUT_US=1000
CONFIG_KLIPPER_MMU_ADC_PAIR_SPAN_US=3000
CONFIG_KLIPPER_MMU_ADC_SAMPLE_AGE_US=20000

CONFIG_KLIPPER_MMU_BOOT_IDENTITY_H723=y
CONFIG_KLIPPER_MMU_DIAGNOSTIC_STARTUP=y
CONFIG_KLIPPER_MMU_FPS_ARRIVAL=y
# CONFIG_KLIPPER_MMU_TOOLHEAD_SENSOR is not set

# FPS arrival/LOAD profile numbers: reused from BoxTurtle's own
# device-conditioned Kconfig defaults, same as the NightOwl/EMU fragments --
# see NightOwl's comment for why (already proven to fit sim/board/plant.c's
# geometry by tests/linux_mcu/load_check.py; KMS's own dossier numbers
# (docs/devices/kms.json) are compared at the Python/phase-order level
# instead, tests/linux_mcu/devices.py).
CONFIG_KLIPPER_MMU_FPS_ARRIVAL_MIN_MM=100
CONFIG_KLIPPER_MMU_FPS_ARRIVAL_MAX_MM=1900
CONFIG_KLIPPER_MMU_LOAD_CRUISE_SPEED_MM_S=200
CONFIG_KLIPPER_MMU_LOAD_CRAWL_SPEED_MM_S=20
CONFIG_KLIPPER_MMU_LOAD_WINDOW_MM=50
CONFIG_KLIPPER_MMU_BUFFER_TRAVEL_MM=15
# See the NightOwl fragment's comment: the braking-fits-the-buffer build
# check needs BoxTurtle's braking accel too, not just its speeds/distances.
CONFIG_KLIPPER_MMU_FEED_SPEED_MM_S=26
CONFIG_KLIPPER_MMU_RETRACT_SPEED_MM_S=26
CONFIG_KLIPPER_MMU_ACCELERATION_MM_S2=500
CONFIG_KLIPPER_MMU_DECELERATION_MM_S2=500
# See the NightOwl fragment's comment: 0 (the non-BoxTurtle default) left a
# full unload resting between LOAD and HUB instead of behind LOAD.
CONFIG_KLIPPER_MMU_UNLOAD_HUB_CLEAR_MM=65
# Same bench geometry as EMU's own fragment (this sim rig's one physical
# HUB-to-arrival distance, plant.c-fixed, not per-device): a full UNLOAD's
# retract-to-HUB leg took longer than the non-BoxTurtle KLIPPER_MMU_
# RETRACT_TIMEOUT default (8000 ms) and faulted with KM_FAULT_NO_PROGRESS
# before reaching HUB, exactly as EMU's own comment records. KMS gets the
# same BoxTurtle-order timeout, explicitly, since KMS is not KLIPPER_MMU_
# DEVICE_BOXTURTLE. (PATH-TIMEOUTS is changing mcu/Kconfig.control's stage
# timeouts and the core's timeout use elsewhere; this override stays local
# to this sim fragment, same as EMU's.)
CONFIG_KLIPPER_MMU_RETRACT_TIMEOUT=90000

# Actuator-permitted: same gate as configs/boxturtle-h723-usb.config. This
# fragment is sim-only and is never used to flash real hardware.
CONFIG_KLIPPER_MMU_ACTUATION_OPT_IN=y

# gpio.c (sim/board/**) unconditionally implements the PWM-pair driver API
# (struct gpio_pwm_pair_info); BoxTurtle only pulls its declaration in via
# KLIPPER_MMU_BOXTURTLE_BOOT_GATES's select. Request it directly here
# instead -- no rewind pins are configured, so nothing actuates.
CONFIG_WANT_HARD_PWM_LOCAL_PAIR=y
CONFIG_WANT_HARD_PWM_QUERY=y
