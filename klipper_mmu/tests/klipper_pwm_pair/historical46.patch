+#ifndef __TMCUART_H
+#define __TMCUART_H
+
+#include "autoconf.h"
+#include <stdint.h>
+#include <stddef.h>
+
+// Status codes for local TMCUART requests and callbacks
+enum {
+    TMCUART_OK = 0,
+    TMCUART_ERR_BUSY = -1,
+    TMCUART_ERR_INVAL = -2,
+    TMCUART_ERR_SHUTDOWN = -3,
+};
+
+enum {
+    TMCUART_STATUS_OK = 0,
+    TMCUART_STATUS_TIMEOUT = 1,
+};
+
+#define TMCUART_MAX_MSG_SIZE 10
+
+// Opaque struct for local channel handle.
+// Handles returned by tmcuart_local_setup are immutable and remain reserved
+// until MCU reset. Runtime slot reuse and deletion are not supported.
+struct tmcuart_local;
+
+// Callback signature for local TMCUART completion.
+// Invoked exclusively in task context with interrupts enabled.
+// - user_data: caller context pointer fixed at setup
+// - token: identity token provided at submission
+// - status: TMCUART_STATUS_OK (success) or TMCUART_STATUS_TIMEOUT (sync timeout)
+// - data: pointer to stable snapshot buffer of received UART bits (at most 10 bytes;
+//         valid throughout callback; not overwritten by new requests submitted in cb)
+// - len: length in bytes of received data
+// - completion_tick: MCU clock tick captured when engine finalized in timer ISR
+//
+// Callbacks are never invoked from timer ISR, cancellation, or shutdown.
+typedef void (*tmcuart_local_completion_fn)(void *user_data, uint32_t token,
+                                            int status, const uint8_t *data,
+                                            uint8_t len, uint32_t completion_tick);
+
+#if CONFIG_WANT_TMCUART_LOCAL
+
+// Configure a local MCU TMC UART channel.
+//
+// Contract and preconditions:
+// - Task-context API: must be entered with interrupts enabled. Entering with
+//   interrupts disabled is rejected with NULL while preserving the entry IRQ state.
+// - Pin validity, GPIO allocation, and board resource ownership are caller and
+//   board-driver preconditions; this prototype does not validate MCU pin encodings.
+// - Missing callback is rejected before claiming storage or touching GPIO.
+// - Immutable callback and user_data: the callback and context pointer supplied
+//   here are fixed for the lifetime of the channel.
+// - Arithmetic bit period bounds: bit_time must be >= 16 ticks, and
+//   (uint64_t)256 * bit_time + timer_from_us(200) must be strictly below INT32_MAX.
+//   This is an arithmetic timer bound to prevent signed 32-bit overflow, not a
+//   physical baud qualification.
+// - Configured or partially configured slots remain reserved until reset.
+// - Permanent global shutdown latch prevents setup after shutdown even across
+//   scheduler shutdown resets.
+//
+// Returns handle on success, or NULL on error (pool exhausted, invalid params,
+// missing callback, or shutdown).
+struct tmcuart_local *tmcuart_local_setup(uint32_t rx_pin, uint32_t tx_pin,
+                                          uint8_t pull_up, uint32_t bit_time,
+                                          tmcuart_local_completion_fn callback,
+                                          void *user_data);
+
+// Submit a transmission and optional reception request on a local channel.
+//
+// Contract and preconditions:
+// - Task-context API: must be entered with interrupts enabled. Entering with
+//   interrupts disabled returns TMCUART_ERR_INVAL while preserving entry IRQ state.
+// - The handle must match an allocated member of local_channels before dereference.
+// - Rejects requests if channel is busy (active timer transfer or pending completion).
+// - Rejects requests if MCU or local channel is in shutdown.
+// - Wire format: input buffer contains upstream PACKED bits, not raw TMC datagrams.
+// - Write data is copied into channel storage before timer scheduling.
+// - Reject zero-length write: write_len must be > 0 and write != NULL. Read-only
+//   submissions are not supported by the underlying bit engine.
+// - Write-only transactions (read_len == 0) are supported.
+// - Maximum write_len and read_len are TMCUART_MAX_MSG_SIZE (10 bytes).
+// - The fixed setup callback and user_data are used; no per-request callback plumbing.
+//
+// Returns TMCUART_OK on success, or negative error code:
+//   TMCUART_ERR_BUSY: channel busy (active transfer or pending completion)
+//   TMCUART_ERR_INVAL: invalid handle, IRQs disabled, NULL/zero write, or invalid len
+//   TMCUART_ERR_SHUTDOWN: MCU or channel in shutdown
+int tmcuart_local_submit(struct tmcuart_local *tl, uint32_t token,
+                         const uint8_t *write, uint8_t write_len,
+                         uint8_t read_len);
+
+// Synchronously cancel any active transfer or pending completion on the local channel.
+//
+// Contract and preconditions:
+// - Task-context API: must be entered with interrupts enabled. Entering with
+//   interrupts disabled returns TMCUART_ERR_INVAL while preserving entry IRQ state.
+// - The handle must match an allocated member of local_channels before dereference.
+// - Synchronously removes scheduled timer, restores GPIO line to idle, and discards
+//   pending completion and token bookkeeping.
+// - Does NOT invoke any completion callback.
+// - Rejects if MCU or channel is in shutdown.
+//
+// Returns TMCUART_OK on success, or negative error code:
+//   TMCUART_ERR_INVAL: invalid handle or entered with IRQs disabled
+//   TMCUART_ERR_SHUTDOWN: MCU or channel in shutdown
+int tmcuart_local_cancel(struct tmcuart_local *tl);
+
+// Check if channel is busy (active transfer or pending completion).
+// Returns 1 if busy, 0 if idle or invalid handle.
+int tmcuart_local_is_busy(const struct tmcuart_local *tl);
+
+#endif // CONFIG_WANT_TMCUART_LOCAL
+
+#endif // __TMCUART_H
