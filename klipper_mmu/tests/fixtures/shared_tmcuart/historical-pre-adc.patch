+// Optional read-only STM32 hardware PWM route query and local paired-PWM API.
+// SPDX-License-Identifier: GPL-3.0-only
+#ifndef __STM32_PWM_H
+#define __STM32_PWM_H
+#include <stdint.h>
+#include "autoconf.h"
+
+struct gpio_pwm_route {
+    // Opaque identity within this MCU build. Compare for equality; do not
+    // dereference, narrow, persist across builds or expose it as a timer number.
+    uintptr_t timer_id;
+    uint8_t channel; // 1-based channel selected by gpio_pwm_setup().
+};
+
+// Available only with CONFIG_WANT_HARD_PWM_QUERY. No I/O, allocation or claim.
+// Returns 1 on success, 0 on invalid/unsupported pin or NULL output. Failure
+// preserves *out. A route does not imply that its peripheral is available.
+int gpio_pwm_get_route(uint32_t pin, struct gpio_pwm_route *out);
+
+#if CONFIG_WANT_HARD_PWM_LOCAL_PAIR
+
+// Opaque paired PWM driver handle.
+struct gpio_pwm_pair;
+
+// Result / status codes.
+enum {
+    GPIO_PWM_PAIR_OK = 0,
+    GPIO_PWM_PAIR_ERR_INVALID = -1,        // invalid input, opposing positive duties, or direct reversal
+    GPIO_PWM_PAIR_ERR_BUSY = -2,           // capacity full or timer already claimed / active
+    GPIO_PWM_PAIR_ERR_NOT_SUPPORTED = -3,  // unsupported timer (not TIM2/3/4/5/12) or channel layout
+    GPIO_PWM_PAIR_ERR_HARDWARE = -4,       // hardware update timeout, stuck flag, or unclocked access
+    GPIO_PWM_PAIR_ERR_SHUTDOWN = -5,       // global shutdown active or emergency off latched
+};
+
+// Configuration input for local pair preparation.
+struct gpio_pwm_pair_config {
+    uint32_t forward_pin;
+    uint32_t reverse_pin;
+    uint8_t forward_active_low; // 0 = active high, 1 = active low
+    uint8_t reverse_active_low; // 0 = active high, 1 = active low
+    uint32_t cycle_time;
+    // Mandatory immutable fail-disabled path for the separate motor ENABLE.
+    // It must be safe to call with IRQs disabled; it never enables the motor.
+    void (*raw_force_off)(void *context);
+    void *raw_force_off_context;
+};
+
+// Configured timing, quantization, and status query output.
+struct gpio_pwm_pair_info {
+    uint32_t hwpwm_ticks;         // forward timer; ARR + 1
+    uint32_t prescaler;           // forward timer; PSC + 1
+    uint32_t reverse_hwpwm_ticks; // reverse timer; equals forward for same timer
+    uint32_t reverse_prescaler;
+    uint32_t confirmed_forward_val; // last acknowledged effective duty, 0..32768
+    uint32_t confirmed_reverse_val;
+    uint32_t confirmed_forward_counts; // exact acknowledged CCR counts
+    uint32_t confirmed_reverse_counts;
+    uint8_t forward_channel;
+    uint8_t reverse_channel;
+    uint8_t same_timer;
+    uint8_t is_ready;
+};
+
+// Prepare and claim a local PWM pair.
+// Validates pointers, capacity, pins, routes, timers, alias channels, periods,
+// and polarities before any hardware mutation. raw_force_off is required.
+// Once physical mutation begins, claims remain immutable even on partial
+// failure. On error, *out_pair is unchanged.
+int gpio_pwm_pair_setup(const struct gpio_pwm_pair_config *config,
+                        struct gpio_pwm_pair **out_pair);
+
+// Confirmed synchronous update of duty (0..32768, where 32768 = PWM_MAX).
+// Opposing positive duties and direct reversal are rejected. A separate
+// confirmed zero update is required before energizing the opposite direction.
+// Values are rounded down to timer counts; get_info reports effective duty.
+int gpio_pwm_pair_update(struct gpio_pwm_pair *pair,
+                         uint32_t forward_val, uint32_t reverse_val);
+
+// Immediate raw emergency disable. Invokes raw_force_off callback, stops CEN,
+// zeroes CCRs, and permanently latches pair disabled without waiting or clock reads.
+void gpio_pwm_pair_raw_disable(struct gpio_pwm_pair *pair);
+
+// Check if pair is operational (not failed, not raw-off, not in shutdown).
+int gpio_pwm_pair_is_ready(const struct gpio_pwm_pair *pair);
+
+// Query configured timing, quantization, and status.
+int gpio_pwm_pair_get_info(const struct gpio_pwm_pair *pair,
+                           struct gpio_pwm_pair_info *out_info);
+
+// Global emergency shutdown for all local PWM pairs.
+void gpio_pwm_pair_shutdown(void);
+
