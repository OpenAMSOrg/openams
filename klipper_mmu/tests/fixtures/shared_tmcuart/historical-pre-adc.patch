+int
+gpio_pwm_pair_get_info(const struct gpio_pwm_pair *pair,
+                       struct gpio_pwm_pair_info *out_info)
+{
+    irqstatus_t flag = irq_save();
+    if (!is_valid_pair_ptr(pair) || !out_info)
+    {
+        irq_restore(flag);
+        return GPIO_PWM_PAIR_ERR_INVALID;
+    }
+    out_info->hwpwm_ticks = pair->hwpwm_ticks;
+    out_info->prescaler = pair->prescaler;
+    out_info->reverse_hwpwm_ticks = pair->rev_ticks;
+    out_info->reverse_prescaler = pair->rev_prescaler;
+    out_info->confirmed_forward_val = pair_effective_val(
+        pair->confirmed_fwd_ccr, pair->hwpwm_ticks);
+    out_info->confirmed_reverse_val = pair_effective_val(
+        pair->confirmed_rev_ccr, pair->rev_ticks);
+    out_info->confirmed_forward_counts = pair->confirmed_fwd_ccr;
+    out_info->confirmed_reverse_counts = pair->confirmed_rev_ccr;
+    out_info->forward_channel = pair->fwd_channel;
+    out_info->reverse_channel = pair->rev_channel;
+    out_info->same_timer = pair->same_timer;
+    out_info->is_ready = !global_shutdown_latched && !sched_is_shutdown()
+        && !pair->raw_off && !pair->failed && pair->is_ready;
+    irq_restore(flag);
+    return GPIO_PWM_PAIR_OK;
+}
+
+void
+gpio_pwm_pair_shutdown(void)
+{
+    irqstatus_t flag = irq_save();
+    if (global_shutdown_latched) {
+        irq_restore(flag);
+        return;
+    }
+    global_shutdown_latched = 1;
+    for (int i = 0; i < GPIO_PWM_PAIR_MAX_INTERNAL; ++i) {
+        struct gpio_pwm_pair *pair = &local_pairs[i];
+        if (pair->claimed)
+            latch_pair_off(pair);
+    }
+    irq_restore(flag);
+}
+DECL_SHUTDOWN(gpio_pwm_pair_shutdown);
+
+#endif // CONFIG_WANT_HARD_PWM_LOCAL_PAIR
