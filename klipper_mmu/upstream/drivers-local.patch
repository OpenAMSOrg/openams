+
+static void
+adc_hw_from_index(uint32_t index, ADC_TypeDef **adc
+                  , ADC_Common_TypeDef **adc_common, uint32_t *chan
+                  , uint8_t *unit)
+{
+    if (index >= 2 * ADCIN_BANK_SIZE) {
+        *chan = index - 2 * ADCIN_BANK_SIZE;
+        *adc = ADC3;
+        *adc_common = ADC3_COMMON;
+        *unit = 3;
+    } else if (index >= ADCIN_BANK_SIZE) {
