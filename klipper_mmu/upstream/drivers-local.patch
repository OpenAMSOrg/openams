+
+int
+gpio_pin_is_local(uint32_t pin)
+{
+    if (!gpio_pin_present(pin))
+        return 0;
+    irqstatus_t flag = irq_save();
+    int local = gpio_owner[pin] == GPIO_OWNER_LOCAL;
+    irq_restore(flag);
+    return local;
