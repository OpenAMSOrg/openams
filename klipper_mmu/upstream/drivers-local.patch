+static void
+latch_pair_off(struct gpio_pwm_pair *pair)
+{
+    int already_off = pair->raw_off;
+    pair->raw_off = 1;
+    pair->failed = 1;
+    pair->is_ready = 0;
+    if (!already_off)
+        pair->raw_force_off(pair->raw_force_off_context);
+    // Clock flags are set only after enable_pclock returns.  A shutdown
+    // reentered from raw_force_off during setup must not touch an unclocked TIM.
+    if (pair->fwd_clocked) {
+        tim_writel(&pair->fwd_timer->CR1, tim_readl(&pair->fwd_timer->CR1) & ~TIM_CR1_CEN);
+        tim_writel(&pair->fwd_timer->CCER, tim_readl(&pair->fwd_timer->CCER)
+                   & ~(1U << ((pair->fwd_channel - 1) * 4))
+                   & ~(pair->same_timer ? (1U << ((pair->rev_channel - 1) * 4)) : 0));
+        if (pair->fwd_ccr)
+            tim_writel(pair->fwd_ccr, 0);
+        if (pair->same_timer && pair->rev_ccr)
+            tim_writel(pair->rev_ccr, 0);
+    }
+    if (!pair->same_timer && pair->rev_clocked) {
+        tim_writel(&pair->rev_timer->CR1, tim_readl(&pair->rev_timer->CR1) & ~TIM_CR1_CEN);
+        tim_writel(&pair->rev_timer->CCER, tim_readl(&pair->rev_timer->CCER)
+                   & ~(1U << ((pair->rev_channel - 1) * 4)));
+        if (pair->rev_ccr)
+            tim_writel(pair->rev_ccr, 0);
+    }
