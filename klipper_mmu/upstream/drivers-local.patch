+static int
+timer_commit_update(TIM_TypeDef *timer)
+{
+    tim_writel(&timer->SR, 0);
+    if (tim_readl(&timer->SR) & TIM_SR_UIF)
+        return -1;
+    tim_writel(&timer->EGR, TIM_EGR_UG);
+    int confirmed = 0;
+    for (int i = 0; i < 64; ++i) {
+        if (tim_readl(&timer->SR) & TIM_SR_UIF) {
+            confirmed = 1;
+            break;
+        }
+    }
+    if (!confirmed)
+        return -1;
+    tim_writel(&timer->SR, 0);
+    return 0;
+}
