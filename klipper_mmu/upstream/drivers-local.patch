+static volatile uint32_t *
+gpio_pwm_channel_ccr(TIM_TypeDef *timer, uint8_t channel)
+{
+    switch (channel) {
+    case 1: return &timer->CCR1;
+    case 2: return &timer->CCR2;
+    case 3: return &timer->CCR3;
+    case 4: return &timer->CCR4;
+    default: return NULL;
