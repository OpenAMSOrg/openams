+static void
+gpio_pwm_config_channel(TIM_TypeDef *timer, uint8_t channel, uint8_t active_low)
+{
+    // Channels 1/2 use CCMR1, 3/4 use CCMR2.  TIM12 only reaches 1/2.
+    volatile uint32_t *ccmr = channel <= 2 ? &timer->CCMR1 : &timer->CCMR2;
+    uint32_t mode_shift = (channel & 1) ? 0 : 8;
+    uint32_t ccer_shift = (channel - 1) * 4;
+    uint32_t ccer = tim_readl(&timer->CCER)
+        & ~((TIM_CCER_CC1E | TIM_CCER_CC1P) << ccer_shift);
+    tim_writel(&timer->CCER, ccer);
+    uint32_t mode = tim_readl(ccmr)
+        & ~((TIM_CCMR1_OC1M | TIM_CCMR1_CC1S) << mode_shift);
+    mode |= (TIM_CCMR1_OC1M_1 | TIM_CCMR1_OC1M_2
+             | TIM_CCMR1_OC1PE) << mode_shift;
+    tim_writel(ccmr, mode);
+    tim_writel(&timer->CCER, ccer | (TIM_CCER_CC1E << ccer_shift)
+               | (active_low ? (TIM_CCER_CC1P << ccer_shift) : 0));
+}
