+static int
+tmcuart_local_is_shutdown(void)
+{
+    if (tmcuart_local_shutdown_latched || sched_is_shutdown()) {
+        tmcuart_local_shutdown_latched = 1;
+        return 1;
+    }
+    return 0;
+}
+
+// Bounded lookup helper shared by public methods.
+// Pointer equality is verified before any member dereference.
+static struct tmcuart_local *
+tmcuart_local_lookup(const struct tmcuart_local *tl)
+{
+    if (!tl)
+        return NULL;
+    uint8_t i;
+    for (i = 0; i < ARRAY_SIZE(local_channels); i++) {
+        if (tl == &local_channels[i]) {
+            if (local_channels[i].in_use && local_channels[i].gpio_ready)
+                return &local_channels[i];
+            return NULL;
+        }
+    }
+    return NULL;
+}
+
+// Local setup checks configured ordinary UARTs and claimed local channels.
+static int
+tmcuart_local_pin_conflict(uint32_t rx_pin, uint32_t tx_pin)
+{
+    uint8_t i;
+    struct tmcuart_s *t;
+    foreach_oid(i, t, command_config_tmcuart) {
+        if (!t->pins_claimed)
+            continue;
+        if (tmcuart_pins_overlap(rx_pin, tx_pin, t->own_rx, t->own_tx))
+            return 1;
+    }
+    for (i = 0; i < ARRAY_SIZE(local_channels); i++) {
+        struct tmcuart_local *tl = &local_channels[i];
+        if (!tl->in_use)
+            continue;
+        if (tmcuart_pins_overlap(rx_pin, tx_pin,
+                                 tl->tmcuart.own_rx, tl->tmcuart.own_tx))
+            return 1;
+    }
+    return 0;
+}
+
+struct tmcuart_local *
+tmcuart_local_setup(uint32_t rx_pin, uint32_t tx_pin,
+                    uint8_t pull_up, uint32_t bit_time,
+                    tmcuart_local_completion_fn callback,
+                    void *user_data)
+{
+    // Task-context API: reject when entered with IRQs disabled, preserving state
+    irqstatus_t irq_flag = irq_save();
+    irq_restore(irq_flag);
+    if (irq_flag)
+        return NULL;
+
+    if (tmcuart_local_is_shutdown())
+        return NULL;
+
+    // Reject missing callback before claiming storage or touching GPIO
+    if (!callback)
+        return NULL;
+
+    // Validate bounded bit period before mutation using uint64_t arithmetic
+    if (bit_time < 16)
+        return NULL;
+    if ((uint64_t)256 * bit_time + timer_from_us(200) >= (uint64_t)INT32_MAX)
+        return NULL;
+
+    irqstatus_t flag = irq_save();
+    // Recheck shutdown under lock
+    if (tmcuart_local_is_shutdown()) {
+        irq_restore(flag);
+        return NULL;
+    }
+    // Read-only. Reject before a slot is consumed and before any GPIO.
+    if (tmcuart_local_pin_conflict(rx_pin, tx_pin)) {
+        irq_restore(flag);
+        return NULL;
+    }
+#if CONFIG_WANT_GPIO_LOCAL
+    // Both pins must already be reserved local (single-wire rx==tx is one pin).
+    if (!gpio_pin_is_local(rx_pin) || !gpio_pin_is_local(tx_pin)) {
+        irq_restore(flag);
+        return NULL;
+    }
+#endif
+    struct tmcuart_local *tl = NULL;
+    uint8_t i;
+    for (i = 0; i < ARRAY_SIZE(local_channels); i++) {
+        if (!local_channels[i].in_use) {
+            tl = &local_channels[i];
+            memset(tl, 0, sizeof(*tl));
+            tl->tmcuart.own_rx = rx_pin;
+            tl->tmcuart.own_tx = tx_pin;
+            tl->tmcuart.pins_claimed = 1;
+            tl->in_use = 1;
+            break;
+        }
+    }
+    irq_restore(flag);
+    if (!tl)
+        return NULL;
+
+    // GPIO setup performed with IRQs unmasked
+    tmcuart_init_channel(&tl->tmcuart, rx_pin, tx_pin, pull_up, bit_time, TU_LOCAL);
+
+    flag = irq_save();
+    // Observe shutdown occurring during GPIO setup before publishing handle
+    if (tmcuart_local_is_shutdown() || tl->is_shutdown) {
+        tmcuart_reset_line(&tl->tmcuart);
+        tl->is_shutdown = 1;
+        irq_restore(flag);
+        return NULL;
+    }
+    tl->gpio_ready = 1;
+    tl->callback = callback;
+    tl->user_data = user_data;
+    irq_restore(flag);
+
+    return tl;
+}
+
+int
+tmcuart_local_submit(struct tmcuart_local *tl, uint32_t token,
+                     const uint8_t *write, uint8_t write_len,
+                     uint8_t read_len)
+{
+    // Task-context API: reject when entered with IRQs disabled, preserving state
+    irqstatus_t irq_flag = irq_save();
+    irq_restore(irq_flag);
+    if (irq_flag)
+        return TMCUART_ERR_INVAL;
+
+    // Handle must match an allocated member of local_channels before dereference
+    struct tmcuart_local *chan = tmcuart_local_lookup(tl);
+    if (!chan)
+        return TMCUART_ERR_INVAL;
+
+    if (tmcuart_local_is_shutdown() || chan->is_shutdown)
+        return TMCUART_ERR_SHUTDOWN;
+
+    // Reject zero-length write (read-only submission not supported by engine)
+    if (write_len == 0 || !write)
+        return TMCUART_ERR_INVAL;
+    if (write_len > sizeof(chan->tmcuart.data) || read_len > sizeof(chan->tmcuart.data))
+        return TMCUART_ERR_INVAL;
+
+    irqstatus_t flag = irq_save();
+    // Recheck shutdown under lock
+    if (tmcuart_local_is_shutdown() || chan->is_shutdown) {
+        irq_restore(flag);
+        return TMCUART_ERR_SHUTDOWN;
+    }
+
+    // Retain busy rejection during both active and pending completion
+    if ((chan->tmcuart.flags & TU_ACTIVE) || chan->pending_completion) {
+        irq_restore(flag);
+        return TMCUART_ERR_BUSY;
+    }
+
+    chan->token = token;
+    chan->requested_read_len = read_len;
+    chan->completion_status = 0;
+    chan->completion_len = 0;
+    chan->completion_tick = 0;
+
+    tmcuart_submit_transfer(&chan->tmcuart, write, write_len, read_len);
+    irq_restore(flag);
+
+    return TMCUART_OK;
+}
+
+int
+tmcuart_local_cancel(struct tmcuart_local *tl)
+{
+    // Task-context API: reject when entered with IRQs disabled, preserving state
+    irqstatus_t irq_flag = irq_save();
+    irq_restore(irq_flag);
+    if (irq_flag)
+        return TMCUART_ERR_INVAL;
+
+    // Handle must match an allocated member of local_channels before dereference
+    struct tmcuart_local *chan = tmcuart_local_lookup(tl);
+    if (!chan)
+        return TMCUART_ERR_INVAL;
+
+    if (tmcuart_local_is_shutdown() || chan->is_shutdown)
+        return TMCUART_ERR_SHUTDOWN;
+
+    irqstatus_t flag = irq_save();
+    // Recheck shutdown under lock
+    if (tmcuart_local_is_shutdown() || chan->is_shutdown) {
+        irq_restore(flag);
+        return TMCUART_ERR_SHUTDOWN;
+    }
+
+    if (chan->tmcuart.flags & TU_ACTIVE) {
+        sched_del_timer(&chan->tmcuart.timer);
+        tmcuart_reset_line(&chan->tmcuart);
+    }
+    chan->pending_completion = 0;
+    chan->token = 0;
+    irq_restore(flag);
+
+    return TMCUART_OK;
+}
+
+int
+tmcuart_local_is_busy(const struct tmcuart_local *tl)
+{
+    struct tmcuart_local *chan = tmcuart_local_lookup(tl);
+    if (!chan)
+        return 0;
+    irqstatus_t flag = irq_save();
+    int busy = (chan->tmcuart.flags & TU_ACTIVE) || chan->pending_completion;
+    irq_restore(flag);
+    return busy;
+}
+
+void
+tmcuart_local_task(void)
+{
+    if (!sched_check_wake(&tmcuart_local_wake))
+        return;
+    uint8_t i;
+    for (i = 0; i < ARRAY_SIZE(local_channels); i++) {
+        struct tmcuart_local *tl = &local_channels[i];
+        irqstatus_t flag = irq_save();
+        if (!tl->in_use || !tl->gpio_ready || !tl->pending_completion) {
+            irq_restore(flag);
+            continue;
+        }
+        if (tmcuart_local_is_shutdown() || tl->is_shutdown) {
+            tl->pending_completion = 0;
+            irq_restore(flag);
+            continue;
+        }
+
+        uint32_t token = tl->token;
+        int status = tl->completion_status;
+        uint8_t len = tl->completion_len;
+        if (len > TMCUART_MAX_MSG_SIZE)
+            len = TMCUART_MAX_MSG_SIZE;
+        uint32_t completion_tick = tl->completion_tick;
+        uint8_t data[TMCUART_MAX_MSG_SIZE];
+        memcpy(data, tl->tmcuart.data, len);
+
+        tmcuart_local_completion_fn cb = tl->callback;
+        void *user_data = tl->user_data;
+
+        // Clear old pending bookkeeping BEFORE invoking fixed callback
+        tl->pending_completion = 0;
+        tl->token = 0;
+        tl->completion_status = 0;
+        tl->completion_len = 0;
+        tl->completion_tick = 0;
+        irq_restore(flag);
+
+        if (cb)
+            cb(user_data, token, status, data, len, completion_tick);
+    }
+}
+DECL_TASK(tmcuart_local_task);
+
+static void
+tmcuart_local_shutdown(void)
+{
+    tmcuart_local_shutdown_latched = 1;
+    uint8_t i;
+    for (i = 0; i < ARRAY_SIZE(local_channels); i++) {
+        struct tmcuart_local *tl = &local_channels[i];
+        if (!tl->in_use)
+            continue;
+        irqstatus_t flag = irq_save();
+        if (tl->gpio_ready) {
+            if (tl->tmcuart.flags & TU_ACTIVE) {
+                sched_del_timer(&tl->tmcuart.timer);
+            }
+            tmcuart_reset_line(&tl->tmcuart);
+        }
+        tl->pending_completion = 0;
+        tl->token = 0;
+        tl->is_shutdown = 1;
+        irq_restore(flag);
+    }
+}
