+    if (!pins || !count || count > max_count)
+        return GPIO_LOCAL_ERR_INVALID;
+    uint8_t seen[ARRAY_SIZE(digital_regs) * 16];
+    memset(seen, 0, sizeof(seen));
+    irqstatus_t flag = irq_save();
+    for (uint32_t i = 0; i < count; ++i) {
+        uint32_t pin = pins[i];
+        if (!gpio_pin_present(pin) || seen[pin]) {
+            irq_restore(flag);
+            return GPIO_LOCAL_ERR_INVALID;
+        }
+        seen[pin] = 1;
+    }
+    if (gpio_local_closed || sched_is_shutdown()) {
+        irq_restore(flag);
+        return GPIO_LOCAL_ERR_SHUTDOWN;
