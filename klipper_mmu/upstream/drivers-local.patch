+        latch_pair_off(pair);
+        irq_restore(flag);
+        return GPIO_PWM_PAIR_ERR_HARDWARE;
+    }
+    if (!pair->same_timer) {
+        if (timer_commit_update(pair->rev_timer) != 0) {
+            latch_pair_off(pair);
+            irq_restore(flag);
+            return GPIO_PWM_PAIR_ERR_HARDWARE;
+        }
+    }
+
+    if (global_shutdown_latched || sched_is_shutdown() || pair->raw_off) {
+        latch_pair_off(pair);
+        irq_restore(flag);
+        return GPIO_PWM_PAIR_ERR_SHUTDOWN;
+    }
+
+    tim_writel(&pair->fwd_timer->CR1, tim_readl(&pair->fwd_timer->CR1) | TIM_CR1_CEN);
+    if (!pair->same_timer) {
+        tim_writel(&pair->rev_timer->CR1, tim_readl(&pair->rev_timer->CR1) | TIM_CR1_CEN);
+    }
+
+    if (global_shutdown_latched || sched_is_shutdown() || pair->raw_off) {
+        latch_pair_off(pair);
+        irq_restore(flag);
+        return GPIO_PWM_PAIR_ERR_SHUTDOWN;
+    }
+
+#if CONFIG_WANT_GPIO_LOCAL
+    gpio_peripheral_local(pair->fwd_pin, pair->fwd_function, 0);
+#else
+    gpio_peripheral(pair->fwd_pin, pair->fwd_function, 0);
+#endif
+    if (global_shutdown_latched || sched_is_shutdown() || pair->raw_off) {
+        latch_pair_off(pair);
+        irq_restore(flag);
+        return GPIO_PWM_PAIR_ERR_SHUTDOWN;
+    }
+#if CONFIG_WANT_GPIO_LOCAL
+    gpio_peripheral_local(pair->rev_pin, pair->rev_function, 0);
+#else
+    gpio_peripheral(pair->rev_pin, pair->rev_function, 0);
+#endif
+    if (global_shutdown_latched || sched_is_shutdown() || pair->raw_off) {
+        latch_pair_off(pair);
+        irq_restore(flag);
+        return GPIO_PWM_PAIR_ERR_SHUTDOWN;
+    }
+
+    pair->is_ready = 1;
+    *out_pair = pair;
+    irq_restore(flag);
+    return GPIO_PWM_PAIR_OK;
+}
+
+int
+gpio_pwm_pair_update(struct gpio_pwm_pair *pair,
+                     uint32_t forward_val, uint32_t reverse_val)
+{
+    if (!is_valid_pair_ptr(pair) || forward_val > MAX_PWM
+        || reverse_val > MAX_PWM || (forward_val && reverse_val))
+        return GPIO_PWM_PAIR_ERR_INVALID;
+
+    irqstatus_t flag = irq_save();
+    if (global_shutdown_latched || sched_is_shutdown() || pair->raw_off) {
+        irq_restore(flag);
+        return GPIO_PWM_PAIR_ERR_SHUTDOWN;
+    }
+    if (pair->failed || !pair->is_ready) {
+        irq_restore(flag);
+        return GPIO_PWM_PAIR_ERR_HARDWARE;
+    }
+    // Policy deadtime belongs to the portable consumer.  Require a separate
+    // acknowledged zero before either direction may become positive.
+    if ((pair->confirmed_fwd_ccr && reverse_val)
+        || (pair->confirmed_rev_ccr && forward_val)) {
+        irq_restore(flag);
+        return GPIO_PWM_PAIR_ERR_INVALID;
+    }
+
+    uint32_t f_ccr = pair_ccr(forward_val, pair->hwpwm_ticks);
+    uint32_t r_ccr = pair_ccr(reverse_val, pair->rev_ticks);
+    int f_change = f_ccr != pair->confirmed_fwd_ccr;
+    int r_change = r_ccr != pair->confirmed_rev_ccr;
+    if (!f_change && !r_change) {
+        irq_restore(flag);
+        return GPIO_PWM_PAIR_OK;
+    }
+
+    if (f_change)
+        tim_writel(pair->fwd_ccr, f_ccr);
+    if (global_shutdown_latched || pair->raw_off)
+        goto update_shutdown;
+    if (r_change)
+        tim_writel(pair->rev_ccr, r_ccr);
+    if (global_shutdown_latched || pair->raw_off)
+        goto update_shutdown;
+    if ((f_change || (r_change && pair->same_timer))
+        && timer_commit_update(pair->fwd_timer))
+        goto update_hardware_error;
+    if (global_shutdown_latched || pair->raw_off)
+        goto update_shutdown;
+    if (r_change && !pair->same_timer
+        && timer_commit_update(pair->rev_timer))
+        goto update_hardware_error;
+    if (global_shutdown_latched || pair->raw_off)
+        goto update_shutdown;
+
+    pair->confirmed_fwd_ccr = f_ccr;
+    pair->confirmed_rev_ccr = r_ccr;
+    irq_restore(flag);
+    return GPIO_PWM_PAIR_OK;
+
+update_hardware_error:
+    latch_pair_off(pair);
+    irq_restore(flag);
+    return GPIO_PWM_PAIR_ERR_HARDWARE;
+update_shutdown:
+    latch_pair_off(pair);
+    irq_restore(flag);
+    return GPIO_PWM_PAIR_ERR_SHUTDOWN;
+}
+
+void
+gpio_pwm_pair_raw_disable(struct gpio_pwm_pair *pair)
+{
+    if (!is_valid_pair_ptr(pair))
+        return;
+    irqstatus_t flag = irq_save();
+    latch_pair_off(pair);
+    irq_restore(flag);
+}
+
+int
+gpio_pwm_pair_is_ready(const struct gpio_pwm_pair *pair)
+{
+    irqstatus_t flag = irq_save();
+    if (!is_valid_pair_ptr(pair))
+    {
+        irq_restore(flag);
+        return 0;
+    }
+    int ready = !global_shutdown_latched && !sched_is_shutdown()
+        && !pair->raw_off && !pair->failed && pair->is_ready;
+    irq_restore(flag);
+    return ready;
+}
+
+int
+gpio_pwm_pair_get_info(const struct gpio_pwm_pair *pair,
+                       struct gpio_pwm_pair_info *out_info)
+{
+    irqstatus_t flag = irq_save();
+    if (!is_valid_pair_ptr(pair) || !out_info)
+    {
+        irq_restore(flag);
+        return GPIO_PWM_PAIR_ERR_INVALID;
+    }
+    out_info->hwpwm_ticks = pair->hwpwm_ticks;
+    out_info->prescaler = pair->prescaler;
+    out_info->reverse_hwpwm_ticks = pair->rev_ticks;
+    out_info->reverse_prescaler = pair->rev_prescaler;
+    out_info->confirmed_forward_val = pair_effective_val(
+        pair->confirmed_fwd_ccr, pair->hwpwm_ticks);
+    out_info->confirmed_reverse_val = pair_effective_val(
+        pair->confirmed_rev_ccr, pair->rev_ticks);
+    out_info->confirmed_forward_counts = pair->confirmed_fwd_ccr;
+    out_info->confirmed_reverse_counts = pair->confirmed_rev_ccr;
+    out_info->forward_channel = pair->fwd_channel;
+    out_info->reverse_channel = pair->rev_channel;
+    out_info->same_timer = pair->same_timer;
+    out_info->is_ready = !global_shutdown_latched && !sched_is_shutdown()
+        && !pair->raw_off && !pair->failed && pair->is_ready;
+    irq_restore(flag);
+    return GPIO_PWM_PAIR_OK;
+}
+
+void
+gpio_pwm_pair_shutdown(void)
+{
+    irqstatus_t flag = irq_save();
+    if (global_shutdown_latched) {
+        irq_restore(flag);
+        return;
+    }
+    global_shutdown_latched = 1;
+    for (int i = 0; i < GPIO_PWM_PAIR_MAX_INTERNAL; ++i) {
+        struct gpio_pwm_pair *pair = &local_pairs[i];
+        if (pair->claimed)
+            latch_pair_off(pair);
+    }
+    irq_restore(flag);
+}
+DECL_SHUTDOWN(gpio_pwm_pair_shutdown);
