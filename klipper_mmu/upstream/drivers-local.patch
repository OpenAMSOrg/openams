+
+void
+gpio_claim_ordinary(uint32_t pin)
+{
+    irqstatus_t flag = irq_save();
+    if (!gpio_pin_present(pin)) {
+        irq_restore(flag);
+        shutdown("Not a valid pin");
+    }
+    if (gpio_owner[pin] == GPIO_OWNER_LOCAL) {
+        irq_restore(flag);
+        shutdown("Pin reserved local");
+    }
+    gpio_owner[pin] = GPIO_OWNER_ORDINARY;
+    irq_restore(flag);
+}
+
+void
+gpio_require_local(uint32_t pin)
+{
+    irqstatus_t flag = irq_save();
+    int ok = gpio_pin_present(pin) && gpio_owner[pin] == GPIO_OWNER_LOCAL;
+    irq_restore(flag);
+    if (!ok)
+        shutdown("Pin not reserved local");
