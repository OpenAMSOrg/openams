+        || max_moves > CONFIG_STEPPER_LOCAL_MOVES)
+        shutdown("No local stepper storage");
+    struct stepper_local *ls = &stepper_local_store[stepper_local_used++];
+    struct stepper *s = &ls->s;
+    if (invert_step > 0)
+        s->flags = SF_INVERT_STEP;
+    else if (invert_step < 0)
+        s->flags = SF_SINGLE_SCHED;
+    s->flags |= SF_LOCAL;
+    s->step_pin = step_pin;
+    s->dir_pin = dir_pin;
+    s->position = -POSITION_BIAS;
+    s->step_pulse_ticks = step_pulse_ticks;
+    // No move_queue_setup: it sizes the shared move pool and shuts down once
+    // the config is finalized. The queue uses the private pool below; static
+    // storage starts zeroed.
+    ls->next = stepper_local_list;
+    stepper_local_list = ls;
+    uint8_t i;
+    for (i = 0; i < max_moves; i++) {
+        ls->pool[i].node.next = ls->free;
+        ls->free = &ls->pool[i].node;
+        ls->free_count++;
+    }
+    if (HAVE_EDGE_OPTIMIZATION) {
+        if (invert_step < 0 && s->step_pulse_ticks <= EDGE_STEP_TICKS)
+            s->flags |= SF_OPTIMIZED_PATH;
+        else
+            s->time.func = stepper_event_full;
+    } else if (HAVE_AVR_OPTIMIZATION) {
+        if (invert_step >= 0 && s->step_pulse_ticks <= AVR_STEP_TICKS)
+            s->flags |= SF_SINGLE_SCHED | SF_OPTIMIZED_PATH;
+        else
