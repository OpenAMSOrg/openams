+/* Shared structural pair check. No clocks, registers, IRQs, callbacks, or claims. */
+static int
+gpio_pwm_pair_check_pins(uint32_t forward_pin, uint32_t reverse_pin,
+                         const struct gpio_pwm_info **forward,
+                         const struct gpio_pwm_info **reverse)
+{
+    if (forward_pin == reverse_pin || forward_pin > 0xFF || reverse_pin > 0xFF)
+        return GPIO_PWM_PAIR_ERR_INVALID;
+    const struct gpio_pwm_info *fwd = gpio_pwm_find(forward_pin);
+    const struct gpio_pwm_info *rev = gpio_pwm_find(reverse_pin);
+    if (!fwd || !rev)
+        return GPIO_PWM_PAIR_ERR_INVALID;
+    if (!is_supported_timer(fwd->timer) || !is_supported_timer(rev->timer))
+        return GPIO_PWM_PAIR_ERR_NOT_SUPPORTED;
+    if (fwd->timer == rev->timer && fwd->channel == rev->channel)
+        return GPIO_PWM_PAIR_ERR_INVALID;
+    if ((fwd->timer == TIM12 && fwd->channel > 2)
+        || (rev->timer == TIM12 && rev->channel > 2))
+        return GPIO_PWM_PAIR_ERR_NOT_SUPPORTED;
+    if (forward)
+        *forward = fwd;
+    if (reverse)
+        *reverse = rev;
+    return GPIO_PWM_PAIR_OK;
