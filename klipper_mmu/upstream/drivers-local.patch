+// The local API never rounds duty above the requested value.  In particular,
+// a small period must not turn a sub-tick request into a larger pulse.
+static uint32_t
+pair_ccr(uint32_t val, uint32_t ticks)
+{
+    return (uint32_t)(((uint64_t)val * ticks) / MAX_PWM);
+}
+
+static uint32_t
+pair_effective_val(uint32_t ccr, uint32_t ticks)
+{
+    return (uint32_t)(((uint64_t)ccr * MAX_PWM) / ticks);
+}
