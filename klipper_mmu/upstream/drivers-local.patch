+#ifndef __TMCUART_H
+#define __TMCUART_H
+
+#include "autoconf.h"
+#include <stdint.h>
+#include <stddef.h>
+
+// Status codes for local TMCUART requests and callbacks
+enum {
+    TMCUART_OK = 0,
+    TMCUART_ERR_BUSY = -1,
+    TMCUART_ERR_INVAL = -2,
+    TMCUART_ERR_SHUTDOWN = -3,
+};
+
+enum {
+    TMCUART_STATUS_OK = 0,
+    TMCUART_STATUS_TIMEOUT = 1,
+};
+
+#define TMCUART_MAX_MSG_SIZE 10
+
+// Opaque struct for local channel handle.
+// Handles returned by tmcuart_local_setup are immutable and remain reserved
+// until MCU reset. Runtime slot reuse and deletion are not supported.
+struct tmcuart_local;
+
+// Callback signature for local TMCUART completion.
+// Invoked exclusively in task context with interrupts enabled.
+// - user_data: caller context pointer fixed at setup
+// - token: identity token provided at submission
+// - status: TMCUART_STATUS_OK (success) or TMCUART_STATUS_TIMEOUT (sync timeout)
+// - data: pointer to stable snapshot buffer of received UART bits (at most 10 bytes;
+//         valid throughout callback; not overwritten by new requests submitted in cb)
+// - len: length in bytes of received data
+// - completion_tick: MCU clock tick captured when engine finalized in timer ISR
+//
+// Callbacks are never invoked from timer ISR, cancellation, or shutdown.
+typedef void (*tmcuart_local_completion_fn)(void *user_data, uint32_t token,
+                                            int status, const uint8_t *data,
+                                            uint8_t len, uint32_t completion_tick);
+
+#if CONFIG_WANT_TMCUART_LOCAL
+
+// Configure a local MCU TMC UART channel.
+//
+// Contract and preconditions:
+// - Task-context API: must be entered with interrupts enabled. Entering with
+//   interrupts disabled is rejected with NULL while preserving the entry IRQ state.
+// - Pin validity, GPIO allocation, and board resource ownership against
+//   unrelated digital, ADC, or PWM users remain caller and board-driver
+//   preconditions even when pins are checked. This is not a general GPIO
+//   registry and does not validate MCU pin encodings. A complete caller
+//   resource plan is still required. This does not complete automatic MMU
+//   startup, command attachment, or hardware qualification (ACTUATION stays 0).
+// - WANT_GPIO_LOCAL is optional, independent of WANT_TMCUART_LOCAL, and
+//   currently H723 only. It adds no mandatory GPIO feature on other MCUs.
+//   When it is enabled, both rx_pin and tx_pin must already be boot-lifetime
+//   local claims acquired outside this call, before a UART slot is allocated
+//   or GPIO is touched. gpio_pin_is_local is a public pure query and does not
+//   reserve or release. This function does not reserve its own pins. A missing,
+//   ordinary, or invalid claim returns NULL. rx_pin == tx_pin (single-wire) is
+//   valid when that pin is already local. When WANT_GPIO_LOCAL is off, there
+//   is no generic GPIO enforcement: prior pin and resource caller preconditions
+//   and the UART-level ownership below still apply.
+// - UART-level exclusion: NULL when the requested RX or TX pin shares a full
+//   uint32_t identity with either pin of a configured ordinary config_tmcuart
+//   channel or any previously claimed local channel. Direction, single-wire
+//   versus two-wire, active, idle, pending, and cancelled state, and differing
+//   bit_time or pull_up do not matter. Ordinary channels may still share pins
+//   with other ordinary channels. A conflict does no GPIO, timer, or callback
+//   work and does not consume a local slot. A retained local claim, including
+//   after partial setup, cancellation, or shutdown, still conflicts.
+// - Missing callback is rejected before claiming storage or touching GPIO.
