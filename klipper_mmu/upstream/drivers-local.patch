+    uint32_t prescaler;           // forward timer; PSC + 1
+    uint32_t reverse_hwpwm_ticks; // reverse timer; equals forward for same timer
+    uint32_t reverse_prescaler;
+    uint32_t confirmed_forward_val; // last acknowledged effective duty, 0..32768
+    uint32_t confirmed_reverse_val;
+    uint32_t confirmed_forward_counts; // exact acknowledged CCR counts
+    uint32_t confirmed_reverse_counts;
+    uint8_t forward_channel;
+    uint8_t reverse_channel;
+    uint8_t same_timer;
+    uint8_t is_ready;
+};
+
+// Prepare and claim a local PWM pair. Does not reserve GPIO pins.
+// Validates pointers, capacity, pins, routes, timers, alias channels, periods,
+// and polarities before any hardware mutation. raw_force_off is required.
+// With CONFIG_WANT_GPIO_LOCAL, both pins must already be reserved local;
+// otherwise BUSY, with no slot, timer, callback, or I/O. Shutdown takes
+// precedence. Caller claims are retained; there is no release API. Once
+// physical mutation begins, pair claims remain immutable even on partial
+// failure. On error, *out_pair is unchanged.
+int gpio_pwm_pair_setup(const struct gpio_pwm_pair_config *config,
+                        struct gpio_pwm_pair **out_pair);
+
+// Confirmed synchronous update of duty (0..32768, where 32768 = PWM_MAX).
+// Opposing positive duties and direct reversal are rejected. A separate
+// confirmed zero update is required before energizing the opposite direction.
+// Values are rounded down to timer counts; get_info reports effective duty.
+int gpio_pwm_pair_update(struct gpio_pwm_pair *pair,
+                         uint32_t forward_val, uint32_t reverse_val);
+
+// Immediate raw emergency disable. Invokes raw_force_off callback, stops CEN,
+// zeroes CCRs, and permanently latches pair disabled without waiting or clock reads.
+void gpio_pwm_pair_raw_disable(struct gpio_pwm_pair *pair);
+
+// Check if pair is operational (not failed, not raw-off, not in shutdown).
+int gpio_pwm_pair_is_ready(const struct gpio_pwm_pair *pair);
+
+// Query configured timing, quantization, and status.
+int gpio_pwm_pair_get_info(const struct gpio_pwm_pair *pair,
+                           struct gpio_pwm_pair_info *out_info);
+
+// Global emergency shutdown for all local PWM pairs.
+void gpio_pwm_pair_shutdown(void);
