+    for (uint32_t i = 0; i < count; ++i)
+        if (gpio_owner[pins[i]] != GPIO_OWNER_UNCLAIMED) {
+            irq_restore(flag);
+            return GPIO_LOCAL_ERR_BUSY;
+        }
+    for (uint32_t i = 0; i < count; ++i)
+        gpio_owner[pins[i]] = GPIO_OWNER_LOCAL;
+    irq_restore(flag);
+    return GPIO_LOCAL_OK;
