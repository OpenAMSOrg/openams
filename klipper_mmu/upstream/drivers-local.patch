+// Queue one step move on a local stepper.  Returns nonzero and queues nothing
+// (without shutting the MCU down) when the private pool is empty, when the
+// move has no steps, or when an idle stepper is given a start clock that is
+// not far enough ahead to permit a clean step pulse.
+int
+stepper_local_queue(struct stepper *s, uint32_t start_clock, uint32_t interval,
+                    uint16_t count, int16_t add, uint8_t dir)
+{
+    if (!count)
+        return -1;
+    struct stepper_local *ls = container_of(s, struct stepper_local, s);
+    irq_disable();
+    if (!ls->free_count
+        || (!s->count && timer_is_before(start_clock, timer_read_time()
+                                         + timer_from_us(STEPPER_LOCAL_MIN_LEAD_US)))) {
+        irq_enable();
+        return -1;
+    }
+    if (!s->count) {
+        // Idle: this move sets a fresh clock, as reset_step_clock does
+        s->flags &= ~SF_NEED_RESET;
+        s->next_step_time = s->time.waketime = start_clock;
+    }
+    s->flags = (s->flags & ~SF_NEXT_DIR) | (dir ? SF_NEXT_DIR : 0);
+    struct stepper_move *m = container_of(ls->free, struct stepper_move, node);
+    ls->free = ls->free->next;
+    ls->free_count--;
+    m->interval = interval;
+    m->count = count;
+    m->add = add;
+    m->flags = 0;
+    uint8_t flags = s->flags;
+    if (!!(flags & SF_LAST_DIR) != !!(flags & SF_NEXT_DIR)) {
+        flags ^= SF_LAST_DIR;
+        m->flags |= MF_DIR;
+    }
+    s->flags = flags;
+    move_queue_push(&m->node, &s->mq);
+    if (!s->count) {
+        stepper_load_next(s);
+        sched_add_timer(&s->time);
+    }
+    irq_enable();
+    return 0;
+}
+
+// Report how many moves the private pool can still take, so a caller can
+// queue a whole batch or nothing
+int
+stepper_local_room(struct stepper *s)
+{
+    return container_of(s, struct stepper_local, s)->free_count;
+}
+
+// Report the completed step position of a local stepper
+int32_t
+stepper_local_position(struct stepper *s)
+{
+    irq_disable();
+    int32_t position = (int32_t)(stepper_get_position(s) - POSITION_BIAS);
+    irq_enable();
+    return position;
+}
+
+// Report whether a local stepper still has steps queued (on the fully
+// scheduled path this includes the trailing unstep of the last step)
+int
+stepper_local_active(struct stepper *s)
+{
+    return !!s->count;
+}
+
+// Stop a local stepper: timer off, queue emptied into the private pool, and
+// on the fully scheduled path the step pin back to "unstep" (the both-edge
+// path has no unstep level). The next queued move needs a new start clock.
+void
+stepper_local_stop(struct stepper *s)
+{
+    irq_disable();
+    stepper_stop(&s->stop_signal, 0);
+    irq_enable();
+}
+
+// Shutdown hook: stepper_shutdown() only walks host-configured (oid) steppers
+void
+stepper_local_shutdown(void)
+{
+    struct stepper_local *ls;
+    for (ls = stepper_local_list; ls; ls = ls->next)
+        stepper_stop(&ls->s.stop_signal, 0);
+}
+DECL_SHUTDOWN(stepper_local_shutdown);
