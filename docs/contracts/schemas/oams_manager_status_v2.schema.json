        },
        "spool_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "description": "NEW-v2 (D2, H3). Spoolman spool id."
        },
        "link_source": {
          "enum": [
            "tag",
            "manual",
            "none"
          ],
          "description": "NEW-v2 (D2, H3)."
        },
        "tag": {
          "description": "NEW-v2 (H1; decode exists for AMS 1, bambu_lab_tag_processor.py). The last successful read; null when no tag.",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "uid",
                "format",
                "read_at",
                "spoolman_id",
                "bambu"
              ],
              "allOf": [
                {"if": {"properties": {"format": {"const": "unit_summary"}}},
                 "then": {"required": ["summary"], "properties": {"uid": {"type": "null"}, "bambu": {"type": "null"}}},
                 "else": {"not": {"required": ["summary"]}, "properties": {"uid": {"type": "string"}}}}
              ],
              "properties": {
                "uid": {
                  "type": ["string", "null"],
                  "pattern": "^[0-9a-f]{8,20}$",
                  "description": "Lowercase hex, as the readers publish it (mfrc522.py:476, oams.py:2159-2160). null exactly for format unit_summary: a unit that decodes its own tags reports no UID."
                },
                "format": {
                  "enum": [
                    "bambu",
                    "spoolman_link",
                    "openspool",
                    "unit_summary",
                    "unknown"
                  ]
                },
                "summary": {
                  "description": "A tag decoded by the unit itself (C1 section 4.7.1): present exactly for format unit_summary.",
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["code", "material", "color_argb", "nozzle_min_c", "nozzle_max_c", "manufacturer"],
                  "properties": {
                    "code": {"type": ["string", "null"], "description": "The manufacturer's filament code, e.g. a Bambu code GFB60."},
                    "material": {"type": ["string", "null"], "description": "The material name, e.g. ABS."},
                    "color_argb": {"type": ["integer", "null"], "minimum": 0, "maximum": 4294967295, "description": "0xAARRGGBB, like bambu.color_argb; null when the unit reported no colour."},
                    "nozzle_min_c": {"type": ["integer", "null"], "minimum": 1},
                    "nozzle_max_c": {"type": ["integer", "null"], "minimum": 1},
                    "manufacturer": {"enum": ["Bambu", null], "description": "Bambu when code starts with GF, as Bambu filament codes do; else null."}
                  }
                },
                "read_at": {
                  "type": "number",
                  "description": "Reactor monotonic seconds."
                },
                "openspool": {
                  "description": "OpenSpool NDEF record fields, verbatim; optional.",
                  "oneOf": [{"type": "null"}, {"type": "object"}]
                },
                "spoolman_id": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1,
                  "description": "From a Spoolman-link NDEF record."
                },
                "bambu": {
                  "description": "bambu_lab_tag_processor.decode() output, keys verbatim (bambu_lab_tag_processor.py:68-87).",
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "manufacturer",
                        "type",
                        "detailed",
                        "color_argb",
                        "weight_g",
                        "diameter_mm",
                        "drying_temp_c",
                        "drying_time_h",
                        "bed_temp_c",
                        "hotend_max_c",
                        "hotend_min_c",
                        "nozzle_diameter",
                        "spool_width_mm",
                        "length_m",
                        "tray_uid",
                        "production"
                      ],
                      "properties": {
                        "manufacturer": {
                          "type": "string"
                        },
                        "type": {
                          "type": "string"
                        },
                        "detailed": {
                          "type": "string"
                        },
                        "color_argb": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 4294967295
                        },
                        "weight_g": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "diameter_mm": {
                          "type": "number"
                        },
                        "drying_temp_c": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "drying_time_h": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "bed_temp_c": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "hotend_max_c": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "hotend_min_c": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "nozzle_diameter": {
                          "type": [
                            "number",
                            "null"
                          ]
                        },
                        "spool_width_mm": {
                          "type": [
                            "number",
                            "null"
                          ]
                        },
                        "length_m": {
                          "type": [
                            "integer",
                            "null"
                          ]
                        },
                        "tray_uid": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{32}$"
                        },
                        "production": {
                          "type": "string"
                        }
                      }
                    }
                  ]
                }
              }
            }
          ]
        },
        "spool_hint": {
          "description": "NEW-v2 (D6, reserved; the firmware may ignore it). null until the component supplies one.",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mass_g",
                "outer_radius_mm",
                "valid"
              ],
              "properties": {
                "mass_g": {
                  "type": "number",
                  "minimum": 0
                },
