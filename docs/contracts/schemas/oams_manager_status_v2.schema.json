        },
        "ready": {
          "type": "boolean",
          "description": "EXISTS-v1. F1S (bay) sensor."
        },
        "loaded": {
          "type": "boolean",
          "description": "EXISTS-v1. Hub HES."
        },
        "positioning": {
          "type": "boolean",
          "description": "NEW-v2 (H16). true while this bay is the subject of a firmware-autonomous insertion positioning sequence (the positioning motion state). A UI must not offer load, unload, or calibrate_ptfe on this bay while true; the firmware replies Busy. Omitted (treated as false) by implementations that pre-date H16."
        },
        "calibrated": {
          "type": "boolean",
          "description": "NEW-v2 (D7). true iff calibration_state is configured."
        },
        "calibration_state": {
          "$ref": "#/$defs/calibration_state"
        },
