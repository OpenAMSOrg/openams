                  "type": "boolean"
                }
              }
            }
          ]
        },
        "supported_actions": {
          "type": "array",
          "description": "NEW-v2 (H1): what this bay allows now. Derivation in C2 \u00a75.4.",
          "items": {
            "enum": [
              "load",
              "unload",
              "calibrate_ptfe",
              "set_spool",
              "clear_spool",
