// How the OpenAMS macros run: the state machine of oams_macros.cfg.
// Render: dot -Tsvg macro-sequence.dot -o macro-sequence.svg
//         rsvg-convert -z 2 macro-sequence.svg -o macro-sequence.png
// Checked against a traced run of the shipped macros (test/test_openams_klipper.py
// harness). Keep it in step with oams_macros.cfg and docs/guide/macro-sequence.md.
digraph macros {
  graph [rankdir=TB, newrank=true, compound=true, nodesep=0.3, ranksep=0.32, pad=0.3,
         fontname="Helvetica", fontsize=13, bgcolor="white",
         label=<<b>How the OpenAMS macros run</b><br/><font point-size="11">oams_macros.cfg, one toolchange (T&lt;n&gt;) from top to bottom; a failure pauses the print, and RESUME re-enters where it stopped</font>>,
         labelloc=t, labeljust=l];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11,
         margin="0.14,0.06", penwidth=1.3];
  edge  [fontname="Helvetica", fontsize=10, color="#5f6670", fontcolor="#3c4148", arrowsize=0.7];

  // ---- who starts it --------------------------------------------------------
  t_n     [shape=box, style="filled,bold", fillcolor="#ffffff", color="#2b2f36",
           label=<<b>T0, T1, …</b><br/><font point-size="10">the slicer: print start and each colour change</font>>];
  ui_load [shape=box, style="filled,bold", fillcolor="#ffffff", color="#2b2f36",
           label=<<b>Panel Load</b><br/><font face="Courier" point-size="10">OPENAMS_LOAD GROUP= SLOT=</font>>];
  ui_unload [shape=box, style="filled,bold", fillcolor="#ffffff", color="#2b2f36",
           label=<<b>Panel Unload</b><br/><font face="Courier" point-size="10">OPENAMS_UNLOAD</font>>];

  catch   [shape=box, style="rounded,filled,bold", fillcolor="#ffffff", color="#2b2f36",
           label=<<font face="Courier"><b>OAMSM_TOOLCHANGE</b></font><br/><font point-size="10">runs the chain below and catches any failure in it</font>>];
  catch_u [shape=box, style="rounded,filled,bold", fillcolor="#ffffff", color="#2b2f36",
           label=<<font face="Courier"><b>OAMSM_TOOLCHANGE UNLOAD=1</b></font><br/><font point-size="10">the same catch point, for the unload</font>>];

  // ---- _TX: the toolchange --------------------------------------------------
  subgraph cluster_tx {
    label=<<font face="Courier"><b>_TX GROUP=T&lt;n&gt;</b></font>>; labeljust=l;
    style="rounded,filled"; fillcolor="#f7f8fa"; color="#b9bfc8";
    same    [shape=hexagon, fillcolor="#fff6cc", color="#b8900a",
             label=<That group already loaded,<br/>or the object excluded?>];
    e_a     [shape=circle, style="filled,bold", fillcolor="#7a2bd0", color="#7a2bd0", fontcolor="white", fontsize=14, width=0.42, fixedsize=true, margin=0, label=<<b>A</b>>];
    plan    [fillcolor="#f0f1f4", color="#8a919b",
             label=<<font face="Courier"><b>_OAMS_PLAN</b></font><br/><font point-size="10">works out the temperature, shows the plan on the displays</font>>];
    home    [fillcolor="#efe5ff", color="#7d4fc7",
             label=<<font face="Courier"><b>G28</b></font>   <font color="#7d4fc7"><b>home</b></font><br/><font point-size="10">only if the printer isn't homed</font>>];
    loaded  [shape=hexagon, fillcolor="#fff6cc", color="#b8900a",
             label=<Filament in the toolhead?>];
    hb_tx   [fillcolor="#e2f5e7", color="#2e8b4e", style="rounded,filled,dashed",
             label=<<font face="Courier"><b>_OAMS_HOOK_BEFORE_HEAT</b></font><br/><font point-size="10">yours, if you wrote one (run by _OAMS_HEAT)</font>>];
    heat_tx [fillcolor="#f0f1f4", color="#8a919b",
             label=<<font face="Courier"><b>_OAMS_HEAT</b></font>   <font color="#c0392b"><b>heat</b></font><br/><font point-size="10">heats and waits, only if the nozzle is colder</font>>];
  }

  // ---- SAFE_UNLOAD_FILAMENT: the unload -------------------------------------
  subgraph cluster_unload {
    label=<<font face="Courier"><b>SAFE_UNLOAD_FILAMENT</b></font>>; labeljust=l;
    style="rounded,filled"; fillcolor="#f7f8fa"; color="#b9bfc8";
    plan_u  [fillcolor="#f0f1f4", color="#8a919b", style="rounded,filled,dashed",
             label=<<font face="Courier"><b>_OAMS_PLAN</b>, <b>G28</b></font><br/><font point-size="10">Panel Unload only: its own plan, homes if needed</font>>];
    e_c     [shape=circle, style="filled,bold", fillcolor="#7a2bd0", color="#7a2bd0", fontcolor="white", fontsize=14, width=0.42, fixedsize=true, margin=0, label=<<b>C</b>>];
    hb_u    [fillcolor="#e2f5e7", color="#2e8b4e", style="rounded,filled,dashed",
             label=<<font face="Courier"><b>_OAMS_HOOK_BEFORE_HEAT</b></font><br/><font point-size="10">yours, if you wrote one (run by _OAMS_HEAT)</font>>];
    heat_u  [fillcolor="#f0f1f4", color="#8a919b",
             label=<<font face="Courier"><b>_OAMS_HEAT</b></font>   <font color="#c0392b"><b>heat</b></font><br/><font point-size="10">heats and waits, only if the nozzle is colder</font>>];
    follow  [fillcolor="#dceafe", color="#2f6fd0",
             label=<<font face="Courier"><b>OAMSM_FOLLOWER</b></font><br/><font point-size="10">the AMS follows the extruder backwards</font>>];
    ret1    [fillcolor="#ffeedd", color="#d9822b",
             label=<<font face="Courier"><b>G1 E-retract_length</b></font>   <font color="#c0392b"><b>cut</b></font><br/><font point-size="10">a short retract before the cut</font>>];
    cut     [fillcolor="#efe5ff", color="#7d4fc7",
             label=<<font face="Courier"><b>CUT_FILAMENT</b></font><br/><font point-size="10">the cutter moves: pre_cut → cut → post_cut</font>>];
    ocut    [fillcolor="#e2f5e7", color="#2e8b4e", style="rounded,filled,dashed",
             label=<<font face="Courier"><b>OAMS_CUT</b></font><br/><font point-size="10">yours, if you wrote one:<br/>CUT_FILAMENT runs it instead of the moves</font>>];
    h_cut   [fillcolor="#e2f5e7", color="#2e8b4e", style="rounded,filled,dashed",
             label=<<font face="Courier"><b>_OAMS_HOOK_AFTER_CUT</b></font><br/><font point-size="10">yours, if you wrote one</font>>];
    ret2    [fillcolor="#ffeedd", color="#d9822b",
             label=<<font face="Courier"><b>G1 E-extrusion_unload_length</b></font><br/><font point-size="10">pulls the cut end out of the extruder gears</font>>];
    fs_u    [shape=hexagon, fillcolor="#fff6cc", color="#b8900a",
             label=<<font face="Courier"><b>_UNLOAD_FS_OUT</b></font><br/><font point-size="10">filament gone from the extruder?<br/>(only with fs_extruder_out)</font>>];
  }

  subgraph cluster_finish_unload {
    label=<<font face="Courier"><b>_OAMS_FINISH_UNLOAD</b></font>>; labeljust=l;
    style="rounded,filled"; fillcolor="#f7f8fa"; color="#b9bfc8";
    ret3    [fillcolor="#ffeedd", color="#d9822b",
             label=<<font face="Courier"><b>G1 E-extrusion_unload_additional_length</b></font><br/><font point-size="10">an extra retract before the rewind</font>>];
    rewind  [fillcolor="#dceafe", color="#2f6fd0",
             label=<<font face="Courier"><b>OAMSM_UNLOAD_FILAMENT</b></font>   <font color="#c0392b"><b>retract</b></font><br/><font point-size="10">the AMS rewinds the filament to its bay</font>>];
    confirm [shape=hexagon, fillcolor="#fff6cc", color="#b8900a",
             label=<<font face="Courier"><b>_OAMS_CONFIRM_UNLOADED</b></font><br/><font point-size="10">the AMS says it's unloaded?</font>>];
  }

  // ---- the load -------------------------------------------------------------
  subgraph cluster_after_unload {
    label=<<font face="Courier"><b>_OAMS_CONTINUE_AFTER_UNLOAD</b></font>>; labeljust=l;
    style="rounded,filled"; fillcolor="#f7f8fa"; color="#b9bfc8";
    h_ret   [fillcolor="#e2f5e7", color="#2e8b4e", style="rounded,filled,dashed",
             label=<<font face="Courier"><b>_OAMS_HOOK_AFTER_RETRACT</b></font><br/><font point-size="10">yours, if you wrote one (a swap only)</font>>];
    feed    [fillcolor="#dceafe", color="#2f6fd0",
             label=<<font face="Courier"><b>OAMSM_LOAD_FILAMENT</b></font>   <font color="#c0392b"><b>feed</b></font><br/><font point-size="10">the AMS feeds the group's next spool to the extruder gears,<br/>then follows the extruder</font>>];
  }

  subgraph cluster_after_load {
    label=<<font face="Courier"><b>_OAMS_CONTINUE_AFTER_LOAD</b></font>>; labeljust=l;
    style="rounded,filled"; fillcolor="#f7f8fa"; color="#b9bfc8";
    e_b     [shape=circle, style="filled,bold", fillcolor="#7a2bd0", color="#7a2bd0", fontcolor="white", fontsize=14, width=0.42, fixedsize=true, margin=0, label=<<b>B</b>>];
    did_load [shape=hexagon, fillcolor="#fff6cc", color="#b8900a",
             label=<That group loaded?>];
    fs_in   [shape=hexagon, fillcolor="#fff6cc", color="#b8900a",
             label=<<font face="Courier"><b>_LOAD_FS_IN</b></font><br/><font point-size="10">filament at the extruder inlet?<br/>(only with fs_extruder_in)</font>>];
  }

  subgraph cluster_inlet {
    label=<<font face="Courier"><b>_OAMS_CONTINUE_AFTER_INLET</b></font>>; labeljust=l;
    style="rounded,filled"; fillcolor="#f7f8fa"; color="#b9bfc8";
    reload  [fillcolor="#ffeedd", color="#d9822b",
             label=<<font face="Courier"><b>_OAMS_RELOAD</b></font><br/><font point-size="10">the extruder pushes it from the gears into the melt zone:</font><br/><font face="Courier" point-size="10">extrusion_reload_length + retract_length</font><br/><font face="Courier" point-size="10">+ hotend_meltzone_compensation</font>>];
    fs_out  [shape=hexagon, fillcolor="#fff6cc", color="#b8900a",
             label=<<font face="Courier"><b>_LOAD_FS_OUT</b></font><br/><font point-size="10">filament past the extruder?<br/>(only with fs_extruder_out)</font>>];
  }

  subgraph cluster_finish {
    label=<<font face="Courier"><b>_OAMS_FINISH_TOOLCHANGE</b></font>>; labeljust=l;
    style="rounded,filled"; fillcolor="#f7f8fa"; color="#b9bfc8";
    e_d     [shape=circle, style="filled,bold", fillcolor="#7a2bd0", color="#7a2bd0", fontcolor="white", fontsize=14, width=0.42, fixedsize=true, margin=0, label=<<b>D</b>>];
    clean   [fillcolor="#e2f5e7", color="#2e8b4e",
             label=<<font face="Courier"><b>CLEAN_NOZZLE</b></font><br/><font point-size="10">yours, required: wipe or purge</font>>];
    h_feed  [fillcolor="#e2f5e7", color="#2e8b4e", style="rounded,filled,dashed",
             label=<<font face="Courier"><b>_OAMS_HOOK_AFTER_FEED</b></font><br/><font point-size="10">yours, if you wrote one</font>>];
    restore [fillcolor="#f0f1f4", color="#8a919b",
             label=<<font face="Courier"><b>_OAMS_RESTORE</b>, <b>RESTORE_GCODE_STATE</b></font><br/><font point-size="10">heater back (idle printer only), toolhead back to the print</font>>];
  }

  done      [shape=box, style="rounded,filled,bold", fillcolor="#1f7a45", color="#1f7a45", fontcolor="white",
             label=<<b>Done</b>: the print goes on>];
  nothing   [shape=box, style="rounded,filled", fillcolor="#e9ecef", color="#8a919b",
             label=<<b>Nothing moves</b>>];
  unloaded  [shape=box, style="rounded,filled,bold", fillcolor="#1f7a45", color="#1f7a45", fontcolor="white",
             label=<<b>Unloaded</b><br/><font point-size="10">Panel Unload ends here</font>>];

  // Every failed check goes to the same place (the catch point, then PAUSE);
  // one red node per check keeps the drawing readable.
  node [shape=box, style="rounded,filled", fillcolor="#fde2e2", color="#c62828", fontcolor="#8e1b1b",
        label=<<b>fail</b>>, fontsize=10, margin="0.08,0.03"];
  f_u; f_c; f_l; f_in; f_out;

  // ---- the flow -------------------------------------------------------------
  t_n -> catch;
  ui_load -> catch;
  catch -> same [label=" checks a panel slot first"];
  same -> nothing [label=" yes"];
  same -> plan [label=" no"];
  plan -> home -> loaded;
  loaded -> hb_tx [label=" no: an empty toolhead"];
  hb_tx -> heat_tx;
  loaded -> hb_u [label=" yes: a swap"];
  hb_u -> heat_u;
  heat_tx -> feed [label=" no unload"];

  ui_unload -> catch_u -> plan_u -> hb_u;
  heat_u -> follow -> ret1 -> cut -> h_cut -> ret2 -> fs_u;
  ret1 -> ocut [style=dashed, label=" or"];
  ocut -> h_cut [style=dashed];
  {rank=same; cut; ocut;}
  fs_u -> f_u [label=" no", color="#c62828", fontcolor="#c62828"];
  fs_u -> ret3 [label=" yes"];
  ret3 -> rewind -> confirm;
  confirm -> f_c [label=" no", color="#c62828", fontcolor="#c62828"];
  confirm -> unloaded [label=" yes, Panel Unload"];
  confirm -> h_ret [label=" yes, a toolchange"];
  h_ret -> feed -> did_load;
  did_load -> f_l [label=" no", color="#c62828", fontcolor="#c62828"];
  did_load -> fs_in [label=" yes"];
  fs_in -> f_in [label=" no", color="#c62828", fontcolor="#c62828"];
  fs_in -> reload [label=" yes"];
  reload -> fs_out;
  fs_out -> f_out [label=" no", color="#c62828", fontcolor="#c62828"];
  fs_out -> clean [label=" yes"];
  clean -> h_feed -> restore -> done;

  {rank=same; fs_u; f_u;}
  {rank=same; confirm; f_c;}
  {rank=same; did_load; f_l;}
  {rank=same; fs_in; f_in;}
  {rank=same; fs_out; f_out;}
  {rank=same; t_n; ui_load;}
  {rank=same; home; ui_unload;}

  // ---- what "fail" does, and the other flows --------------------------------
  node [shape=box, style="rounded,filled", fillcolor="#fde2e2", color="#c62828", fontcolor="#2b2f36",
        fontsize=11, margin="0.14,0.06"];
  // ---- a failure: PAUSE, then RESUME re-enters the chain ---------------------
  subgraph cluster_fail {
    label=<<b>When a step fails</b>>; labeljust=l;
    style="rounded,filled"; fillcolor="#fff7f7"; color="#e3a0a0";
    fault   [style="rounded,filled,bold", fillcolor="#fde2e2", color="#c62828",
             label=<<font face="Courier"><b>OAMSM_TOOLCHANGE</b></font> catches it<br/><font point-size="10">any failure: a red check, homing, heating, the cutter, the AMS refusing,<br/>a hook, CLEAN_NOZZLE, the Stop button. It records the step, the<br/>reason and the group on the lane, puts the toolhead back where the<br/>toolchange started (unless it had to home first) and stops the<br/>follower once it is safe. The heater stays on.</font>>];
    inprint [shape=hexagon, style="filled", fillcolor="#fff6cc", color="#b8900a", fontcolor="#2b2f36",
             label=<In a print?>];
    pause   [style="rounded,filled,bold", fillcolor="#fff0c2", color="#b8900a", fontcolor="#2b2f36",
             label=<<font face="Courier"><b>PAUSE</b></font><br/><font point-size="10">the print pauses and the reason is in the console:<br/><font face="Courier">the toolchange to T1 failed at the &lt;step&gt; step: &lt;reason&gt;</font><br/>and the idle timeout goes to <font face="Courier">pause_idle_timeout</font> (48 h),<br/>so the heaters and motors stay on and the printer keeps its position.<br/>If nothing can pause it (no [pause_resume]), the error ends the print</font>>];
    perr    [style="rounded,filled", fillcolor="#fde2e2", color="#c62828", fontcolor="#2b2f36",
             label=<<b>An error on the panel</b><br/><font point-size="10">no print: Retry, Unload or Reset</font>>];
    resume  [style="filled,bold", fillcolor="#ffffff", color="#2b2f36", fontcolor="#2b2f36",
             label=<<font face="Courier"><b>RESUME</b></font><br/><font point-size="10">once you have fixed the cause</font>>];
    homed   [shape=hexagon, style="filled", fillcolor="#fff6cc", color="#b8900a", fontcolor="#2b2f36",
             label=<Still homed?>];
    lost    [style="rounded,filled,bold", fillcolor="#fde2e2", color="#c62828", fontcolor="#2b2f36",
             label=<<b>Refused</b>: <font face="Courier">the printer lost its position</font><br/><font point-size="10">the motors went off while it waited; nothing moves,<br/>the print stays paused: cancel it. A T&lt;n&gt;, Load<br/>or Unload is refused the same way</font>>];
    reset   [style="rounded,filled", fillcolor="#dceafe", color="#2f6fd0", fontcolor="#2b2f36",
             label=<<b>Reset</b><br/><font point-size="10">clears the AMS's faults, re-reads the lanes</font>>];
    diag    [shape=hexagon, style="filled", fillcolor="#fff6cc", color="#b8900a", fontcolor="#2b2f36",
             label=<<b>Diagnose</b>: where did it stop?<br/><font point-size="10">the lane and its sensors</font>>];
    again   [shape=note, style="filled", fillcolor="#ffffff", color="#b9bfc8", fontcolor="#2b2f36", fontsize=10,
             label=<Re-entered, the chain runs on as drawn:<br/>it ends at <b>Done</b>, or a check fails again and<br/>the print pauses again. Before Klipper's resume<br/>takes the toolhead back to the pause position,<br/>RESUME checks that the toolhead holds the<br/>print's group; if not it refuses (<font face="Courier">the print needs</font><br/><font face="Courier">&lt;group&gt; loaded</font>) and the print stays paused.<br/>A retry counts only with its group loaded,<br/>and loads it even for an excluded object.<br/>An Unload or Load during the pause keeps the<br/>failed toolchange, with where it left the lane;<br/>a Load of that group that finishes finishes it.<br/>A later T&lt;n&gt; of the same macro moves nothing<br/>and becomes the target. OpenAMS never<br/>retries on its own.>];
    fault -> inprint;
    inprint -> pause [label=" yes"];
    inprint -> perr [label=" no"];
    pause -> resume [label=" you fix the cause"];
    resume -> homed;
    homed -> reset [label=" yes"];
    homed -> lost [label=" no", color="#c62828", fontcolor="#c62828"];
    reset -> diag;
    perr -> reset [label=" Retry", style=dashed];
    {rank=same; pause; perr;}
    node [shape=box, style="rounded,filled", fillcolor="#f3e8ff", color="#7a2bd0", fontcolor="#2b2f36",
          fontsize=11, margin="0.14,0.06"];
    r_fin   [label=<<font color="#7a2bd0"><b>→ D</b></font>  <b>what follows the reload</b><br/><font point-size="10"><font face="Courier">_OAMS_RESUME_TOOLHEAD RELOADED=1</font> heats, turns<br/>the follower on, then goes on from D: no second reload</font>>];
    r_tool  [label=<<font color="#7a2bd0"><b>→ B</b></font>  <b>the toolhead part</b><br/><font point-size="10"><font face="Courier">_OAMS_RESUME_TOOLHEAD</font> heats, turns the<br/>follower on, then goes on from B</font>>];
    r_tx    [label=<<font color="#7a2bd0"><b>→ A</b></font>  <b><font face="Courier">_TX</font> again</b><br/><font point-size="10">the feed when nothing is loaded, the whole swap<br/>when another group is, a rewind of that bay first<br/>when its feed stopped short, an unload through<br/>the cutter first when the target is loaded but was<br/>never fed; all of it when the toolchange never started</font>>];
    r_unl   [label=<<font color="#7a2bd0"><b>→ C</b></font>  <b>the unload again</b><br/><font point-size="10"><font face="Courier">SAFE_UNLOAD_FILAMENT</font></font>>];
    diag -> r_fin [label=" the reload passed\n the outlet check", color="#7a2bd0", fontcolor="#5a1fa0"];
    diag -> r_tool [label=" the group is at the\n gears, not reloaded", color="#7a2bd0", fontcolor="#5a1fa0"];
    diag -> r_tx [label=" anything\n else", color="#7a2bd0", fontcolor="#5a1fa0"];
    diag -> r_unl [label=" an unload\n failed", color="#7a2bd0", fontcolor="#5a1fa0"];
    r_tx -> again [style=invis];
  }

  subgraph cluster_bare {
    label=<<b>Without the cutter</b>>; labeljust=l;
    style="rounded,filled"; fillcolor="#f7f8fa"; color="#b9bfc8";
    node [fontcolor="#2b2f36", fontsize=11, margin="0.14,0.06"];
    b_load  [shape=box, style="filled,bold", fillcolor="#ffffff", color="#2b2f36",
             label=<<font face="Courier"><b>OAMSM_LOAD_TO_TOOLHEAD GROUP=</b></font>>];
    b_feed  [style="rounded,filled", fillcolor="#dceafe", color="#2f6fd0",
             label=<<font face="Courier"><b>OAMSM_LOAD_FILAMENT</b></font><br/><font point-size="10">the AMS feeds to the extruder gears</font>>];
    b_tl    [style="rounded,filled", fillcolor="#f0f1f4", color="#8a919b",
             label=<<font face="Courier"><b>_OAMS_TOOLHEAD_LOAD</b></font><br/><font point-size="10">heats if the spool's temperature is known<br/>and the nozzle is colder</font>>];
    b_rel   [style="rounded,filled", fillcolor="#ffeedd", color="#d9822b",
             label=<<font face="Courier"><b>_OAMS_RELOAD</b></font><br/><font point-size="10">the same move as a toolchange</font>>];
    b_unload [shape=box, style="filled,bold", fillcolor="#ffffff", color="#2b2f36",
             label=<<font face="Courier"><b>OAMSM_UNLOAD_FROM_TOOLHEAD</b></font>>];
    b_fol   [style="rounded,filled", fillcolor="#dceafe", color="#2f6fd0",
             label=<<font face="Courier"><b>OAMSM_FOLLOWER</b></font><br/><font point-size="10">the AMS follows the extruder backwards</font>>];
    b_ej    [style="rounded,filled", fillcolor="#ffeedd", color="#d9822b",
             label=<<font face="Courier"><b>_OAMS_TOOLHEAD_EJECT</b></font><br/><font point-size="10">heats if colder, 10 mm forward to soften<br/>the tip, 100 mm back in 25 mm moves</font>>];
    b_rew   [style="rounded,filled", fillcolor="#dceafe", color="#2f6fd0",
             label=<<font face="Courier"><b>OAMSM_UNLOAD_FILAMENT</b></font><br/><font point-size="10">the AMS rewinds it to its bay</font>>];
    b_load -> b_feed -> b_tl -> b_rel;
    b_unload -> b_fol -> b_ej -> b_rew;
  }

  runout [shape=box, style="rounded,filled", fillcolor="#f0f1f4", color="#8a919b", fontcolor="#2b2f36",
          label=<<b>A spool runs out mid-print</b><br/><font point-size="10">no macro runs: OpenAMS feeds a spare bay of the same group,<br/>or runs PAUSE when it has none</font>>];

  key [shape=plain, fontcolor="#2b2f36", fontsize=10, label=<
    <table border="1" color="#b9bfc8" bgcolor="#ffffff" cellborder="1" cellspacing="5" cellpadding="5">
      <tr><td colspan="2" border="0" align="left"><b>Key</b></td></tr>
      <tr><td bgcolor="#dceafe" color="#2f6fd0">the AMS moves</td>
          <td bgcolor="#ffeedd" color="#d9822b">the extruder moves</td></tr>
      <tr><td bgcolor="#efe5ff" color="#7d4fc7">the toolhead moves</td>
          <td bgcolor="#e2f5e7" color="#2e8b4e">your macro (dashed: optional)</td></tr>
      <tr><td bgcolor="#fff6cc" color="#b8900a">a check</td>
          <td bgcolor="#ffffff" color="#8a919b"><font color="#c0392b"><b>heat</b></font>: the step the displays show</td></tr>
      <tr><td bgcolor="#fde2e2" color="#c62828">a failure: PAUSE</td>
          <td bgcolor="#f3e8ff" color="#7a2bd0"><font color="#7a2bd0"><b>A B C D</b></font>: where RESUME re-enters</td></tr>
    </table>>];

  // Park the side panels top right, above the first check that can fail, so
  // each red "fail" sits next to its check.
  {rank=same; same; nothing; key;}
  key -> b_load [style=invis];
  key -> b_unload [style=invis];
  b_rel -> runout [style=invis];
  runout -> fault [style=invis];

  // every red "fail" goes to the catch point
  edge [color="#c62828", fontcolor="#c62828"];
  f_u -> fault; f_c -> fault; f_l -> fault; f_in -> fault; f_out -> fault;

  // RESUME re-enters the chain where the diagnosis says it stopped: a lettered
  // connector next to each step it re-enters (long arrows back up would cross
  // the whole drawing).
  edge [color="#7a2bd0", fontcolor="#5a1fa0", style="bold", penwidth=1.6, constraint=true];
  e_a -> plan [label=" RESUME"];
  e_b -> did_load [label=" RESUME"];
  e_c -> hb_u [label=" RESUME"];
  e_d -> clean [label=" RESUME"];
  {rank=same; e_a; plan;}
  {rank=same; e_b; did_load;}
  {rank=same; e_c; hb_u;}
  {rank=same; e_d; clean;}
}
