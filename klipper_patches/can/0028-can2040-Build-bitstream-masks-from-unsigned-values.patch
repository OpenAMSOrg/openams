From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: JR Lomas <lomas.jr@gmail.com>
Date: Mon, 24 Aug 2026 12:20:15 -0700
Subject: [PATCH] can2040: Build bitstream masks from unsigned values

The can2040 stuffing and unstuffing paths repeatedly formed uint32_t masks from the signed literal 1.  Parser and stuffer positions can legitimately reach bit 31 while handling complete words, including while recovering from malformed bus input.  Shifting a signed int into that bit is undefined by C.

Undefined mask construction in this code is particularly undesirable because the masks decide which incoming bits are copied, removed as stuff bits, or reported as protocol errors.  An optimizer-induced change can therefore alter frame validation at the physical CAN boundary.

Build every variable-position parser and stuffer mask from 1u.  Add an explanatory comment at the bitstream boundary and split one long expression for readability.  No generated mask or wire-format value changes on existing compilers.

Signed-off-by: JR Lomas <lomas.jr@gmail.com>

diff --git a/lib/can2040/can2040.c b/lib/can2040/can2040.c
index f11b3818..1f874031 100644
--- a/lib/can2040/can2040.c
+++ b/lib/can2040/can2040.c
@@ -490,11 +490,19 @@ crc_bytes(uint32_t crc, uint32_t data, uint32_t num)
  * Bit unstuffing
  ****************************************************************/
 
+/*
+ * The parser represents each incoming window in a uint32_t and bit positions
+ * can reach the high bit while processing a valid frame or recovering from a
+ * malformed one.  Build all masks from unsigned one-bit values below.  A
+ * signed `1 << 31` is undefined by C and would let compiler optimization alter
+ * the exact bitstream checks that protect the parser from noisy bus input.
+ */
+
 // Add 'count' number of bits from 'data' to the 'bu' unstuffer
 static void
 unstuf_add_bits(struct can2040_bitunstuffer *bu, uint32_t data, uint32_t count)
 {
-    uint32_t mask = (1 << count) - 1;
+    uint32_t mask = (1u << count) - 1;
     bu->stuffed_bits = (bu->stuffed_bits << count) | (data & mask);
     bu->count_stuff = count;
 }
@@ -511,7 +519,7 @@ unstuf_set_count(struct can2040_bitunstuffer *bu, uint32_t num_bits)
 static void
 unstuf_clear_state(struct can2040_bitunstuffer *bu)
 {
-    uint32_t lb = 1 << bu->count_stuff;
+    uint32_t lb = 1u << bu->count_stuff;
     bu->stuffed_bits = (bu->stuffed_bits & (lb - 1)) | (lb << 1);
 }
 
@@ -520,7 +528,7 @@ static void
 unstuf_restore_state(struct can2040_bitunstuffer *bu, uint32_t data)
 {
     uint32_t cs = bu->count_stuff;
-    bu->stuffed_bits = (bu->stuffed_bits & ((1 << cs) - 1)) | (data << cs);
+    bu->stuffed_bits = (bu->stuffed_bits & ((1u << cs) - 1)) | (data << cs);
 }
 
 // Pull bits from unstuffer (as specified in unstuf_set_count() )
@@ -536,23 +544,24 @@ unstuf_pull_bits_rp2040(struct can2040_bitunstuffer *bu)
     for (;;) {
         uint32_t try_cnt = cs > cu ? cu : cs;
         for (;;) {
-            uint32_t try_mask = ((1 << try_cnt) - 1) << (cs + 1 - try_cnt);
+            uint32_t try_mask = ((1u << try_cnt) - 1) << (cs + 1 - try_cnt);
             if (likely(!(rm_bits & try_mask))) {
                 // No stuff bits in try_cnt bits - copy into unstuffed_bits
                 bu->count_unstuff = cu = cu - try_cnt;
                 bu->count_stuff = cs = cs - try_cnt;
-                bu->unstuffed_bits |= ((sb >> cs) & ((1 << try_cnt) - 1)) << cu;
+                uint32_t copy = (sb >> cs) & ((1u << try_cnt) - 1);
+                bu->unstuffed_bits |= copy << cu;
                 if (! cu)
                     // Extracted desired bits
                     return 0;
                 break;
             }
             bu->count_stuff = cs = cs - 1;
-            if (rm_bits & (1 << (cs + 1))) {
+            if (rm_bits & (1u << (cs + 1))) {
                 // High bit is a stuff bit
-                if (unlikely(rm_bits & (1 << cs))) {
+                if (unlikely(rm_bits & (1u << cs))) {
                     // Six consecutive bits - a bitstuff error
-                    if (sb & (1 << cs))
+                    if (sb & (1u << cs))
                         return -1;
                     return -2;
                 }
@@ -583,13 +592,13 @@ unstuf_pull_bits(struct can2040_bitunstuffer *bu)
             // Need more data
             return 1;
         uint32_t try_cnt = cs > cu ? cu : cs;
-        uint32_t try_mask = ((1 << try_cnt) - 1) << (cs + 1 - try_cnt);
+        uint32_t try_mask = ((1u << try_cnt) - 1) << (cs + 1 - try_cnt);
         uint32_t rm_masked_bits = rm_bits & try_mask;
         if (likely(!rm_masked_bits)) {
             // No stuff bits in try_cnt bits - copy into unstuffed_bits
             bu->count_unstuff = cu = cu - try_cnt;
             bu->count_stuff = cs = cs - try_cnt;
-            bu->unstuffed_bits |= ((sb >> cs) & ((1 << try_cnt) - 1)) << cu;
+            bu->unstuffed_bits |= ((sb >> cs) & ((1u << try_cnt) - 1)) << cu;
             if (! cu)
                 // Extracted desired bits
                 return 0;
@@ -600,12 +609,12 @@ unstuf_pull_bits(struct can2040_bitunstuffer *bu)
         uint32_t copy_cnt = cs - (31 - __builtin_clz(rm_masked_bits));
         cs -= copy_cnt;
         bu->count_unstuff = cu = cu - copy_cnt;
-        bu->unstuffed_bits |= ((sb >> cs) & ((1 << copy_cnt) - 1)) << cu;
+        bu->unstuffed_bits |= ((sb >> cs) & ((1u << copy_cnt) - 1)) << cu;
         // High bit is now a stuff bit - remove it
         bu->count_stuff = cs = cs - 1;
-        if (unlikely(rm_bits & (1 << cs))) {
+        if (unlikely(rm_bits & (1u << cs))) {
             // Six consecutive bits - a bitstuff error
-            if (sb & (1 << cs))
+            if (sb & (1u << cs))
                 return -1;
             return -2;
         }
@@ -633,7 +642,7 @@ bitstuff_rp2040(uint32_t *pb, uint32_t num_bits)
         uint32_t try_cnt = num_bits, edges = b ^ (b >> 1);
         uint32_t e2 = edges | (edges >> 1), e4 = e2 | (e2 >> 2), add_bits = ~e4;
         for (;;) {
-            uint32_t try_mask = ((1 << try_cnt) - 1) << (num_bits - try_cnt);
+            uint32_t try_mask = ((1u << try_cnt) - 1) << (num_bits - try_cnt);
             if (!(add_bits & try_mask)) {
                 // No stuff bits needed in try_cnt bits
                 if (try_cnt >= num_bits)
@@ -642,11 +651,11 @@ bitstuff_rp2040(uint32_t *pb, uint32_t num_bits)
                 try_cnt = (num_bits + 1) / 2;
                 continue;
             }
-            if (add_bits & (1 << (num_bits - 1))) {
+            if (add_bits & (1u << (num_bits - 1))) {
                 // A stuff bit must be inserted prior to the high bit
-                uint32_t low_mask = (1 << num_bits) - 1, low = b & low_mask;
+                uint32_t low_mask = (1u << num_bits) - 1, low = b & low_mask;
                 uint32_t high = (b & ~(low_mask >> 1)) << 1;
-                b = high ^ low ^ (1 << (num_bits - 1));
+                b = high ^ low ^ (1u << (num_bits - 1));
                 count += 1;
                 if (num_bits <= 4)
                     goto done;
@@ -673,15 +682,16 @@ bitstuff(uint32_t *pb, uint32_t num_bits)
     for (;;) {
         uint32_t edges = b ^ (b >> 1);
         uint32_t e2 = edges | (edges >> 1), e4 = e2 | (e2 >> 2), add_bits = ~e4;
-        uint32_t mask = (1 << num_bits) - 1, add_masked_bits = add_bits & mask;
+        uint32_t mask = (1u << num_bits) - 1;
+        uint32_t add_masked_bits = add_bits & mask;
         if (!add_masked_bits)
             // No more stuff bits needed
             break;
         // Insert a stuff bit
         uint32_t stuff_pos = 1 + 31 - __builtin_clz(add_masked_bits);
-        uint32_t low_mask = (1 << stuff_pos) - 1, low = b & low_mask;
+        uint32_t low_mask = (1u << stuff_pos) - 1, low = b & low_mask;
         uint32_t high = (b & ~(low_mask >> 1)) << 1;
-        b = high ^ low ^ (1 << (stuff_pos - 1));
+        b = high ^ low ^ (1u << (stuff_pos - 1));
         count += 1;
         if (stuff_pos <= 4)
             break;
@@ -716,7 +726,7 @@ bs_pushraw(struct bitstuffer_s *bs, uint32_t data, uint32_t count)
 static void
 bs_push(struct bitstuffer_s *bs, uint32_t data, uint32_t count)
 {
-    data &= (1 << count) - 1;
+    data &= (1u << count) - 1;
     uint32_t stuf = (bs->prev_stuffed << count) | data;
     uint32_t newcount = bitstuff(&stuf, count);
     bs_pushraw(bs, stuf, newcount);
@@ -731,7 +741,7 @@ bs_finalize(struct bitstuffer_s *bs)
     uint32_t words = DIV_ROUND_UP(bitpos, 32);
     uint32_t extra = words * 32 - bitpos;
     if (extra)
-        bs->buf[words - 1] |= (1 << extra) - 1;
+        bs->buf[words - 1] |= (1u << extra) - 1;
     return words;
 }
 
