--- a/src/generic/canserial.h
+++ b/src/generic/canserial.h
@@ -8,6 +8,7 @@
 
 // canserial.c
 void canserial_notify_tx(void);
+void canserial_set_invalid_bitrate(void);
 struct canbus_msg;
 void canserial_process_data(struct canbus_msg *msg);
 void canserial_set_uuid(uint8_t *raw_uuid, uint32_t raw_uuid_len);
diff --git a/src/lpc176x/can.c b/src/lpc176x/can.c
index 089da849..6920473d 100644
--- a/src/lpc176x/can.c
+++ b/src/lpc176x/can.c
@@ -10,6 +10,7 @@
 #include "command.h" // DECL_CONSTANT_STR
 #include "compiler.h" // DIV_ROUND_CLOSEST
 #include "generic/canbus.h" // canbus_notify_tx
+#include "generic/canserial.h" // canserial_set_invalid_bitrate
 #include "internal.h" // enable_pclock
 #include "sched.h" // DECL_INIT
 
@@ -112,8 +113,18 @@ make_btr(uint32_t sjw, uint32_t time_seg1, uint32_t time_seg2, uint32_t brp)
 static uint32_t
 compute_btr(uint32_t pclock, uint32_t bitrate)
 {
+    /*
+     * A truncated pclock / bitrate result silently programs a nearby bus rate,
+     * and the previous fallback encoded arbitrary default timing when no legal
+     * quanta count was found.  The host still sees CANBUS_FREQUENCY as the
+     * requested value, hiding that mismatch until arbitration or sampling
+     * becomes unreliable.  Accept only an exactly divisible clock and a timing
+     * tuple which fits every LPC CAN field.
+     */
+    if (!bitrate || pclock % bitrate)
+        return CAN_INVALID_BTR;
     uint32_t bit_clocks = pclock / bitrate;
-    uint32_t best_sample_error = ~0, best_brp = bit_clocks / 10;
+    uint32_t best_sample_error = ~0, best_brp = 0;
     uint32_t time_seg1 = 7, time_seg2 = 2;
     int qs;
     for (qs = 25; qs >= 8; qs--) {
@@ -149,6 +160,8 @@ compute_btr(uint32_t pclock, uint32_t bitrate)
         }
     }
 
+    if (best_sample_error == (uint32_t)~0)
+        return CAN_INVALID_BTR;
     return make_btr(2, time_seg1, time_seg2, best_brp);
 }
 
@@ -297,8 +310,13 @@ can_init(void)
     gpio_peripheral(GPIO_Tx, CAN_FUNCTION_Tx, 0);
 
     LPC_CANAF->AFMR = CANAF_AFMR_ACCBP;
-    LPC_CANx->BTR = compute_btr(get_pclock_frequency(PCLK_CANx)
-                                , CONFIG_CANBUS_FREQUENCY);
+    uint32_t btr = compute_btr(get_pclock_frequency(PCLK_CANx)
+                               , CONFIG_CANBUS_FREQUENCY);
+    if (btr == CAN_INVALID_BTR) {
+        canserial_set_invalid_bitrate();
+        return;
+    }
+    LPC_CANx->BTR = btr;
     LPC_CANx->EWL = CAN_ERROR_WARNING_LIMIT;
 
     // Clear any stale interrupt state and enter normal operating mode.
diff --git a/src/rp2040/can.c b/src/rp2040/can.c
index 5540c9a1..e61c73ff 100644
--- a/src/rp2040/can.c
+++ b/src/rp2040/can.c
@@ -115,7 +115,26 @@ can_init(void)
 
     // Start canbus
     uint32_t pclk = get_pclock_frequency(RESETS_RESET_PIO0_RESET);
+    /*
+     * can2040 represents its PIO clock divider in 16.8 fixed point.  Its setup
+     * calculation previously truncated any fractional remainder, so the host
+     * could be told CANBUS_FREQUENCY while the PIO sampled a nearby physical
+     * rate.  Validate the exact encoded divider, including the hardware's
+     * minimum divide-by-one and 16-bit integer limit, before starting the state
+     * machines.  This rejects only rates this clock can not represent exactly.
+     */
+    uint64_t divider_numerator = (256 / 32) * (uint64_t)pclk;
+    if (!CONFIG_CANBUS_FREQUENCY
+        || divider_numerator % CONFIG_CANBUS_FREQUENCY)
+        goto invalid_bitrate;
+    uint64_t divider = divider_numerator / CONFIG_CANBUS_FREQUENCY;
+    if (divider < 256 || divider > 0xffffff)
+        goto invalid_bitrate;
     can2040_start(&cbus, pclk, CONFIG_CANBUS_FREQUENCY
                   , CONFIG_RPXXXX_CANBUS_GPIO_RX, CONFIG_RPXXXX_CANBUS_GPIO_TX);
+    return;
+
+invalid_bitrate:
+    canserial_set_invalid_bitrate();
 }
 DECL_INIT(can_init);
