From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: JR Lomas <lomas.jr@gmail.com>
Date: Sun, 23 Aug 2026 23:48:10 -0700
Subject: [PATCH] msgblock: Clarify wire message encoding

The VLQ encoder used single-letter labels and put several control
decisions on the same line.  Message framing was also open-coded by its
caller.  Read-only wire buffers were exposed as mutable pointers.  These
details made the protocol code unnecessarily difficult to audit.

Give each shared VLQ suffix a descriptive name and document the sign and
value bit layout while retaining the common one-byte fast path.  Add a
single frame finalizer and document the block layout and parser return
values.  Const-qualify input buffers and validate encoder inputs before
reading the supplied value array.

The resulting encoder preserves the existing byte representation for all
32-bit values and keeps the decoder's bounded five-byte implementation.

Signed-off-by: JR Lomas <lomas.jr@gmail.com>

diff --git a/klippy/chelper/msgblock.c b/klippy/chelper/msgblock.c
index 8581843f..12226631 100644
--- a/klippy/chelper/msgblock.c
+++ b/klippy/chelper/msgblock.c
@@ -6,7 +6,8 @@
 
 #include <stddef.h> // offsetof
 #include <stdlib.h> // malloc
-#include <string.h> // memset
+#include <string.h> // memchr, memset
+#include "compiler.h" // likely
 #include "msgblock.h" // message_alloc
 #include "pyhelper.h" // errorf
 
@@ -17,7 +18,7 @@
 
 // Implement the standard crc "ccitt" algorithm on the given buffer
 uint16_t
-msgblock_crc16_ccitt(uint8_t *buf, uint8_t len)
+msgblock_crc16_ccitt(const uint8_t *buf, uint8_t len)
 {
     uint16_t crc = 0xffff;
     while (len--) {
@@ -30,36 +31,50 @@ msgblock_crc16_ccitt(uint8_t *buf, uint8_t len)
     return crc;
 }
 
-// Verify a buffer starts with a valid mcu message
+// Add framing bytes to an encoded message
+void
+msgblock_finalize(uint8_t *buf, uint8_t msg_len, uint8_t sequence)
+{
+    buf[MESSAGE_POS_LEN] = msg_len;
+    buf[MESSAGE_POS_SEQ] = sequence;
+    uint16_t crc = msgblock_crc16_ccitt(
+        buf, msg_len - MESSAGE_TRAILER_SIZE);
+    buf[msg_len - MESSAGE_TRAILER_CRC] = crc >> 8;
+    buf[msg_len - MESSAGE_TRAILER_CRC + 1] = crc;
+    buf[msg_len - MESSAGE_TRAILER_SYNC] = MESSAGE_SYNC;
+}
+
+// Verify a buffer starts with a valid MCU message.  Return the message
+// length, zero when more data is needed, or a negative discard length.
 int
-msgblock_check(uint8_t *need_sync, uint8_t *buf, int buf_len)
+msgblock_check(uint8_t *need_sync, const uint8_t *buf, int buf_len)
 {
     if (buf_len < MESSAGE_MIN)
         // Need more data
         return 0;
     if (*need_sync)
-        goto error;
+        goto resync;
     uint8_t msglen = buf[MESSAGE_POS_LEN];
     if (msglen < MESSAGE_MIN || msglen > MESSAGE_MAX)
-        goto error;
+        goto resync;
     uint8_t msgseq = buf[MESSAGE_POS_SEQ];
     if ((msgseq & ~MESSAGE_SEQ_MASK) != MESSAGE_DEST)
-        goto error;
+        goto resync;
     if (buf_len < msglen)
         // Need more data
         return 0;
-    if (buf[msglen-MESSAGE_TRAILER_SYNC] != MESSAGE_SYNC)
-        goto error;
-    uint16_t msgcrc = ((buf[msglen-MESSAGE_TRAILER_CRC] << 8)
-                       | (uint8_t)buf[msglen-MESSAGE_TRAILER_CRC+1]);
+    if (buf[msglen - MESSAGE_TRAILER_SYNC] != MESSAGE_SYNC)
+        goto resync;
+    uint16_t msgcrc = ((buf[msglen - MESSAGE_TRAILER_CRC] << 8)
+                       | buf[msglen - MESSAGE_TRAILER_CRC + 1]);
     uint16_t crc = msgblock_crc16_ccitt(buf, msglen-MESSAGE_TRAILER_SIZE);
-    if (crc != msgcrc)
-        goto error;
+    if (msgcrc != crc)
+        goto resync;
     return msglen;
 
-error: ;
-    // Discard bytes until next SYNC found
-    uint8_t *next_sync = memchr(buf, MESSAGE_SYNC, buf_len);
+resync:
+    // Discard through the next sync byte before testing another frame
+    const uint8_t *next_sync = memchr(buf, MESSAGE_SYNC, buf_len);
     if (next_sync) {
         *need_sync = 0;
         return -(next_sync - buf + 1);
@@ -70,26 +85,36 @@ error: ;
 
 // Encode an integer as a variable length quantity (vlq)
 static uint8_t *
-encode_int(uint8_t *p, uint32_t v)
+vlq_encode(uint8_t *p, uint32_t v)
 {
+    // The first group has six value bits and a sign bit; each additional
+    // group contributes seven value bits.
     int32_t sv = v;
-    if (sv < (3L<<5)  && sv >= -(1L<<5))  goto f4;
-    if (sv < (3L<<12) && sv >= -(1L<<12)) goto f3;
-    if (sv < (3L<<19) && sv >= -(1L<<19)) goto f2;
-    if (sv < (3L<<26) && sv >= -(1L<<26)) goto f1;
-    *p++ = (v>>28) | 0x80;
-f1: *p++ = ((v>>21) & 0x7f) | 0x80;
-f2: *p++ = ((v>>14) & 0x7f) | 0x80;
-f3: *p++ = ((v>>7) & 0x7f) | 0x80;
-f4: *p++ = v & 0x7f;
+    if (likely(sv >= -(1L << 5) && sv < (3L << 5)))
+        goto one_byte;
+    if (sv >= -(1L << 12) && sv < (3L << 12))
+        goto two_bytes;
+    if (sv >= -(1L << 19) && sv < (3L << 19))
+        goto three_bytes;
+    if (sv >= -(1L << 26) && sv < (3L << 26))
+        goto four_bytes;
+    *p++ = (v >> 28) | 0x80;
+four_bytes:
+    *p++ = ((v >> 21) & 0x7f) | 0x80;
+three_bytes:
+    *p++ = ((v >> 14) & 0x7f) | 0x80;
+two_bytes:
+    *p++ = ((v >> 7) & 0x7f) | 0x80;
+one_byte:
+    *p++ = v & 0x7f;
     return p;
 }
 
-// Parse a bounded integer encoded as a "variable length quantity"
+// Parse a bounded variable length quantity (vlq)
 static int
-parse_int(uint8_t **pp, uint8_t *end, uint32_t *value)
+vlq_decode(const uint8_t **pp, const uint8_t *end, uint32_t *value)
 {
-    uint8_t *p = *pp;
+    const uint8_t *p = *pp;
     if (p >= end)
         return -1;
     uint8_t c = *p++;
@@ -101,7 +126,7 @@ parse_int(uint8_t **pp, uint8_t *end, uint32_t *value)
         if (p >= end || count >= 5)
             return -1;
         c = *p++;
-        v = (v<<7) | (c & 0x7f);
+        v = (v << 7) | (c & 0x7f);
         count++;
     }
     *pp = p;
@@ -111,15 +136,16 @@ parse_int(uint8_t **pp, uint8_t *end, uint32_t *value)
 
 // Parse the VLQ contents of a message
 int
-msgblock_decode(uint32_t *data, int data_len, uint8_t *msg, int msg_len)
+msgblock_decode(uint32_t *data, int data_len
+                , const uint8_t *msg, int msg_len)
 {
     if (data_len < 0 || (!data && data_len) || !msg
         || msg_len < MESSAGE_MIN || msg_len > MESSAGE_MAX)
         return -1;
-    uint8_t *p = &msg[MESSAGE_HEADER_SIZE];
-    uint8_t *end = &msg[msg_len - MESSAGE_TRAILER_SIZE];
+    const uint8_t *p = &msg[MESSAGE_HEADER_SIZE];
+    const uint8_t *end = &msg[msg_len - MESSAGE_TRAILER_SIZE];
     while (data_len--) {
-        if (parse_int(&p, end, data++))
+        if (vlq_decode(&p, end, data++))
             return -1;
     }
     if (p != end)
@@ -144,27 +170,30 @@ message_alloc(void)
 
 // Allocate a queue_message and fill it with the specified data
 struct queue_message *
-message_fill(uint8_t *data, int len)
+message_fill(const uint8_t *data, int len)
 {
     if (len < 0 || len > MESSAGE_MAX || (!data && len)) {
         errorf("Invalid message length: %d", len);
         return NULL;
     }
     struct queue_message *qm = message_alloc();
-    memcpy(qm->msg, data, len);
+    if (len)
+        memcpy(qm->msg, data, len);
     qm->len = len;
     return qm;
 }
 
 // Allocate a queue_message and fill it with a series of encoded vlq integers
 struct queue_message *
-message_alloc_and_encode(uint32_t *data, int len)
+message_alloc_and_encode(const uint32_t *data, int len)
 {
     struct queue_message *qm = message_alloc();
+    if ((unsigned int)len > MESSAGE_PAYLOAD_MAX || (!data && len))
+        goto fail;
     int i;
     uint8_t *p = qm->msg;
     for (i=0; i<len; i++) {
-        p = encode_int(p, data[i]);
+        p = vlq_encode(p, data[i]);
         if (p > &qm->msg[MESSAGE_PAYLOAD_MAX])
             goto fail;
     }
diff --git a/klippy/chelper/msgblock.h b/klippy/chelper/msgblock.h
index f5a36d99..1dc3772f 100644
--- a/klippy/chelper/msgblock.h
+++ b/klippy/chelper/msgblock.h
@@ -4,6 +4,10 @@
 #include <stdint.h> // uint8_t
 #include "list.h" // struct list_node
 
+// On-wire message block:
+//   <length> <sequence> <encoded payload> <crc high> <crc low> <sync>
+// The length covers the entire block.  The low sequence bits are the rolling
+// message number and the remaining sequence bits are reserved.
 #define MESSAGE_MIN 5
 #define MESSAGE_MAX 64
 #define MESSAGE_HEADER_SIZE  2
@@ -39,12 +43,14 @@ struct clock_estimate {
     double conv_time, est_freq;
 };
 
-uint16_t msgblock_crc16_ccitt(uint8_t *buf, uint8_t len);
-int msgblock_check(uint8_t *need_sync, uint8_t *buf, int buf_len);
-int msgblock_decode(uint32_t *data, int data_len, uint8_t *msg, int msg_len);
+uint16_t msgblock_crc16_ccitt(const uint8_t *buf, uint8_t len);
+void msgblock_finalize(uint8_t *buf, uint8_t msg_len, uint8_t sequence);
+int msgblock_check(uint8_t *need_sync, const uint8_t *buf, int buf_len);
+int msgblock_decode(uint32_t *data, int data_len
+                    , const uint8_t *msg, int msg_len);
 struct queue_message *message_alloc(void);
-struct queue_message *message_fill(uint8_t *data, int len);
-struct queue_message *message_alloc_and_encode(uint32_t *data, int len);
+struct queue_message *message_fill(const uint8_t *data, int len);
+struct queue_message *message_alloc_and_encode(const uint32_t *data, int len);
 void message_free(struct queue_message *qm);
 void message_queue_free(struct list_head *root);
 uint64_t clock_from_clock32(uint64_t last_clock, uint32_t clock32);
