@@ -303,6 +322,7 @@ CAN_IRQHandler(void)
          * shorten the protocol's recovery safety interval.
          */
         CANx->IR.reg = CAN_IR_BO;
+        CAN_Errors.bus_off++;
         CANx->CCCR.reg &= ~CAN_CCCR_INIT;
     }
     if (ir & (CAN_IR_PED | CAN_IR_PEA)) {
@@ -457,7 +477,7 @@ can_init(void)
     /*##-3- Configure Interrupts #################################*/
     armcm_enable_irq(CAN_IRQHandler, CANx_IRQn, 1);
     CANx->ILE.reg = CAN_ILE_EINT0;
-    CANx->IE.reg = (CAN_IE_RF0NE | CAN_IE_BOE
+    CANx->IE.reg = (CAN_IE_RF0NE | CAN_IE_RF0LE | CAN_IE_BOE
                     | CAN_IE_PEDE | CAN_IE_PEAE);
 }
 DECL_INIT(can_init);
diff --git a/src/generic/canbus.c b/src/generic/canbus.c
index 9df1334a..52859641 100644
--- a/src/generic/canbus.c
+++ b/src/generic/canbus.c
@@ -4,6 +4,7 @@
 //
 // This file may be distributed under the terms of the GNU GPLv3 license.
 
+#include <string.h> // memset
 #include "autoconf.h" // CONFIG_CANBUS_FREQUENCY
 #include "canbus.h" // canhw_send
 #include "canserial.h" // canserial_notify_tx
@@ -35,3 +36,13 @@ canbus_process_data(struct canbus_msg *msg)
     canbus_normalize_msg(msg);
     canserial_process_data(msg);
 }
+
+void
+canbus_get_diagnostics(struct canbus_diagnostics *diag)
+{
+    struct canbus_status status;
+    memset(&status, 0, sizeof(status));
+    canhw_get_status(&status);
