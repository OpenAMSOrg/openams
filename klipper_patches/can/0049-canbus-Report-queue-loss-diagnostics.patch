diff --git a/src/generic/canserial.c b/src/generic/canserial.c
index 104cb0ae..ed72ccc4 100644
--- a/src/generic/canserial.c
+++ b/src/generic/canserial.c
@@ -61,6 +61,7 @@ static struct canbus_data {
     uint8_t receive_pos, invalid_bitrate;
     // Single-producer IRQ ring; publish indexes only after slot data is stable
     uint32_t admin_pull_pos, admin_push_pos;
+    uint32_t receive_overflows, admin_overflows;
 
     // Transfer buffers
     struct canbus_msg admin_queue[8];
@@ -344,8 +345,10 @@ canserial_process_data(struct canbus_msg *msg)
         // Add to incoming data buffer
         int rpos = CanData.receive_pos;
         uint32_t len = CANMSG_DATA_LEN(msg);
-        if (len > sizeof(CanData.receive_buf) - rpos)
+        if (len > sizeof(CanData.receive_buf) - rpos) {
+            CanData.receive_overflows++;
             return;
+        }
         memcpy(&CanData.receive_buf[rpos], msg->data, len);
         CanData.receive_pos = rpos + len;
         canserial_notify_rx();
@@ -388,9 +391,11 @@ canserial_process_data(struct canbus_msg *msg)
          * eight-entry queue.
          */
         uint32_t pullp = readl(&CanData.admin_pull_pos);
-        if (pushp - pullp >= ARRAY_SIZE(CanData.admin_queue))
-            // No space - drop message
+        if (pushp - pullp >= ARRAY_SIZE(CanData.admin_queue)) {
+            // No space - drop message and retain evidence for diagnostics
+            CanData.admin_overflows++;
             return;
+        }
         uint32_t pos = pushp % ARRAY_SIZE(CanData.admin_queue);
         memcpy(&CanData.admin_queue[pos], msg, sizeof(*msg));
         if (is_query)
@@ -521,6 +526,30 @@ command_get_canbus_status(uint32_t *args)
 DECL_COMMAND_FLAGS(command_get_canbus_status, HF_IN_SHUTDOWN
                    , "get_canbus_status");
 
+void
+command_get_canbus_diagnostics(uint32_t *args)
+{
+    struct canbus_diagnostics diag;
+    memset(&diag, 0, sizeof(diag));
+    canbus_get_diagnostics(&diag);
+    /*
+     * Hardware, the CAN-to-USB bridge, and canserial each own different queue
+     * boundaries.  Aggregate their monotonically wrapping counters only when
+     * queried, keeping every receive fast path to one local increment while
+     * giving the host a single stable view of frames which could not advance.
+     * This is a separate optional command rather than extending canbus_status:
+     * older hosts continue matching that established response format exactly.
+     */
+    diag.rx_overflows += (readl(&CanData.receive_overflows)
+                          + readl(&CanData.admin_overflows));
+    sendf("canbus_diagnostics rx_overflows=%u tx_discards=%u"
+          " usb_invalid=%u bus_off=%u"
+          , diag.rx_overflows, diag.tx_discards
+          , diag.usb_invalid, diag.bus_off);
+}
+DECL_COMMAND_FLAGS(command_get_canbus_diagnostics, HF_IN_SHUTDOWN
+                   , "get_canbus_diagnostics");
+
 void
 command_get_canbus_id(uint32_t *args)
 {
diff --git a/src/generic/usb_canbus.c b/src/generic/usb_canbus.c
index 015c0c66..ab1f59ce 100644
--- a/src/generic/usb_canbus.c
+++ b/src/generic/usb_canbus.c
@@ -130,6 +130,7 @@ static struct usbcan_data {
     // State tracking for messages to be sent from host to canbus
     struct timer bus_send_timer;
     uint8_t bus_send_state, bus_send_timed_out;
+    uint32_t tx_discards, usb_invalid;
 
     // Canbus data from host
     uint8_t host_status;
@@ -139,6 +140,7 @@ static struct usbcan_data {
     // Data from physical canbus interface
     // Single-producer IRQ ring; indexes publish ownership across contexts
     uint32_t canhw_pull_pos, canhw_push_pos;
+    uint32_t canhw_overflows;
     struct canbus_msg canhw_queue[32];
 } UsbCan = {
     .bus_send_timer.func = usbcan_stall_event,
@@ -236,8 +238,10 @@ drain_usb_host_messages(void)
          * then be overwritten by the next complete transfer without making
          * partial state visible to the routing task.
          */
-        if (ret != sizeof(*gs) || gs->can_dlc > sizeof(gs->data))
+        if (ret != sizeof(*gs) || gs->can_dlc > sizeof(gs->data)) {
+            UsbCan.usb_invalid++;
             continue;
+        }
         /*
          * device_config.icount advertises one CAN channel, so channel zero is
          * the only value the gs_usb protocol permits for this interface.  The
@@ -248,8 +252,10 @@ drain_usb_host_messages(void)
          * apparently fatal device response or be transmitted on the physical
          * bus under a channel selector the firmware silently ignored.
          */
-        if (gs->channel)
+        if (gs->channel) {
+            UsbCan.usb_invalid++;
             continue;
+        }
         /*
          * bt_const.feature is zero and this endpoint implements only the
          * fixed-size classic CAN frame.  Consequently no gs_usb frame flag is
@@ -261,8 +267,10 @@ drain_usb_host_messages(void)
          * before echoing it so the format advertised during probe remains the
          * format used for every bulk transfer.
          */
-        if (gs->flags)
+        if (gs->flags) {
+            UsbCan.usb_invalid++;
             continue;
+        }
         /*
          * The routing code compares the complete can_id, but each hardware
          * backend masks that value down to either 11 or 29 identifier bits
@@ -274,8 +282,10 @@ drain_usb_host_messages(void)
          * removed.  Reject those ambiguous encodings so local routing, the
          * USB echo, and the physical bus all refer to the same CAN frame.
          */
-        if (!gs_can_id_is_valid(gs->can_id))
+        if (!gs_can_id_is_valid(gs->can_id)) {
+            UsbCan.usb_invalid++;
             continue;
+        }
         /*
          * GS_HOST_FRAME_ECHO_ID_RX distinguishes a device-originated receive
          * frame from the echo which completes a host transmit request.  If the
@@ -285,8 +295,10 @@ drain_usb_host_messages(void)
          * enough missing completions stop the SocketCAN transmit queue.  Only
          * the device-to-host path may create the receive marker.
          */
-        if (gs->echo_id == GS_HOST_FRAME_ECHO_ID_RX)
+        if (gs->echo_id == GS_HOST_FRAME_ECHO_ID_RX) {
+            UsbCan.usb_invalid++;
             continue;
+        }
         UsbCan.host_push_pos = push_pos = push_pos + 1;
     }
 }
@@ -345,9 +357,11 @@ try_canmsg_send(struct canbus_msg *msg)
         note_discard_state(1);
         UsbCan.bus_send_state = BSS_DISCARDING;
     }
-    if (UsbCan.bus_send_state == BSS_DISCARDING)
+    if (UsbCan.bus_send_state == BSS_DISCARDING) {
         // Queue is stalled - just discard the message
+        UsbCan.tx_discards++;
         return 0;
+    }
     if (UsbCan.bus_send_state == BSS_READY) {
         /*
          * A stored deadline alone can not guarantee progress: the routing task
@@ -471,9 +485,11 @@ canbus_process_data(struct canbus_msg *msg)
     // Add to admin command queue
     uint32_t pushp = UsbCan.canhw_push_pos;
     uint32_t pullp = readl(&UsbCan.canhw_pull_pos);
-    if (pushp - pullp >= ARRAY_SIZE(UsbCan.canhw_queue))
+    if (pushp - pullp >= ARRAY_SIZE(UsbCan.canhw_queue)) {
         // No space - drop message
+        UsbCan.canhw_overflows++;
         return;
+    }
     if (UsbCan.assigned_id && (msg->id & ~1) == UsbCan.assigned_id)
         // Id reserved for local
         return;
@@ -519,6 +535,24 @@ canbus_set_filter(uint32_t id)
     UsbCan.assigned_id = id;
 }
 
+void
+canbus_get_diagnostics(struct canbus_diagnostics *diag)
+{
+    struct canbus_status status;
+    memset(&status, 0, sizeof(status));
+    canhw_get_status(&status);
+    /*
+     * canhw_overflows is interrupt-owned; acquire it explicitly before adding
+     * the task-owned bridge counters.  All counters intentionally wrap at 32
+     * bits like existing CAN error statistics, allowing the host to extend them
+     * without adding synchronization or wide arithmetic to MCU hot paths.
+     */
+    diag->rx_overflows = status.rx_overflows + readl(&UsbCan.canhw_overflows);
+    diag->tx_discards = UsbCan.tx_discards;
+    diag->usb_invalid = UsbCan.usb_invalid;
+    diag->bus_off = status.bus_off;
+}
+
 
 /****************************************************************
  * USB bulk wakeup interface
diff --git a/src/lpc176x/can.c b/src/lpc176x/can.c
index 6920473d..737f674f 100644
--- a/src/lpc176x/can.c
+++ b/src/lpc176x/can.c
@@ -98,7 +98,8 @@
 #define CAN_ERROR_WARNING_LIMIT 96
 
 static struct {
-    uint32_t rx_error, tx_error;
+    uint32_t rx_error, tx_error, rx_overflows, bus_off;
+    uint8_t bus_off_active;
 } CAN_Errors;
 
 static uint32_t
@@ -210,13 +211,32 @@ canhw_get_status(struct canbus_status *status)
 {
     irqstatus_t flag = irq_save();
     uint32_t gsr = LPC_CANx->GSR;
+    /*
+     * The interrupt handler normally observes bus-off while releasing Reset
+     * Mode.  Sample the level here as well so a status query can not miss the
+     * transition if it races the shared interrupt.  Keep a latch because GSR
+     * reports a state, whereas diagnostics promise a count of distinct
+     * episodes; recovery clearing BS rearms the next transition.
+     */
+    if (gsr & CAN_GSR_BS) {
+        if (!CAN_Errors.bus_off_active) {
+            CAN_Errors.bus_off_active = 1;
+            CAN_Errors.bus_off++;
+        }
+    } else {
+        CAN_Errors.bus_off_active = 0;
+    }
     uint32_t rx_error = CAN_Errors.rx_error, tx_error = CAN_Errors.tx_error;
+    uint32_t rx_overflows = CAN_Errors.rx_overflows;
+    uint32_t bus_off = CAN_Errors.bus_off;
     irq_restore(flag);
 
     uint32_t rx_count = (gsr >> CAN_GSR_RXERR_Pos) & 0xff;
     uint32_t tx_count = (gsr >> CAN_GSR_TXERR_Pos) & 0xff;
     status->rx_error = rx_error;
     status->tx_error = tx_error;
+    status->rx_overflows = rx_overflows;
+    status->bus_off = bus_off;
     if (gsr & CAN_GSR_BS)
         status->bus_state = CANBUS_STATE_OFF;
     else if (rx_count >= CAN_ERROR_PASSIVE_LIMIT
@@ -259,6 +279,13 @@ CAN_IRQHandler(void)
 
     if (icr & CAN_ICR_DOI) {
         CAN_Errors.rx_error += 1;
+        /*
+         * DOI identifies a local receive-buffer overrun, not another malformed
