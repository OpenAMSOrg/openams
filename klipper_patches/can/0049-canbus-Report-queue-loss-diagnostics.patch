From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: JR Lomas <lomas.jr@gmail.com>
Date: Mon, 24 Aug 2026 14:06:47 -0700
Subject: [PATCH] canbus: Report queue loss diagnostics

The existing CAN status reports protocol receive and transmit errors, but it can remain clean when a valid frame is lost after reception.  Hardware FIFO overwrite, canserial buffer exhaustion, bridge queue overflow, and the USB-CAN stall policy all discard work at local resource boundaries which the CAN error counters can not observe.  Operators therefore had no durable evidence to distinguish firmware overload from a wiring or termination fault.

Record wrapping counters at each loss boundary and count distinct bus-off episodes.  Enable the bxCAN and M_CAN receive-overflow interrupt sources, retain LPC data-overrun events, and aggregate hardware loss with canserial and USB bridge queues only when queried.  Also count malformed gs_usb records and frames deliberately discarded after the physical transmit path remains blocked.  Keep the interrupt paths to a local 32-bit increment; an asserted hardware loss flag may cover multiple frames, so the reported overflow total is intentionally a lower bound instead of claiming false precision.

Expose these values through a separate optional get_canbus_diagnostics command.  Extending the established canbus_status response would change the host/MCU message dictionary contract and prevent mixed-version operation.  A new host probes for the additional command and leaves diagnostic fields unavailable with old firmware, while an old host never issues it to new firmware.

Query exceptional diagnostics once per five status cycles instead of doubling healthy-network management traffic every second.  Extend the MCU counters across 32-bit wrap on the host and append them to canbus_stats output only when supported.  Existing CAN identifiers, gs_usb records, status response fields, and client configuration remain unchanged.

Signed-off-by: JR Lomas <lomas.jr@gmail.com>

diff --git a/klippy/extras/canbus_stats.py b/klippy/extras/canbus_stats.py
index 872db2a0..1dff2c73 100644
--- a/klippy/extras/canbus_stats.py
+++ b/klippy/extras/canbus_stats.py
@@ -12,8 +12,12 @@ class PrinterCANBusStats:
         self.name = config.get_name().split()[-1]
         self.mcu = None
         self.get_canbus_status_cmd = None
+        self.get_canbus_diagnostics_cmd = None
         self.status = {'rx_error': None, 'tx_error': None, 'tx_retries': None,
-                       'bus_state': None}
+                       'bus_state': None, 'rx_overflows': None,
+                       'tx_discards': None, 'usb_invalid': None,
+                       'bus_off': None}
+        self.diagnostics_countdown = 0
         # Every canbus_stats object is registered during the same connection
         # phase.  If each first callback returns monotonic()+1, all later status
         # commands remain phase-locked and create a periodic request/response
@@ -49,6 +53,18 @@ class PrinterCANBusStats:
             "get_canbus_status",
             "canbus_status rx_error=%u tx_error=%u tx_retries=%u"
             " canbus_bus_state=%u")
+        # Do not add fields to the established canbus_status response.  Command
+        # and response formats are part of Klipper's host/MCU compatibility
+        # contract: changing that response would make an old host reject new
+        # firmware during message-dictionary validation.  A separately
+        # discoverable query permits every mixed-version combination instead.
+        # A new host simply omits diagnostics when connected to old firmware,
+        # while an old host never sends the additional command to new firmware.
+        if self.mcu.try_lookup_command("get_canbus_diagnostics") is not None:
+            self.get_canbus_diagnostics_cmd = self.mcu.lookup_query_command(
+                "get_canbus_diagnostics",
+                "canbus_diagnostics rx_overflows=%u tx_discards=%u"
+                " usb_invalid=%u bus_off=%u")
         # Register usb_canbus_state message handling (for usb to canbus bridge)
         if self.mcu.check_valid_response("usb_canbus_state discard=%u"):
             self.mcu.register_serial_response(self.handle_usb_canbus_state,
@@ -75,8 +91,32 @@ class PrinterCANBusStats:
         retries = prev_retries + ((params['tx_retries'] - prev_retries)
                                   & 0xffffffff)
         state = params['canbus_bus_state']
-        self.status = {'rx_error': rx, 'tx_error': tx, 'tx_retries': retries,
-                       'bus_state': state}
+        status = self.status.copy()
+        status.update({'rx_error': rx, 'tx_error': tx,
+                       'tx_retries': retries, 'bus_state': state})
+
+        # Queue loss and bus-off episodes are exceptional evidence, not values
+        # needed for one-second control or display decisions.  Querying them at
+        # the legacy status cadence would permanently double management traffic
+        # on every healthy CAN network to observe counters which normally stay
+        # at zero.  Reuse this already phase-staggered callback every five
+        # cycles instead.  The first query remains immediate so a pre-existing
+        # fault is visible promptly, and 32-bit extension below retains events
+        # across arbitrary counter wrap without requiring expensive 64-bit
+        # arithmetic in an MCU interrupt path.
+        if self.get_canbus_diagnostics_cmd is not None:
+            self.diagnostics_countdown -= 1
+            if self.diagnostics_countdown <= 0:
+                diag = self.get_canbus_diagnostics_cmd.send()
+                self.diagnostics_countdown = 5
+                for key in ('rx_overflows', 'tx_discards', 'usb_invalid',
+                            'bus_off'):
+                    previous = status[key]
+                    if previous is None:
+                        previous = 0
+                    status[key] = previous + ((diag[key] - previous)
+                                               & 0xffffffff)
+        self.status = status
         waketime = self.reactor.monotonic() + 1.
         if self.query_phase is not None:
             waketime += self.query_phase
@@ -86,10 +126,16 @@ class PrinterCANBusStats:
         status = self.status
         if status['rx_error'] is None:
             return (False, '')
-        return (False, 'canstat_%s: bus_state=%s rx_error=%d'
-                ' tx_error=%d tx_retries=%d'
-                % (self.name, status['bus_state'], status['rx_error'],
-                   status['tx_error'], status['tx_retries']))
+        msg = ('canstat_%s: bus_state=%s rx_error=%d'
+               ' tx_error=%d tx_retries=%d'
+               % (self.name, status['bus_state'], status['rx_error'],
+                  status['tx_error'], status['tx_retries']))
+        if status['rx_overflows'] is not None:
+            msg += (' rx_overflows=%d tx_discards=%d usb_invalid=%d'
+                    ' bus_off=%d'
+                    % (status['rx_overflows'], status['tx_discards'],
+                       status['usb_invalid'], status['bus_off']))
+        return (False, msg)
     def get_status(self, eventtime):
         return self.status
 
diff --git a/src/atsam/fdcan.c b/src/atsam/fdcan.c
index fbd4770a..d5370dd4 100644
--- a/src/atsam/fdcan.c
+++ b/src/atsam/fdcan.c
@@ -186,7 +186,7 @@ canhw_set_filter(uint32_t id)
 }
 
 static struct {
-    uint32_t rx_error, tx_error;
+    uint32_t rx_error, tx_error, rx_overflows, bus_off;
 } CAN_Errors;
 
 // Report interface status
@@ -203,10 +203,14 @@ canhw_get_status(struct canbus_status *status)
             CAN_Errors.rx_error += 1;
     }
     uint32_t rx_error = CAN_Errors.rx_error, tx_error = CAN_Errors.tx_error;
+    uint32_t rx_overflows = CAN_Errors.rx_overflows;
+    uint32_t bus_off = CAN_Errors.bus_off;
     irq_restore(flag);
 
     status->rx_error = rx_error;
     status->tx_error = tx_error;
+    status->rx_overflows = rx_overflows;
+    status->bus_off = bus_off;
     if (psr & MCAN_PSR_BO)
         status->bus_state = CANBUS_STATE_OFF;
     else if (psr & MCAN_PSR_EP)
@@ -260,6 +264,21 @@ CAN_IRQHandler(void)
             canbus_process_data(&msg);
         }
     }
+    if (ir & MCAN_IR_RF0L) {
+        /*
+         * RF0L is the only conclusive evidence that the controller discarded
+         * a complete, otherwise valid frame because software did not return a
+         * FIFO slot in time.  LEC and the receive error counter describe CAN
+         * protocol faults on the wire; they do not change for this local
+         * resource loss.  Preserve a separate monotonically wrapping count so
+         * a host can distinguish signal-integrity trouble from IRQ latency or
+         * an undersized receive path.  One interrupt flag represents at least
+         * one lost frame, so the count is deliberately a lower bound when a
+         * sustained burst overwrites more than one element before service.
+         */
+        CANx->MCAN_IR = MCAN_IR_RF0L;
+        CAN_Errors.rx_overflows++;
+    }
     if (ir & FDCAN_IE_TC) {
         /*
          * IR records completions even while their interrupt sources are
@@ -287,6 +306,7 @@ CAN_IRQHandler(void)
          * shorten the protocol's recovery safety interval.
          */
         CANx->MCAN_IR = MCAN_IR_BO;
+        CAN_Errors.bus_off++;
         CANx->MCAN_CCCR &= ~MCAN_CCCR_INIT;
     }
     if (ir & (MCAN_IR_PED | MCAN_IR_PEA)) {
@@ -449,7 +469,7 @@ can_init(void)
     /*##-3- Configure Interrupts #################################*/
     armcm_enable_irq(CAN_IRQHandler, CANx_IRQn, 1);
     CANx->MCAN_ILE = MCAN_ILE_EINT0;
-    CANx->MCAN_IE = (MCAN_IE_RF0NE | MCAN_IE_BOE
+    CANx->MCAN_IE = (MCAN_IE_RF0NE | MCAN_IE_RF0LE | MCAN_IE_BOE
                      | MCAN_IE_PEDE | MCAN_IE_PEAE);
 }
 DECL_INIT(can_init);
diff --git a/src/atsamd/fdcan.c b/src/atsamd/fdcan.c
index 2abf2b40..0079d51e 100644
--- a/src/atsamd/fdcan.c
