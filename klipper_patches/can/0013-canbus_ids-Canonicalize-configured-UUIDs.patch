From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: JR Lomas <lomas.jr@gmail.com>
Date: Mon, 24 Aug 2026 11:58:58 -0700
Subject: [PATCH] canbus_ids: Canonicalize configured UUIDs

The node allocator keyed devices by their original configuration text, while the connection path later converted that text to a 48-bit number.  Equivalent spellings such as leading-zero or case variants could therefore register the same physical UUID more than once and repeatedly reassign one MCU between different node ids.

Parse and range-check each UUID when it is registered, then use the numeric value for duplicate detection and lookup.  Invalid identifiers now fail during configuration and every textual representation of the same on-wire UUID shares one allocator identity.

Signed-off-by: JR Lomas <lomas.jr@gmail.com>

diff --git a/klippy/extras/canbus_ids.py b/klippy/extras/canbus_ids.py
index f96510fa..0014963b 100644
--- a/klippy/extras/canbus_ids.py
+++ b/klippy/extras/canbus_ids.py
@@ -11,16 +11,31 @@ class PrinterCANBus:
         self.printer = config.get_printer()
         self.ids = {}
     def add_uuid(self, config, canbus_uuid, canbus_iface):
-        if canbus_uuid in self.ids:
+        # The administration protocol carries a UUID as exactly six bytes;
+        # configuration text is only a human-readable spelling of that number.
+        # Using the original string as the allocator key would treat case and
+        # leading-zero variants as different devices, even though connect_canbus
+        # later encodes them into identical bytes.  That can assign two node ids
+        # to one MCU and make each connection attempt displace the other.  Parse
+        # and range-check at registration time so duplicate detection operates
+        # on the identity that is actually placed on the wire.
+        try:
+            uuid = int(canbus_uuid, 16)
+        except ValueError:
+            uuid = -1
+        if uuid < 0 or uuid > 0xffffffffffff:
+            raise config.error("Invalid canbus_uuid")
+        if uuid in self.ids:
             raise config.error("Duplicate canbus_uuid")
         new_id = len(self.ids) + NODEID_FIRST
-        self.ids[canbus_uuid] = new_id
+        self.ids[uuid] = new_id
         return new_id
     def get_nodeid(self, canbus_uuid):
-        if canbus_uuid not in self.ids:
+        uuid = int(canbus_uuid, 16)
+        if uuid not in self.ids:
             raise self.printer.config_error("Unknown canbus_uuid %s"
                                             % (canbus_uuid,))
-        return self.ids[canbus_uuid]
+        return self.ids[uuid]
 
 def load_config(config):
     return PrinterCANBus(config)
