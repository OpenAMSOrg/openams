     uint32_t txfqs = CANx->TXFQS.reg;
-    if (txfqs & CAN_TXFQS_TFQF)
-        // No space in transmit fifo - wait for irq
-        return -1;
+    if (txfqs & CAN_TXFQS_TFQF) {
+        /*
+         * A completion interrupt is useful only after software has found the
